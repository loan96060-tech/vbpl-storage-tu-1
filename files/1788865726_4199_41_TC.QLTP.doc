\f172\fs28\cgrid0\insrsid15283095\charrsid868980 T\u7841\'3fi quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 238-CT/H\'d0BT ng\'e0y 16/9/1983, Ch\u7911\'3f t\u7883\'3fch H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903\'3fng \'f0}{
\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'e3 cho ph\'e9p chu\u7875\'3fn giao t\u7915\'3f c\'e1c ng\'e0nh n\u7897\'3fi th}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd\'f5ng, l\'fd\'f5ng th\u7921\'3fc sang ng\'e0nh t\'e0i ch\'ednh nhi\u7879
\'3fm v\u7909\'3f t\u7893\'3f ch\u7913\'3fc in, ph\'e1t h\'e0nh v\'e0 ch\u7881\'3f \'f0\u7841\'3fo c\'e1c c\'f5 quan t\'e0i ch\'ednh \'f0\u7883\'3fa ph\'fd\'f5ng c\u7845\'3fp ph\'e1t c\'e1c lo\u7841\'3fi tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng cho c
\'e1c \'f0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc h\'fd\u7903\'3fng ch\u7871\'3f \'f0\u7897\'3f cung c\u7845\'3fp quy \'f0\u7883\'3fnh trong quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 218/CP ng\'e0y 29/5/1981 c\u7911\'3fa H\u7897\'3fi \'f0
\u7891\'3fng Ch\'ednh ph\u7911\'3f v\'e0 trong m\u7897\'3ft s\u7889\'3f quy\u7871\'3ft \'f0\u7883\'3fnh b\u7893\'3f sung kh\'e1c nh\'fd quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 111/H\'d0BT ng\'e0y 13/10/1981 c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng B
\u7897\'3f tr\'fd\u7903\'3fng v.v...
\par Thi h\'e0nh quy\u7871\'3ft \'f0\u7883\'3fnh 238/CT n\'f3i tr\'ean, B\u7897\'3f T\'e0i ch\'ednh v\'e0 B\u7897\'3f N\u7897\'3fi th\'fd\'f5ng \'f0}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'e3 b\'e0n b\u7841\'3fc th\u7889\'3fng nh\u7845\'3ft v\u7873
\'3f nhi\u7879\'3fm v\u7909\'3f c\u7911\'3fa m\u7895\'3fi ng\'e0nh trong vi\u7879\'3fc c\u7845\'3fp ph\'e1t v\'e0 qu\u7843\'3fn l\'fd tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng nh}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd sau:
\par }{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 1/ Vi\u7879\'3fc in, ph\'e1t h\'e0nh, c\u7845\'3fp ph\'e1t v\'e0 qu\u7843\'3fn l\'fd c\'e1c lo\u7841\'3fi tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng c\'f3 }{
\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'f0\u7883\'3fnh l\'fd\u7907\'3fng ho\u7863\'3fc kh\'f4ng \'f0\u7883\'3fnh l\'fd\u7907\'3fng theo gi\'e1 cung c\u7845\'3fp m\'e0 ng\'e2n s\'e1ch c\'e1c c\u7845\'3fp ph\u7843\'3fi th\u7921\'3fc hi\u7879\'3f
n b\'f9 gi\'e1, th}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'ec do ng\'e0nh t\'e0i ch\'ed}{\f0\fs28\cgrid0\insrsid3754524 n}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 h \'f0\u7843\'3fm nhi\u7879\'3fm. \'d0\u7889\'3fi t\'fd\u7907\'3fng \'f0
\'fd\u7907\'3fc h\'fd\u7903\'3fng ch\u7871\'3f \'f0\u7897\'3f cung c\u7845\'3fp v\'e0 c\'e1c lo\u7841\'3fi tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng do ng\'e0nh t\'e0i ch\'ednh \'f0\u7843\'3fm nhi\u7879\'3fm \'f0}{
\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'e3 }{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'f0\'fd\u7907\'3fc n\'eau v\u7909\'3f th\u7875\'3f trong bi\'ean b\u7843\'3fn b\'e0n giao gi\u7919\'3fa B\u7897\'3f N\u7897\'3fi th\'fd\'f5ng v\'e0 B
\u7897\'3f T\'e0i ch\'ednh.
\par }{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 2/ Vi\u7879\'3fc in, ph\'e1t h\'e0nh, c\u7845\'3fp ph\'e1t v\'e0 qu\u7843\'3fn l\'fd c\'e1c lo\u7841\'3fi tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng theo gi\'e1 l\u7867\'3f ho\u7863\'3fc gi\'e1 }{
\f164\fs28\cgrid0\insrsid15283095\charrsid868980 \'f0\u7843\'3fm b\u7843\'3fo kinh doanh nh\u7857\'3fm \'f0\u7843\'3fm b\u7843\'3fo}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980  ph\'e2n ph\u7889\'3fi h\'e0ng ho\'e1 v\u7853\'3ft t\'fd \'f0\u7871\'3f
n tay ng\'fd\u7901\'3fi ti\'eau d\'f9ng v\'e0 \'f0\u7875\'3f t\'e3ng c\'fd\u7901\'3fng qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd v\u7853\'3ft t}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd h\'e0ng ho\'e1 trong n\u7897
\'3fi b\u7897\'3f ng\'e0nh n\u7897\'3fi th\'fd\'f5ng th}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'ec do ng\'e0nh n\u7897\'3fi th}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd\'f5ng \'f0\u7843\'3fm nhi\u7879\'3fm.
\par Tr\'ean c\'f5 s\u7903\'3f ph\'e2n \'f0\u7883\'3fnh nhi\u7879\'3fm v\u7909\'3f c\u7845\'3fp ph\'e1t, v\'e0 qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd c\'e1c lo\u7841\'3fi tem phi\u7871\'3fu, s\u7893\'3f mua h\'e0ng nh}{
