ng tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch t\u7893\'3f 1 Ph\'f3 ph\'f2ng tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch t\u7893\'3f 2.
\par 2. T\u7893\'3f qu\u7843\'3fn l\'fd tem phi\u7871\'3fu thu\u7897\'3fc ph\'f2ng t\'e0i ch\'ednh qu\u7853\'3fn, huy\u7879\'3fn, th\u7883\'3f x\'e3:
\par T\u7893\'3f qu\u7843\'3fn l\'fd tem phi\u7871\'3fu thu\u7897\'3fc ph\'f2ng t\'e0i ch\'ednh l\'e0 }{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'f0\'f5n v\u7883\'3f c\'f5 s\u7903\'3f trong h\u7879\'3f th\u7889\'3fng qu\u7843\'3fn l}{
\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd tem phi\u7871\'3fu c\u7911\'3fa ng\'e0nh t\'e0i ch\'ednh. Tem phi\u7871\'3fu, s\u7893\'3f mu}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 a h\'e0ng t\u7915\'3f t\u7893\'3f n\'e0y \'f0\'fd\u7907\'3f
c ph\'e2n ph\u7889\'3fi \'f0\u7871\'3fn tay c\'e1c \'f0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc h\'fd\u7903\'3fng ch\u7871\'3f \'f0\u7897\'3f cung c\u7845\'3fp, v\'e0 \'f0\u7891\'3fng th\u7901\'3fi vi\u7879\'3fc c\u7845\'3fp b\'f9 gi\'e1 tr\u7921
\'3fc ti\u7871\'3fp cho c\'e1c \'f0\u7889\'3fi t\'fd\u7907\'3fng n\'e0y c\u361\'3fng s\u7869\'3f ti\u7871\'3fn h\'e0nh t\u7841\'3fi t\u7893\'3f qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd tem phi\u7871\'3fu: Vi\u7879\'3fc th\u7921
\'3fc hi\u7879\'3fn c\u7845\'3fp ph\'e1t tem phi\u7871\'3fu h\'e0ng qu\'fd, th\u7853\'3fm ch\'ed h\'e0ng th\'e1ng, g\u7855\'3fn }{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 li\u7873\'3fn v\u7899\'3fi thanh to\'e1n ti\u7873\'3fn l\'fd\'f5ng ho\u7863
\'3fc c\u7845\'3fp ph\'e1t tr\u7907\'3f c\u7845\'3fp c\u361\'3fng di\u7877\'3fn ra \u7903\'3f t\u7893\'3f qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd tem phi\u7871\'3fu. Ngo\'e0i ra h\'e0ng ng\'e0y c\'f2n nh\u7919\'3fng vi\u7879
\'3fc thay }{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'f0\u7893\'3fi ti\'eau chu\u7849\'3fn, \'f0\u7893\'3fi tem phi\u7871\'3fu, di chuy\u7875\'3fn \'f0i \'f0\u7871\'3fn, v.v....c\u361\'3fng s\u7869\'3f di\u7877\'3fn ra \u7903\'3f \'f0\'e2y.

\par Tu\u7923\'3f theo kh\u7889\'3fi l\'fd\u7907\'3fng c\'f4ng vi\u7879\'3fc qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd, c\u7845\'3fp ph\'e1t tem phi\u7871\'3fu v\'e0 b\'f9 gi\'e1 tr\u7921\'3fc ti\u7871\'3fp b\u7857\'3fng ti\u7873\'3f
n t\u7841\'3fi qu\u7853\'3fn, huy\u7879\'3fn, th\u7883\'3f x\'e3 nhi\u7873\'3fu hay \'edt (c\u7909\'3f th\u7875\'3f l\'e0 s\u7889\'3f l}{\f172\fs28\cgrid0\insrsid15283095\charrsid868980 \'fd\u7907\'3fng \'f0\'f5n v\u7883\'3f, s\u7889\'3f l\'fd\u7907\'3f
ng \'f0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc h\'fd\u7903\'3fng ch\u7871\'3f \'f0\u7897\'3f c\'f9ng c\u7845\'3fp nhi\u7873\'3fu hay \'edt) m\'e0 b\u7889\'3f tr\'ed s\u7889\'3f l\'fd\u7907\'3fng c\'e1n b\u7897\'3f nh\'e2n vi\'ean \'f0\u7875\'3f 
\'f0\u7843\'3fm b\u7843\'3fo ho\'e0n th\'e0nh t\u7889\'3ft nhi\u7879\'3fm v\u7909\'3f c\'f4ng t\'e1c.
