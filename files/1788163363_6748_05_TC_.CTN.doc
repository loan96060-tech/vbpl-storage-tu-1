\par }\pard \qc \li0\ri0\keepn\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\outlinelevel2\adjustright\rin0\lin0\itap0\pararsid16079946 {
