\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid2173563 {
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 a.) Gi\'e1 t\'ednh thu\u7871\'3f h\'e0ng ho\'e1 do c\'f5 quan thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp c\u7845\'3fp t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu tr\u7921\'3fc thu
\u7897\'3fc trung \'fd\'f5ng, quy \'f0\u7883\'3fnh c\'e3n c\u7913\'3f v\'e0o c\'e1c nguy\'ean t\u7855\'3fc ghi trong \'f0i\u7873\'3fu 7 ngh\u7883\'3f \'f0\u7883\'3fnh c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903\'3fng s\u7889\'3f
  /H\'d0BT ng\'e0y 30 th\'e1ng 1 n\'e3m 1988. C\u7909\'3f th\u7875\'3f nh\'fd sau:
\par - \'d0\u7889\'3fi v\u7899\'3fi c\'e1c m\u7863\'3ft h\'e0ng do c\'f5 s\u7903\'3f kinh t\u7871\'3f t\u7853\'3fp th\u7875\'3f, c\'e1 th\u7875\'3f l\'e0m gia c\'f4ng cho kinh t\u7871\'3f qu\u7889\'3fc doanh hay c\'f5 quan Nh\'e0 n\'fd\u7899\'3fc, gi\'e1 t\'ed
nh thu\u7871\'3f l\'e0 gi\'e1 b\'e1n bu\'f4n c\'f4ng nghi\u7879\'3fp (gi\'e1 kinh doanh th\'fd\'f5ng nghi\u7879\'3fp tr\u7915\'3f (-) chi\u7871\'3ft kh\u7845\'3fu th\'fd\'f5ng nghi\u7879\'3fp theo t\u7915\'3fng nh\'f3m h\'e0ng). N\u7871\'3fu gia c\'f4
ng/th\'fd\'f5ng nghi\u7879\'3fp c\u7845\'3fp I th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec tr\u7915\'3f chi\u7871\'3ft kh\u7845\'3fu th}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd\'f5ng nghi\u7879\'3fp to\'e0n ng\'e0nh; n\u7871\'3f
u gia c\'f4ng cho th\'fd\'f5ng nghi\u7879\'3fp c\u7845\'3fp II ho\u7863\'3fc c\'e1c c\'f5 quan kh\'e1c th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec tr\u7915\'3f chi\u7871\'3ft kh\u7845\'3fu th}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 
\'fd\'f5ng}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633  nghi\u7879\'3fp c\u7845\'3fp II.
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 C\'f5 quan, \'f0\'f5n v\u7883\'3f \'f0\'fda h\'e0ng gia c\'f4ng ph\u7843\'3fi ghi v\'e0o trong h\u7907\'3fp \'f0\u7891\'3fng gia c\'f4ng gi\'e1 b\'e1n bu\'f4n c\'f4ng nghi\u7879\'3fp c\u7911\'3fa t\u7915
\'3fng m\u7863\'3ft h\'e0ng \'f0\'fda gia c\'f4ng ( bao g\u7891\'3fm c\u7843\'3f c\'f5 c\u7845\'3fu gi\'e1 v\'e0 gi\'e1 b\'e1n bu\'f4n c\'f4ng nghi\u7879\'3fp c\u7911\'3fa t\u7915\'3fng m\u7863\'3ft h\'e0ng).
\par - \'d0\u7889\'3fi v\u7899\'3fi c\'e1c m\u7863\'3ft h\'e0ng Nh\'e0 n\'fd\u7899\'3fc thu mua c\u7911\'3fa c\'e1c c\'f5 s\u7903\'3f kinh t\u7871\'3f t\u7853\'3fp th\u7875\'3f, c\'e1 th\u7875\'3f, gi\'e1 t\'ednh thu\u7871\'3f h\'e0ng ho\'e1 l\'e0 gi\'e1 Nh
\'e0 n\'fd\u7899\'3fc thu mua c\u7911\'3fa c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft ( t\u7913\'3fc l\'e0 gi\'e1 b\'e1n th\u7921\'3fc t\u7871\'3f c\u7911\'3fa c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft ).
\par - \'d0\u7889\'3fi v\u7899\'3fi c\'e1c m\u7863\'3ft h\'e0ng do c\'f5 s\u7903\'3f kinh t\u7871\'3f t\u7853\'3fp th\u7875\'3f, c\'e1 th\u7875\'3f t\u7921\'3f s\u7843\'3fn xu\u7845\'3ft, t\u7921\'3f b\'e1n ra th\u7883\'3f tr\'fd\u7901\'3fng ( k\u7875\'3f c
\u7843\'3f l\'e0m gia c\'f4ng cho c\'e1 nh\'e2n hay c\'e1c \'f0\'f5n v\u7883\'3f kinh t\u7871\'3f t\u7853\'3fp th\u7875\'3f kh\'e1c) gi\'e1 t\'ednh thu\u7871\'3f l\'e0 gi\'e1 b\'e1n l\u7867\'3f trung b}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec
nh tr\'ean th\u7883\'3f tr}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd\u7901\'3fng t\u7921\'3f do t\u7841\'3fi \'f0\u7883\'3fa ph\'fd\'f5ng tr\u7915\'3f (-) 10 %.
\par }{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 b) }{\f122\fs28\ul\cgrid0\insrsid7040147\charrsid4738633 Ng\'fd\u7901\'3fi n\u7897\'3fp thu\u7871\'3f h\'e0ng ho\'e1:}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633    
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 - \'d0\u7889\'3fi v\u7899\'3fi h\'e0ng ho\'e1 n\'f4ng s\u7843\'3fn: thu\u7871\'3f h\'e0ng ho\'e1 do ng\'fd\u7901\'3fi thu mua n\u7897\'3fp.
\par - \'d0\u7889\'3fi v\u7899\'3fi h\'e0ng ti\u7875\'3fu c\'f4ng nghi\u7879\'3fp, th\u7911\'3f c\'f4ng nghi\u7879\'3fp s\u7843\'3fn xu\u7845\'3ft thu\u7871\'3f h\'e0ng ho\'e1 do c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft n\u7897\'3fp. Th\u7921\'3fc hi\u7879
\'3fn quy \'f0\u7883\'3fnh n\'e0y th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec ng}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd\u7901\'3fi \'f0i gia c\'f4ng ph\u7843\'3fi thanh to\'e1n v\u7899\'3fi ng\'fd\u7901\'3fi nh\u7853\'3fn gia c
\'f4ng s\u7889\'3f ti\u7873\'3fn gia c\'f4ng v\'e0 ti\u7873\'3fn thu\u7871\'3f h\'e0ng ho\'e1 ( n\u7871\'3fu c\'f3 ) \'f0\u7875\'3f ng\'fd\u7901\'3fi nh\u7853\'3fn gia c\'f4ng n\u7897\'3fp thu\u7871\'3f h\'e0ng ho\'e1.}{
\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 - Tr\u7915\'3f\'f5ng h\u7907\'3fp li\'ean doanh h\u7907\'3fp doanh chia s\u7843\'3fn ph\u7849\'3fm th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec c}{
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft ph\u7843\'3fi n\u7897\'3fp thu\u7871\'3f h\'e0ng ho\'e1 nh\'fd tr\'fd\u7901\'3fng h\u7907\'3fp b\'e1n s\u7843\'3fn ph\u7849\'3fm c\u7911\'3fa m}{
\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh s\u7843\'3fn xu\u7845\'3ft ra v\'e0 theo nguy\'ean t\u7855\'3fc }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\u7883\'3fnh gi\'e1 t\'ednh thu\u7871\'3f n\'f3i tr\'ean.}{
