\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid16079946 {
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 1. C\'e3n c\u7913\'3f \'f0\u7875\'3f \'e1p d\u7909\'3fng thu\u7871\'3f m\'f4n b\'e0i l\'e0 thu nh\u7853\'3fp m\u7897\'3ft th\'e1ng c\u7911\'3fa c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3f
t kinh doanh. Thu nh\u7853\'3fp c\u7911\'3fa c\'e1c c\'f5 s\u7903\'3f h\u7907\'3fp doanh, h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 mua b\'e1n,  h\u7907\'3fp t\'e1c x\'e3 ti\'eau }{
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 th\u7909\'3f l\'e0 doanh thu tr\u7915\'3f (-), chi ph\'ed ( kh\'f4ng tr\u7915\'3f ti\u7873\'3fn l\'fd\'f5ng ) ; thu nh\u7853\'3fp c\u7911\'3fa c\'e1c c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3f
t kinh doanh kh\'e1c l\'e0 doanh thu tr\u7915\'3f  (- ) chi ph\'ed (kh\'f4ng tr\u7915\'3f su\u7845\'3ft mi\u7877\'3fn thu).
\par Thu\u7871\'3f m\'f4n b\'e0i thu h\'e0ng n\'e3m v\'e0 thu ngay t\u7915\'3f \'f0\u7847\'3fu n\'e3m, do \'f0\'f3 \'f0\u7875\'3f c\'f3 c\'e3n c\u7913\'3f x\u7871\'3fp b\u7853\'3fc m\'f4n b\'e0i ngay t\u7915\'3f \'f0\u7847\'3fu n\'e3m, ph\u7843\'3fi \'f0i
\u7873\'3fu tra x\'e1c \'f0\u7883\'3fnh thu nh\u7853\'3fp c\u7911\'3fa c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh v\'e0o th\'e1ng g\u7847\'3fn nh\u7845\'3ft c\u7911\'3fa n\'e3m thu thu\u7871\'3f, t\u7913\'3fc l\'e0 th\'e1ng 10, th\'e1
ng 11, th\'e1ng 12, c\u7911\'3fa n\'e3m tr\'fd\u7899\'3fc; \'d0\u7891\'3fng th\u7901\'3fi c\'f3 ph\'e2n t\'edch t}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh h\'ecnh ph\'e1t tri\u7875\'3fn c\u7911\'3fa n}{
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3m thu thu\u7871\'3f \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh \'f0\'fang thu nh\u7853\'3fp l\'e0m c\'e3n c\u7913\'3f x\'e1c \'f0\u7883\'3fnh s\u7889\'3f thu\u7871\'3f m\'f4n b\'e0i ph\u7843\'3fi n\u7897
\'3fp; \'d0\u7889\'3fi v\u7899\'3fi c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh theo m\'f9a v\u7909\'3f th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec t\'ednh thu nh\u7853\'3fp b\'ecnh qu\'e2n th\'e1ng trong m\'f9a v\u7909\'3f c\'f3 t
\'ecnh h\'ecnh s\u7843\'3fn xu\u7845\'3ft kinh doanh t}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd\'f5ng \'f0\u7889\'3fi b}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh th}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd\u7901
\'3fng.
\par \'d0\u7889\'3fi v\u7899\'3fi c\'f5 s\u7903\'3f m\u7899\'3fi b\u7855\'3ft \'f0\u7847\'3fu kinh doanh th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec c}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3n c\u7913\'3f v\'e0o thu nh\u7853\'3fp c
\u7911\'3fa c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh kh\'e1c c\'f3 quy m\'f4 t\'fd\'f5ng \'f0\'fd\'f5ng v\'e0 c\'f9ng ng\'e0nh ngh\u7873\'3f, c\'f9ng t\'ednh ch\u7845\'3ft kinh doanh.
\par 2. C\'f5 s\u7903\'3f n\'e0o ch\u7881\'3f mang danh ngh\u297\'3fa l\'e0 kinh t\u7871\'3f t\u7853\'3fp th\u7875\'3f, th\u7921\'3fc ch\u7845\'3ft l\'e0 ho\u7841\'3ft \'f0\u7897\'3fng kinh doanh c\'e1 th\u7875\'3f, h\'e0ng th\'e1ng quy \'f0\u7883\'3fnh cho t
\u7915\'3fng h\u7897\'3f ph\u7843\'3fi n\u7897\'3fp m\u7897\'3ft s\u7889\'3f ti\u7873\'3fn ho\u7863\'3fc theo}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633  m\u7897\'3ft t\u7927\'3f l\u7879\'3f kho\'e1n tr\'ean doanh s\u7889\'3f  ho\u7863\'3fc thu nh
\u7853\'3fp ...  th\'ec thu thu\u7871\'3f m\'f4n b\'e0i theo t\u7915\'3fng h\u7897\'3f t}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd nh\'e2n, c\'e1 th\u7875\'3f.
\par 3. Nh\u7919\'3fng c\'f5 s\u7903\'3f c\'f3 gi\u7845\'3fy ph\'e9p kinh doanh th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec thu thu\u7871\'3f m\'f4n b\'e0i v\'e0 c\u7845\'3fp th\u7867\'3f m\'f4n b\'e0i. Nh\u7919\'3fng c}{
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5 s\u7903\'3f kh\'f4ng c\'f3 gi\u7845\'3fy ph\'e9p kinh doanh nh\'fdng \'f0\'fd\u7907\'3fc c\'f5 quan c\'f3 th\u7849\'3fm quy\u7873\'3fn}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633  x\'e1c nh\u7853
\'3fn l\'e0 c\'f3 l\'fd do ch\'ednh }{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'e1ng th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec thu thu\u7871\'3f m\'f4n b\'e0i nh}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fdng kh\'f4
ng c\u7845\'3fp th\u7867\'3f m\'f4n b\'e0i, kh\'f4ng b\u7883\'3f x\u7917\'3f ph\u7841\'3ft theo \'f0i\u7873\'3fu l\u7879\'3f \'f0\'e3ng k}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd kinh doanh. }{\f0\fs28\cgrid0\insrsid5648192 
\par }\pard \qc \li0\ri0\keepn\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\outlinelevel2\adjustright\rin0\lin0\itap0\pararsid12530174 {
\b\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 II- THU\u7870\'3f DOANH  NGHI\'caP
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid11300073 {
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 1. M\u7913\'3fc thu\u7871\'3f xu\u7845\'3ft 4% \'f0\'fd\u7907\'3fc \'e1p d\u7909\'3fng \'f0\u7889\'3fi v\u7899\'3fi ng\'e0nh th\'fd\'f5ng nghi\u7879\'3fp b\'e1n rau qu\u7843\'3f, th\u7921\'3fc ph\u7849\'3f
m t\'fd\'f5i s\u7889\'3fng, bao g\u7891\'3fm c\u7843\'3f \'f0\u7889\'3fi v\u7899\'3fi b\'e1n c\'e1c m\u7863\'3ft h\'e0ng t\'fd\'f5ng ch\'e1o, d\'fda c\'e0, l\'fd\'f5n, cua, \u7889\'3fc, \u7871\'3fch, c\'e1c lo\u7841\'3fi c\u7911\'3f, qu\u7843\'3f...

\par   2. M\u7913\'3fc thu\u7871\'3f su\u7845\'3ft 6% \'e1p d\u7909\'3fng \'f0\u7889\'3fi v\u7899\'3fi ng\'e0nh th\'fd\'f5ng nghi\u7879\'3fp b\'e1n c\'e1c m\u7863\'3ft n\'f4ng, l\'e2m, h\u7843\'3fi s\u7843\'3fn kh\'e1c, bao g\u7891\'3fm c\u7843\'3f \'f0\u7889
\'3fi v\u7899\'3fi b\'e1n m\u7855\'3fm, mu\u7889\'3fi, \'f0\'fd\u7901\'3fng m\u7853\'3ft, c\'e1c m\u7863\'3ft h\'e0ng kh\'f4 (nh\'fd m\'e3ng, mi\u7871\'3fn, c\u7911\'3f n\'e2u, m\u7897\'3fc nh\u297\'3f, n\u7845\'3fm h\'fd\'f5ng, t\'f4m kh\'f4, c\'e1 kh
\'f4, l\u7841\'3fc, v\u7915\'3fng, d\'fd\u7907\'3fc li\u7879\'3fu... )}{\f0\fs28\cgrid0\insrsid5648192 
\par }\pard \qc \li0\ri0\keepn\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\outlinelevel2\adjustright\rin0\lin0\itap0\pararsid2508354 {
\b\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 III- THU\u7870\'3f L\u7906\'3fI T\u7912\'3fC DOANH NGHI\u7878\'3fP 
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid11300073 {
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 1. Ti\u7873\'3fn c\'f4ng tr\u7843\'3f cho lao \'f0\u7897\'3fng thu\'ea ngo\'e0i \'f0\'fd\u7907\'3fc t\'ednh tr\u7915\'3f v\'e0o chi ph\'ed s\u7843\'3fn xu\u7845\'3ft kinh doanh, nh\'fdng t\u7889\'3fi \'f0
a tr\u7915\'3f kh\'f4ng qu\'e1 su\u7845\'3ft mi\u7877\'3fn thu c\'f9ng ng\'e0nh ngh\u7873\'3f trong \'f0\u7883\'3fa ph\'fd\'f5ng; ri\'eang \'f0\u7889\'3fi v\u7899\'3fi ng\'fd\u7901\'3fi lao \'f0\u7897\'3fng c\'f3 tr}{
\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\u7897\'3f k\u7929\'3f thu\u7853\'3ft cao, \'f0\'fd\u7907\'3fc ph}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f2ng thu\u7871\'3f qu\u7853
\'3fn, huy\u7879\'3fn c\'f4ng nh\u7853\'3fn th\'ec c\'f3 th\u7875\'3f tr\u7915\'3f cao h}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5n, nh\'fdng t\u7889\'3fi \'f0a kh\'f4ng qu\'e1 hai l\u7847\'3fn su\u7845\'3ft mi\u7877\'3fn thu c\'f9ng ng\'e0
nh ngh\u7873\'3f trong \'f0\u7883\'3fa ph\'fd\'f5ng.
\par }{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633   Ti\u7873\'3fn c\'f4ng tr\u7843\'3f cho th\u7907\'3f h\u7885\'3fc vi\u7879\'3fc (n\u7871\'3fu }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 c\'f3) \'f0\'fd\u7907\'3fc t\'ednh tr\u7915\'3f v\'e0
o chi ph\'ed s\u7843\'3fn xu\u7845\'3ft kinh doanh, nh\'fdng t\u7889\'3fi \'f0a kh\'f4ng tr\u7915\'3f qu\'e1 1/2 su\u7845\'3ft mi\u7877\'3fn thu c\'f9ng ng\'e0nh ngh\u7873\'3f trong \'f0\u7883\'3fa ph\'fd\'f5ng.
\par }{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633  2. C\'e1ch t\'ednh s\u7889\'3f su\u7845\'3ft mi\u7877\'3fn thu:
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633  \'d0i\u7873\'3fu 14 c\u7911\'3fa \'f0i\u7873\'3fu l\u7879\'3f thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp quy \'f0\u7883\'3fnh: \'93\'d0\u7889\'3fi v\u7899\'3fi h\u7907\'3fp t\'e1c x}{
\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3, khi t\'ednh l\u7907\'3fi t\u7913\'3fc ch\u7883\'3fu thu\u7871\'3f, m\u7895\'3fi x\'e3 vi\'ean c\'f3 th\u7921\'3fc t\u7871\'3f tham gia s\u7843\'3fn xu\u7845\'3ft trong k\u7923\'3f kinh doanh (k\u7875
\'3f c\u7843\'3f c\'f4ng tr\u7921\'3fc ti\u7871\'3fp v\'e0 gi\'e1n ti\u7871\'3fp) }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'fd\u7907\'3fc tr\u7915\'3f m\u7897\'3ft su\u7845\'3ft mi\u7877\'3fn thu\'94; Nh\'fd v\u7853\'3fy l\'e0 chi ph\'ed t
\'ednh tr\u7915\'3f su\u7845\'3ft mi\u7877\'3fn thu cho nh\u7919\'3fng x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 vi\'ean c\'f3 tham gia s\u7843\'3fn xu\u7845\'3ft trong k\u7923\'3f kinh doanh. C\'f3 th\u7921\'3fc t\u7871\'3f tham gi}{
\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 a s\u7843\'3fn xu\u7845\'3ft ph\u7843\'3fi c\'f3 mang l\u7841\'3fi hi\u7879\'3fu qu\u7843\'3f s\u7843\'3fn xu\u7845\'3ft, th\u7875\'3f hi\u7879\'3fn \u7903\'3f n\'e3ng su\u7845\'3ft lao \'f0\u7897\'3fng t
\'ednh b\u7857\'3fng hi\u7879\'3fn v\u7853\'3ft gi\'e1 tr\u7883\'3f.
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633    C\'e3n c\u7913\'3f v\'e0o nguy\'ean t\u7855\'3fc tr\'ean v\'e0 tu\u7923\'3f theo t}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh h\'ecnh th\u7921\'3fc t\u7871\'3f c\u7911\'3fa t\u7915\'3fng c}
{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh \u7903\'3f t\u7915\'3fng \'f0\u7883\'3fa ph\'fd\'f5ng m\'e0 \'e1p d\u7909\'3fng ph\'fd\'f5ng ph\'e1p x\'e1c \'f0\u7883\'3fnh s\u7889\'3f su\u7845\'3f
t mi\u7877\'3fn thu cho th\'edch h\u7907\'3fp. D\'fd\u7899\'3fi \'f0\'e2y l\'e0 b\u7897\'3f h\'fd\u7899\'3fng d\u7851\'3fn x\'e1c \'f0\u7883\'3fnh su\u7845\'3ft mi\u7877\'3fn thu:
\par    a. \'d0\u7889\'3fi v\u7899\'3fi c\'e1c c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft \'f0\u7873\'3fu \'f0\u7863\'3fn, li\'ean t\u7909\'3fc, x\'e1c \'f0\u7883\'3fnh r}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5 }{
\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'fd\u7907\'3fc s\u7889\'3f x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 vi\'ean c\'f3 th\u7921\'3fc t\u7871\'3f tham gia s\u7843\'3fn xu\u7845\'3ft trong k\u7923\'3f kinh doanh th\'ec s\u7889
\'3f su\u7845\'3ft mi\u7877\'3fn thu }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'fd\u7907\'3fc t\'ednh theo s\u7889\'3f x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 vi\'ean c\'f3 tham gia s\u7843\'3fn xu\u7845\'3ft.
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633   b. \'d0\u7889\'3fi v\u7899\'3fi c\'e1c c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft kh\'f4ng th\'fd\u7901\'3fng xuy\'ean, kh\'f4ng x\'e1c \'f0\u7883\'3fnh r}{
\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f5 }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'fd\u7907\'3fc s\u7889\'3f x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 vi\'ean c\'f3 th\u7921\'3fc t\u7871\'3f tham gia s\u7843\'3fn xu
\u7845\'3ft th\'ec c\'f3 th\u7875\'3f \'e1p d\u7909\'3fng c\'e1c c\'e1ch sau }{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\'e2y \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh s\u7889\'3f su\u7845\'3ft mi\u7877\'3fn thu:
\par }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633  - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng n\'f5i \'f0}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3 c\'f3 }{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\u7883\'3fnh m\u7913\'3fc n\'e3
ng su\u7845\'3ft lao \'f0\u7897\'3fng th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633  c\'e3n c\u7913\'3f v\'e0o \'f0\'f3 \'f0\u7875\'3f t\'ednh su\u7845\'3ft mi\u7877\'3fn thu. \'d0\u7883\'3fnh m
\u7913\'3fc n\'e3ng su\u7845\'3ft lao \'f0\u7897\'3fng c\'f3 th\u7875\'3f b\u7857\'3fng hi\u7879\'3fn v\u7853\'3ft (s\u7889\'3f l\'fd\u7907\'3fng s\u7843\'3fn ph\u7849\'3fm ) ho\u7863\'3fc b\u7857\'3fng gi\'e1 tr\u7883\'3f (doanh thu hay thu nh\u7853\'3f
p) .
\par  - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f qu\u7843\'3fn l}{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 \'fd t\u7889\'3ft lao \'f0\u7897\'3fng, t\u7893\'3f ch\u7913\'3fc theo d}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 
\'f5i ch\u7845\'3fm c\'f4ng ch\'ednh x\'e1c th\'ec c}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3n c\u7913\'3f v\'e0o s\u7889\'3f ng\'e0}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 y c\'f4ng th\u7921\'3fc t\u7871\'3f c\u7911\'3fa x\'e3 vi
\'ean th\u7921\'3fc t\u7871\'3f tham gia s\u7843\'3fn xu\u7845\'3ft trong k\u7923\'3f kinh doanh }{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\u7875\'3f t\'ednh s\u7889\'3f su\u7845\'3ft mi\u7877\'3fn thu b\u7857\'3fng c\'e1ch l\u7845\'3fy t
\u7893\'3fng s\u7889\'3f ng\'e0y c\'f4ng c\u7911\'3fa c\'f5 s\u7903\'3f chia cho ng\'e0y c\'f4ng ch\u7871\'3f \'f0\u7897\'3f c\u7911\'3fa t\u7915\'3fng th\'e1ng. Khi chia, s\u7889\'3f ng\'e0y c\'f4ng l\u7867\'3f t\u7915\'3f 14 ng\'e0y tr\u7903\'3f l\'ean 
\'f0\'fd\u7907\'3fc t\'ednh l\'e0 m\u7897\'3ft su\u7845\'3ft mi\u7877\'3fn thu, d\'fd\u7899\'3fi 14 ng\'e0y \'f0\'fd\u7907\'3fc t\'ednh l\'e0 1/2 (m\u7897\'3ft ph\u7847\'3fn hai ) su\u7845\'3ft mi\u7877\'3fn thu.
\par - \'d0\u7889\'3fi v\u7899\'3fi c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft theo m\'f9a v\u7909\'3f th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec ph\u7843\'3fi c}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3n c\u7913\'3f v\'e0o \'f0
\u7883\'3fnh m\u7913\'3fc n\'e3ng su\u7845\'3ft lao \'f0\u7897\'3fng c\u7911\'3fa m\'f9a v\u7909\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh t\'fd\'f5ng \'f0\u7889\'3fi th\'fd\u7901\'3fng xuy\'ean v\'e0 \u7893\'3fn \'f0\u7883\'3fnh nh\u7845\'3ft \'f0\u7875
\'3f t\'ednh su\u7845\'3ft mi\u7877\'3fn thu.
\par }{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 - \'d0\u7889\'3fi v\u7899\'3fi h\u7897\'3f r}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 i\'eang l\u7867\'3f s\u7843\'3fn xu\u7845\'3ft ti\u7875\'3fu, th\u7911\'3f c\'f4ng nghi\u7879\'3fp, l\'e0
m ngh\u7873\'3f v\u7853\'3fn t\u7843\'3fi, x\'e2y d\u7921\'3fng c\u361\'3fng c\'f3 th\u7875\'3f \'e1p d\u7909\'3fng c\'e1c ph\'fd\'f5ng ph\'e1p tr\'ean \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh s\u7889\'3f su\u7845\'3ft mi\u7877\'3fn thu; N\u7871\'3f
u kinh doanh cho c\'e1c ng\'e0nh ph\u7909\'3fc v\u7909\'3f \'f0\'fd\u7907\'3fc tr\u7915\'3f nhi\u7873\'3fu nh\u7845\'3ft l\'e0 hai su\u7845\'3ft mi\u7877\'3fn thu cho ng\'fd\u7901\'3fi trong h\u7897\'3f c\'f3 th\u7921\'3fc t\u7871\'3f tham gia k
inh doanh; N\u7871\'3fu kinh doanh ng\'e0nh th\'fd\'f5ng nghi\u7879\'3fp, n\'f3i chung ch\u7881\'3f \'f0\'fd\u7907\'3fc tr\u7915\'3f m\u7897\'3ft su\u7845\'3ft mi\u7877\'3fn thu, nh\'fdng \'f0\u7889\'3fi v\u7899\'3fi h\u7897\'3f c\'f3 doanh s\u7889\'3f l
\u7899\'3fn (h\u7897\'3f m\'f4n b\'e0i b\u7853\'3fc 1, b\u7853\'3fc 2 ) ph\u7843\'3fi s\u7917\'3f d\u7909\'3fng nhi\u7873\'3fu lao \'f0\u7897\'3fng trong gia \'f0}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ecnh }{
\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 \'f0\u7875\'3f ph\u7909\'3fc v\u7909\'3f ho\u7841\'3ft \'f0\u7897\'3fng kinh doanh th}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'ec c\'f3 th\u7875\'3f t\'ednh tr\u7915\'3f th\'eam m\u7897\'3ft su
\u7845\'3ft mi\u7877\'3fn thu.
\par  3. C\'e1ch t\'ednh thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp
\par }{\f114\fs28\cgrid0\insrsid7040147\charrsid4738633 a. \'d0\u7889\'3fi v\u7899\'3fi h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3, t\u7893\'3f s\u7843\'3fn xu\u7845\'3ft , ng\'e0nh s\u7843\'3fn xu\u7845\'3ft ti\u7875\'3f th
\u7911\'3f c\'f4ng nghi\u7879\'3fp, v\u7853\'3fn t\u7843\'3fi, x\'e2y d\u7921\'3fng: l\u7907\'3fi t\u7913\'3fc l\'e0m c}{\f122\fs28\cgrid0\insrsid7040147\charrsid4738633 \'e3n c\u7913\'3f \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh thu\u7871\'3f su\u7845\'3f
