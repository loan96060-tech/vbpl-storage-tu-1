\u7845\'3fp I.
\par C\'e1c ng\'e0nh, c\'e1c \'f0\'f5n v\u7883\'3f, c\'e1c t\u7893\'3f ch\u7913\'3fc n\'f3i tr\'ean \'f0\u7873\'3fu ph\u7843\'3fi c\'f3 b\u7897\'3f m\'f4n k\u7871\'3f to\'e1n, t\'e0i v\u7909\'3f \'f0\u7843\'3fm nhi\u7879\'3fm  c\'f4ng t\'e1c qu\u7843\'3fn l}{
\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'fd t\'e0i ch\'ednh, k\u7871\'3f to\'e1n c\u7911\'3fa c\'e1c }{\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 \'f0\'f5n v\u7883\'3f theo ch\u7871\'3f \'f0\u7897\'3f Nh\'e0 n\'fd\u7899\'3fc v\'e0 ch\u7883
\'3fu s\u7921\'3f ki\u7875\'3fm tra, gi\'e1m s\'e1t c\u7911\'3fa Ban T\'e0i ch\'ednh  - G}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 i\'e1 c\u7843\'3f huy\u7879\'3fn.
\par }{\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 C\'e1c S\u7903\'3f, Ty t\'e0i ch\'ednh v\'e0 U\u7927\'3f ban V\u7853\'3ft gi\'e1 ph\u7889\'3fi h\u7907\'3fp v\u7899\'3fi c\'e1c ng\'e0nh \u7903\'3f t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, c\'f3 k\u7871\'3f
 ho\u7841\'3fch v\'e0 bi\u7879\'3fn ph\'e1p c\u7909\'3f th\u7875\'3f ch\u7881\'3f \'f0\u7841\'3fo c\'e1c Ban chuy\'ean m\'f4n, c\'e1c \'f0\'f5n v\u7883\'3f thu\u7897\'3fc c\'e1c ng\'e0nh \u7903\'3f huy\u7879\'3fn t\u7893\'3f ch\u7913\'3fc vi\u7879\'3fc qu
\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'fd t\'e0i ch\'ednh  v\'e0 gi\'e1 c\u7843\'3f; b\u7891\'3fi d}{\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 \'fd\u7905\'3fng nghi\u7879\'3fp v\u7909\'3f; gi\'fap U\u7927\'3f ban Nh\'e2
n d\'e2n huy\u7879\'3fn gi\u7843\'3fi quy\u7871\'3ft k\u7883\'3fp th\u7901\'3fi nh\u7919\'3fng v\'fd\u7899\'3fng m\u7855\'3fc trong qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'fd s\u7843\'3fn xu\u7845\'3ft kinh doanh, qu\u7843\'3f
n l\'fd t\'e0i ch\'ednh v\'e0 gi\'e1 c\u7843\'3f.
\par }{\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 Ban T\'e0i ch\'ednh  - Gi\'e1 c\u7843\'3f huy\u7879\'3fn l\'e0m vi\u7879\'3fc theo ch\u7871\'3f \'f0\u7897\'3f th\u7911\'3f tr\'fd\u7903\'3fng, k\u7871\'3ft h\u7907\'3fp b\'e0n b\u7841\'3fc d\'e2n ch
\u7911\'3f t\u7853\'3fp th\u7875\'3f v\'e0 c\'e1 nh\'e2n ph\u7909\'3f tr\'e1ch. Tr\'fd\u7903\'3fng ban ch\u7883\'3fu tr\'e1ch nhi\u7879\'3fm tr\'fd\u7899\'3fc U\u7927\'3f ban Nh\'e2n d\'e2n huy\u7879\'3fn v\'e0 tr\'fd\u7899\'3fc S\u7903\'3f, Ty t\'e0i ch
\'ednh v\'e0 U\u7927\'3f ban V\u7853\'3ft gi\'e1 t\u7881\'3fnh, th\'e0nh ph\u7889\'3f v\u7873\'3f to\'e0n b\u7897\'3f c\'f4ng t\'e1c c\u7911\'3fa Ban, tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch v\u7873\'3f k\u7871\'3f ho\u7841\'3fch t\'e0i ch\'ed
nh v\'e0 ng\'e2n s\'e1ch  hu\u7925\'3f\u7879\'3fn, ho\u7863\'3fc tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch c\'f4ng t\'e1c gi\'e1 c\u7843\'3f (tu\u7923\'3f theo kh\u7843\'3f n\'e3ng c\u7911\'3fa c\'e1n b\u7897\'3f \'f0\'fd\u7907\'3fc ph\'e2n c\'f4
ng gi\u7919\'3f ch\u7913\'3fc v\u7909\'3f tr\'fd\u7903\'3fng ban). C\'e1c ph\'f3 ban \'f0\'fd\u7907\'3fc tr\'fd\u7903\'3fng ban ph\'e2n c\'f4ng chuy\'ean tr\'e1ch t\u7915\'3fng ph\u7847\'3fn h\'e0nh c\'f4ng vi\u7879\'3fc c\u7911\'3fa Ban v\'e0 ch\u7883
\'3fu tr\'e1ch nhi\u7879\'3fm tr\'fd\u7899\'3fc tr\'fd\u7903\'3fng ban.
\par N\u7871\'3fu tr\'fd\u7903\'3fng ban kh\'f4ng tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch c\'f4ng t\'e1c gi\'e1 c\u7843\'3f, th}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'ec c\'f3 m\u7897\'3ft ph\'f3 ban chuy\'ean tr\'e1ch v\u7873\'3f gi\'e1
 c\u7843\'3f.
\par }\pard \qc \li0\ri0\keepn\widctlpar\tx1098\tx1665\tx2232\tx2799\tx3366\tx3933\tx4500\tx5067\tx5634\tx6201\tx6768\tx7335\tx7902\tx8469\tx9036\tx9603\tx10170\tx10737\tx11304\tx11871\faauto\outlinelevel2\adjustright\rin0\lin0\itap0\pararsid12083868 {
