\'e1n b\u7897\'3f c}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 ho c\'e1c huy\u7879\'3fn m\u7897\'3ft c\'e1ch h\u7907\'3fp l\'fd theo khung t\u7893\'3f ch\u7913\'3fc n\'eau tr\'ean. C\'e1c huy\u7879\'3fn }{
\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 \'f0i\u7875\'3fm c\u7911\'3fa Trung \'fd\'f5ng v\'e0 c\u7911\'3fa t\u7881\'3fnh c\'e0n l\'e0m tr\'fd\u7899\'3fc m\u7897\'3ft b\'fd\u7899\'3fc, \'f0i\u7873\'3fu \'f0\u7897\'3fng b\u7893\'3f sung c\'e1n b
\u7897\'3f ch\u7845\'3ft  l\'fd\u7907\'3fng c\u7911\'3fa t\u7881\'3fnh v\u7873\'3f t\'e3ng c\'fd\u7901\'3fng tr\'fd\u7899\'3fc ti\'ean cho c\'e1c huy\u7879\'3fn \'f0i\u7875\'3fm.
\par C\'e1c t\u7881\'3fnh v\'e0 th\'e0nh ph\u7889\'3f c\u7847\'3fn t\'e3ng c\'fd\u7901\'3fng m\u7903\'3f c\'e1c l\u7899\'3fp b\u7891\'3fi d\'fd\u7905\'3fng, \'f0\'e0o t\u7841\'3fo c\'e1n b\u7897\'3f k\u7871\'3f to\'e1n - t\'e0i ch\'ednh  - gi\'e1 c\u7843\'3f
 cho c\'e1c huy\u7879\'3fn, c\'e1c ng\'e0nh, v\'e0 cho c\'e1c h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'e3.
\par }{\f185\fs28\cgrid0\insrsid10380755\charrsid6177483 C\'e1c huy\u7879\'3fn ph\u7843\'3fi so\'e1t x\'e9t l\u7841\'3fi \'f0\u7897\'3fi ng\u361\'75 c\'e1n b\u7897\'3f c\u7911\'3fa m}{\f0\fs28\cgrid0\insrsid10380755\charrsid6177483 \'ecnh }{
\f193\fs28\cgrid0\insrsid10380755\charrsid6177483 \'f0\u7875\'3f c\'f3 k\u7871\'3f ho\u7841\'3fch s\u7855\'3fp x\u7871\'3fp, b\u7889\'3f tr\'ed, s\u7917\'3f d\u7909\'3fng k\'e8m c\u7863\'3fp, b\u7891\'3fi d\'fd\u7905\'3fng, \'f0\'e0o t\u7841\'3fo tr\u7913
\'3f\'f5c m\u7855\'3ft v\'e0 l\'e2u d\'e0i v\'e0 chu\u7849\'3fn b\u7883\'3f s\u7861\'3fn c\'e1n b\u7897\'3f \'f0i d\u7921\'3f c\'e1c l\u7899\'3fp b\u7891\'3fi d\'fd\u7905\'3fng, \'f0\'e0o t\u7841\'3fo, t\u7853\'3fp hu\u7845\'3fn c\u7911\'3fa Trung \'fd
\'f5ng, t\u7881\'3fnh, th\'e0nh ph\u7889\'3f m\u7903\'3f.
