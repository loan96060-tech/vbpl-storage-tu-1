\f96\insrsid13725196\charrsid13725196 n nh\'fd: r\'e3ng gi}{\f0\insrsid13725196\charrsid13725196 \u7843\'3f}{\f88\insrsid13725196\charrsid13725196 , \'f0}{\f0\insrsid13725196\charrsid13725196 \u7891\'3f gi\u7843\'3f c\u7893\'3f, ch\'e2n tay gi\u7843\'3f
, hoa gi\u7843\'3f...
\par \page 
\par }\pard \qc \li0\ri0\sb120\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f0\fs22\expnd5\expndtw28\insrsid13725196\charrsid13725196 II - GI\u7842\'3fI TH\'cdCH M\u7896\'3fT S\u7888\'3f THU\u7852\'3fT NG\u7918\'3f}{
\b\f96\fs22\expnd5\expndtw28\insrsid13725196\charrsid13725196  \line TRONG TH\'d4NG T\'dd N\'c0Y
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid13725196\charrsid13725196 
\par 1- Nh\'e3n h\'e0ng ho\'e1: L\'e0 b\u7843\'3fn vi\u7871\'3ft, b\u7843\'3fn in, h\'ecnh v\u7869\'3f, h\'ecnh \u7843\'3fnh, d\u7845\'3fu hi\u7879\'3f}{\f96\insrsid13725196\charrsid13725196 u \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc in ch
\'ecm, in n\u7893\'3fi tr\u7921\'3fc ti\u7871\'3fp ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3f}{\f96\insrsid13725196\charrsid13725196 c d\'e1n, \'f0\'ednh, c\'e0i ch}{
\f0\insrsid13725196\charrsid13725196 \u7855\'3fc ch\u7855\'3fn tr\'ean h\'e0ng ho\'e1 ho\u7863\'3fc bao b\'ec }{\f88\insrsid13725196\charrsid13725196 \'f0}{\f0\insrsid13725196\charrsid13725196 \u7875\'3f th\u7875\'3f hi\u7879\'3fn c\'e1c th\'f4ng tin c
\u7847\'3fn thi\u7871\'3ft, ch\u7911\'3f y\u7871\'3fu v\u7873\'3f}{\f96\insrsid13725196\charrsid13725196  h\'e0ng ho\'e1 \'f0\'f3.
\par }{\f0\insrsid13725196\charrsid13725196 2- Nh\'e3n hi\u7879\'3fu h\'e0ng ho\'e1: L\'e0 nh\u7919\'3fng d\u7845\'3fu hi\u7879\'3f}{\f96\insrsid13725196\charrsid13725196 u d\'f9ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7875\'3f ph\'e2n bi\u7879\'3ft h
\'e0ng ho\'e1, d\u7883\'3fch v\u7909\'3f c\'f9ng lo\u7841\'3fi c\u7911\'3f}{\f96\insrsid13725196\charrsid13725196 a c\'e1c c\'f5 s}{\f0\insrsid13725196\charrsid13725196 \u7903\'3f s\u7843\'3fn xu\u7845\'3ft, kinh doanh kh\'e1c nhau. Nh\'e3n hi\u7879\'3f
u h\'e0ng ho\'e1 c\'f3 th\u7875\'3f l\'e0 t\u7915\'3f ng\u7919\'3f, h\'ecnh \u7843\'3fnh ho\u7863\'3fc s\u7921\'3f k\u7871\'3ft h\u7907\'3fp c\'e1c y\u7871\'3fu t\u7889\'3f}{\f96\insrsid13725196\charrsid13725196  \'f0\'f3 \'f0\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7907\'3fc th\u7875\'3f hi\u7879\'3fn b\u7857\'3fng m\u7897\'3ft ho\u7863\'3fc nhi\u7873\'3fu m\'e0u s\u7855\'3fc.
\par 3- T\'ean h\'e0ng ho\'e1: L\'e0 t\'ean g\u7885\'3fi c\u7909\'3f th\u7875\'3f c\u7911\'3fa s\u7843\'3fn ph\u7849\'3fm, h\'e0ng ho\'e1 n\'f3i l\'ean b\u7843\'3fn ch\u7845\'3ft c\u7911\'3f}{\f96\insrsid13725196\charrsid13725196 a h\'e0ng ho\'e1 \'f0}{
\f0\insrsid13725196\charrsid13725196 \'e3 }{\f96\insrsid13725196\charrsid13725196 \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ti\'eau chu\u7849\'3fn ho\'e1 ho\u7863\'3f}{\f88\insrsid13725196\charrsid13725196 c \'f0}{
\f0\insrsid13725196\charrsid13725196 \'e3 quen thu\u7897\'3fc v\u7899\'3f}{\f96\insrsid13725196\charrsid13725196 i ng\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3fi ti\'eau d\'f9ng.
\par 4- T\'ean g\u7885\'3fi xu\u7845\'3ft x\u7913\'3f}{\f96\insrsid13725196\charrsid13725196  h\'e0ng ho\'e1: L\'e0 t\'ean \'f0}{\f0\insrsid13725196\charrsid13725196 \u7883\'3fa l\'fd c\u7911\'3f}{\f96\insrsid13725196\charrsid13725196 a n\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7899\'3f}{\f88\insrsid13725196\charrsid13725196 c, \'f0}{\f0\insrsid13725196\charrsid13725196 \u7883\'3f}{\f96\insrsid13725196\charrsid13725196 a ph\'fd\'f5ng d\'f9n}{\f88\insrsid13725196\charrsid13725196 g \'f0}{
\f0\insrsid13725196\charrsid13725196 \u7875\'3f ch\u7881\'3f xu\u7845\'3ft x\u7913\'3f c\u7911\'3fa m\u7863\'3ft h\'e0ng t\u7915\'3f}{\f96\insrsid13725196\charrsid13725196  n\'fd}{\f0\insrsid13725196\charrsid13725196 \u7899\'3f}{
\f88\insrsid13725196\charrsid13725196 c, \'f0}{\f0\insrsid13725196\charrsid13725196 \u7883\'3f}{\f96\insrsid13725196\charrsid13725196 a ph\'fd\'f5ng \'f0\'f3 v}{\f0\insrsid13725196\charrsid13725196 \u7899\'3f}{\f88\insrsid13725196\charrsid13725196 i \'f0i
}{\f0\insrsid13725196\charrsid13725196 \u7873\'3fu ki\u7879\'3fn nh\u7919\'3fng m\u7863\'3ft h\'e0ng n\'e0y c\'f3 c\'e1c t\'ednh ch\u7845\'3ft, ch\u7845\'3f}{\f96\insrsid13725196\charrsid13725196 t l\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3f}{
\f88\insrsid13725196\charrsid13725196 ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7863\'3fc th\'f9 d\u7921\'3f}{\f96\insrsid13725196\charrsid13725196 a tr\'ean c\'e1c \'f0i}{\f0\insrsid13725196\charrsid13725196 \u7873\'3fu ki\u7879\'3f}{
\f88\insrsid13725196\charrsid13725196 n \'f0}{\f0\insrsid13725196\charrsid13725196 \u7883\'3f}{\f88\insrsid13725196\charrsid13725196 a l\'fd \'f0}{\f0\insrsid13725196\charrsid13725196 \u7897\'3f}{\f96\insrsid13725196\charrsid13725196 c \'f0\'e1o v\'e0 
\'fdu vi}{\f0\insrsid13725196\charrsid13725196 \u7879\'3ft, bao g\u7891\'3fm y\u7871\'3fu t\u7889\'3f t\u7921\'3f}{\f96\insrsid13725196\charrsid13725196  nhi\'ean, con ng\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3fi ho\u7863\'3fc k\u7871\'3ft h
\u7907\'3fp c\u7843\'3f hai y\u7871\'3fu t\u7889\'3f}{\f88\insrsid13725196\charrsid13725196  \'f0\'f3.
\par }{\f0\insrsid13725196\charrsid13725196 5- Ki\u7875\'3fu d\'e1ng c\'f4ng nghi\u7879\'3fp: L\'e0 h\'ecnh d\'e1ng b\'ean ngo\'e0i c\u7911\'3fa s\u7843\'3fn ph\u7849\'3f}{\f96\insrsid13725196\charrsid13725196 m \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 
\u7907\'3fc th\u7875\'3f hi\u7879\'3fn b\u7857\'3f}{\f96\insrsid13725196\charrsid13725196 ng \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3fng n\'e9t, h\'ecnh kh\u7889\'3fi, m\'e0u s\u7855\'3fc ho\u7863\'3fc s\u7921\'3f k\u7871\'3ft h\u7907\'3f
p nh\u7919\'3fng y\u7871\'3fu t\u7889\'3f}{\f88\insrsid13725196\charrsid13725196  \'f0\'f3 c\'f3 t\'ednh  m}{\f0\insrsid13725196\charrsid13725196 \u7899\'3f}{\f88\insrsid13725196\charrsid13725196 i \'f0}{\f0\insrsid13725196\charrsid13725196 \u7889\'3fi v
\u7899\'3fi th\u7871\'3f gi\u7899\'3fi d\'f9ng l\'e0m m\u7851\'3f}{\f88\insrsid13725196\charrsid13725196 u \'f0}{\f0\insrsid13725196\charrsid13725196 \u7875\'3f s\u7843\'3fn xu\u7845\'3ft s\u7843\'3fn ph\u7849\'3fm c\'f4ng nghi\u7879\'3fp ho\u7863\'3fc th
\u7911\'3f c\'f4ng nghi\u7879\'3fp.
\par 
\par }\pard \qc \li0\ri0\sb120\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f0\fs22\expnd5\expndtw28\insrsid13725196\charrsid13725196 III-  H\'c0NG GI\u7842\'3f
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid13725196\charrsid13725196 
\par H\'e0ng ho\'e1 c\'f3 m\u7897\'3ft trong c\'e1c d\u7845\'3fu hi\u7879\'3f}{\f96\insrsid13725196\charrsid13725196 u sau \'f0\'e2y \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc coi l\'e0 h\'e0ng gi\u7843\'3f:
\par 1- H\'e0ng gi\u7843\'3f ch\u7845\'3f}{\f96\insrsid13725196\charrsid13725196 t l\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fng ho\u7863\'3fc c\'f4ng d\u7909\'3fng.
\par 1.1- H\'e0ng ho\'e1 kh\'f4ng c\'f3 gi\'e1 tr\u7883\'3f s\u7917\'3f d\u7909\'3fng ho\u7863\'3fc gi\'e1 tr\u7883\'3f s\u7917\'3f d\u7909\'3f}{\f96\insrsid13725196\charrsid13725196 ng kh\'f4ng \'f0\'fang nh\'fd b}{\f0\insrsid13725196\charrsid13725196 \u7843
\'3fn ch\u7845\'3ft t\u7921\'3f nhi\'ean, t\'ean g\u7885\'3fi v\'e0 c\'f4ng d\u7909\'3fng c\u7911\'3fa n\'f3.
\par }{\f96\insrsid13725196\charrsid13725196 1.2- H\'e0ng ho\'e1 \'f0\'fda th\'eam t}{\f0\insrsid13725196\charrsid13725196 \u7841\'3fp ch\u7845\'3ft, ch\u7845\'3ft ph\u7909\'3f gi}{\f96\insrsid13725196\charrsid13725196 a kh\'f4ng \'f0\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ph\'e9p s\u7917\'3f d\u7909\'3f}{\f96\insrsid13725196\charrsid13725196 ng l\'e0m thay \'f0}{\f0\insrsid13725196\charrsid13725196 \u7893\'3fi ch\u7845\'3f}{\f96\insrsid13725196\charrsid13725196 t l\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7907\'3fng; kh\'f4ng c\'f3 ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c c\'f3 \'edt d\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ch\u7845\'3ft, c\'f3 ch\u7913\'3f}{
\f96\insrsid13725196\charrsid13725196 a d\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ch\u7845\'3ft kh\'e1c v\u7899\'3f}{\f96\insrsid13725196\charrsid13725196 i t\'ean d\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ch\u7845\'3ft ghi tr
\'ean nh\'e3n ho\u7863\'3fc bao b\'ec; kh\'f4ng c\'f3 ho\u7863\'3f}{\f88\insrsid13725196\charrsid13725196 c kh\'f4ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7911\'3f ho\u7841\'3ft ch\u7845\'3ft, ch\u7845\'3ft h\u7919\'3fu hi\u7879\'3f}{
\f88\insrsid13725196\charrsid13725196 u kh\'f4ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7911\'3f g\'e2y n\'ean c\'f4ng d\u7909\'3fng ; c\'f3 ho\u7841\'3ft ch\u7845\'3ft, ch\u7845\'3ft h\u7919\'3fu hi\u7879\'3fu kh\'e1c v\u7899\'3fi t\'ean ho\u7841
\'3ft ch\u7845\'3ft, ch\u7845\'3ft h\u7919\'3fu hi\u7879\'3fu ghi tr\'ean bao b\'ec.
\par }{\f96\insrsid13725196\charrsid13725196 1.3- H\'e0ng ho\'e1 kh\'f4ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7911\'3f th\'e0nh ph\u7847\'3fn nguy\'ean li\u7879\'3fu ho\u7863\'3fc b\u7883\'3f thay th\u7871\'3f b\u7857\'3fng nh\u7919\'3fng nguy\'ean li
\u7879\'3fu, ph\u7909\'3f}{\f96\insrsid13725196\charrsid13725196  t\'f9ng kh\'e1c kh\'f4ng \'f0}{\f0\insrsid13725196\charrsid13725196 \u7843\'3fm b\u7843\'3fo ch\u7845\'3f}{\f96\insrsid13725196\charrsid13725196 t l\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7907\'3fng so v\u7899\'3fi ti\'eau chu\u7849\'3fn ch\u7845\'3f}{\f96\insrsid13725196\charrsid13725196 t l\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3f}{\f96\insrsid13725196\charrsid13725196 ng h\'e0ng ho\'e1 
\'f0}{\f0\insrsid13725196\charrsid13725196 \'e3 c\'f4ng b\u7889\'3f, g\'e2y h\u7853\'3fu qu\u7843\'3f x\u7845\'3f}{\f88\insrsid13725196\charrsid13725196 u \'f0}{\f0\insrsid13725196\charrsid13725196 \u7889\'3fi v\u7899\'3fi s\u7843\'3fn xu\u7845\'3ft, s
\u7913\'3fc kh\u7887\'3f}{\f96\insrsid13725196\charrsid13725196 e ng\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3f}{\f88\insrsid13725196\charrsid13725196 i, \'f0}{\f0\insrsid13725196\charrsid13725196 \u7897\'3fng v\u7853\'3ft, th\u7921\'3fc v\u7853
\'3ft ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c m\'f4i sinh, m\'f4i tr\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3fng.
\par 1.4- H\'e0ng ho\'e1 thu\u7897\'3fc danh m\u7909\'3fc Ti\'eau chu\u7849\'3fn b\u7855\'3ft bu\u7897\'3fc \'e1p d\u7909\'3fng m\'e0 kh\'f4ng th\u7921\'3fc hi\u7879\'3fn g\'e2y h\u7853\'3fu qu\u7843\'3f x\u7845\'3f}{\f88\insrsid13725196\charrsid13725196 u 
\'f0}{\f0\insrsid13725196\charrsid13725196 \u7889\'3fi v\u7899\'3fi s\u7843\'3fn xu\u7845\'3ft, s\u7913\'3fc kh\u7887\'3f}{\f96\insrsid13725196\charrsid13725196 e ng\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3f}{
\f88\insrsid13725196\charrsid13725196 i, \'f0}{\f0\insrsid13725196\charrsid13725196 \u7897\'3fng v\u7853\'3ft, th\u7921\'3fc v\u7853\'3ft  ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c m\'f4i sinh, m\'f4i tr\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7901\'3fng .
\par 1.5- H\'e0ng ho}{\f96\insrsid13725196\charrsid13725196 \'e1 ch\'fda \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ch\u7913\'3fng nh\u7853\'3fn ph\'f9 h\u7907\'3fp ti\'eau chu\u7849\'3fn m\'e0 s\u7917\'3f d\u7909\'3fng gi\u7845\'3fy ch\u7913
\'3fng nh\u7853\'3fn ho\u7863\'3fc d\u7845\'3fu ph\'f9 h\u7907\'3fp ti\'eau chu\u7849\'3f}{\f88\insrsid13725196\charrsid13725196 n (\'f0}{\f0\insrsid13725196\charrsid13725196 \u7889\'3fi v\u7899\'3fi danh m\u7909\'3fc h\'e0ng ho\'e1 b\u7855\'3ft bu\u7897
\'3fc).
\par 
\par 2- Gi\u7843\'3f v\u7873\'3f nh\'e3n hi\u7879\'3fu h\'e0ng ho\'e1, ki\u7875\'3fu d\'e1ng c\'f4ng nghi\u7879\'3fp, ngu\u7891\'3fn g\u7889\'3fc, xu\u7845\'3ft x\u7913\'3f h\'e0ng ho\'e1:
\par 2.1- H\'e0ng ho\'e1 c\'f3 nh\'e3n hi\u7879\'3fu h\'e0ng ho\'e1 tr\'f9ng ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c t\'fd\'f5ng t}{\f0\insrsid13725196\charrsid13725196 \u7921\'3f g\'e2y nh\u7847\'3fm l\u7851\'3fn v\u7899\'3fi nh\'e3n hi\u7879
\'3fu h\'e0ng ho\'e1 c\u7911\'3f}{\f96\insrsid13725196\charrsid13725196 a ng\'fd}{\f0\insrsid13725196\charrsid13725196 \u7901\'3f}{\f96\insrsid13725196\charrsid13725196 i kh\'e1c \'f0ang \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc b\u7843
\'3fo h\u7897\'3f cho c\'f9ng lo\u7841\'3fi h\'e0ng ho\'e1 k\u7875\'3f c\u7843\'3f nh\'e3n hi\u7879\'3f}{\f96\insrsid13725196\charrsid13725196 u h\'e0ng ho\'e1 \'f0ang \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc b\u7843\'3fo h\u7897\'3f}{
\f88\insrsid13725196\charrsid13725196  theo c\'e1c \'d0i}{\f0\insrsid13725196\charrsid13725196 \u7873\'3f}{\f96\insrsid13725196\charrsid13725196 u \'fd}{\f0\insrsid13725196\charrsid13725196 \u7899\'3fc qu\u7889\'3fc t\u7871\'3f m\'e0 Vi\u7879\'3f}{
\f96\insrsid13725196\charrsid13725196 t Nam tham gia, m\'e0 kh\'f4ng \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ph\'e9p c\u7911\'3fa ch\u7911\'3f nh\'e3n hi\u7879\'3fu.
\par 2.2- H\'e0ng ho\'e1 c\'f3 d\u7845\'3fu hi\u7879\'3fu ho\u7863\'3fc c\'f3 bao b\'ec mang d\u7845\'3fu hi\u7879\'3fu tr\'f9ng ho\u7863\'3f}{\f96\insrsid13725196\charrsid13725196 c t\'fd\'f5ng t}{\f0\insrsid13725196\charrsid13725196 \u7921\'3f g\'e2y nh
\u7847\'3fm l\u7851\'3fn v\u7899\'3f}{\f96\insrsid13725196\charrsid13725196 i t\'ean th\'fd\'f5ng m}{\f0\insrsid13725196\charrsid13725196 \u7841\'3f}{\f96\insrsid13725196\charrsid13725196 i \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc b
\u7843\'3fo h\u7897\'3f ho\u7863\'3fc v\u7899\'3fi t\'ean g\u7885\'3fi xu\u7845\'3ft x\u7913\'3f}{\f96\insrsid13725196\charrsid13725196  h\'e0ng ho\'e1 \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc b\u7843\'3fo h\u7897\'3f.
\par 2.3- H\'e0ng ho\'e1, b\u7897\'3f ph\u7853\'3fn c\u7911\'3fa h\'e0ng ho\'e1 c\'f3 h\'ecnh d\'e1ng b\'ean ngo\'e0i tr\'f9ng v\u7899\'3fi ki\u7875\'3fu d\'e1ng c\'f4ng nghi\u7879\'3f}{\f96\insrsid13725196\charrsid13725196 p \'f0ang \'f0\'fd}{
\f0\insrsid13725196\charrsid13725196 \u7907\'3fc b\u7843\'3fo h\u7897\'3f m}{\f96\insrsid13725196\charrsid13725196 \'e0 kh\'f4ng \'f0\'fd}{\f0\insrsid13725196\charrsid13725196 \u7907\'3fc ph\'e9p c\u7911\'3fa ch\u7911\'3f ki\u7875\'3fu d\'e1ng c\'f4
ng nghi\u7879\'3fp.
\par 2.4- H\'e0ng ho\'e1 c\'f3 d\u7845\'3fu hi\u7879\'3fu gi\u7843\'3f m\u7841\'3fo v\u7873\'3f ch\u7881\'3f d\u7851\'3fn ngu\u7891\'3fn g\u7889\'3fc, xu\u7845\'3ft x\u7913\'3f h\'e0ng ho\'e1 g\'e2y hi\u7875\'3fu sai l\u7879\'3fch v\u7873\'3f ngu\u7891\'3fn g
