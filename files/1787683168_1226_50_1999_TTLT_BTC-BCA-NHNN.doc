\par 3. Nhi\u7879\'3fm v\u7909\'3f c\u7911\'3fa c\'e1c th\'e0nh vi\'ean H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t:
\par - Ch\u7883\'3fu s\u7921\'3f ch\u7881\'3f }{\f242\insrsid2831636\charrsid2831636 \'f0}{\f0\insrsid2831636\charrsid2831636 \u7841\'3fo tr\u7921\'3fc ti\u7871\'3fp c\u7911\'3fa Ch\u7911\'3f t\u7883\'3fch H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i 
\'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t
\par - N\u7855\'3fm v\u7919\'3f}{\f242\insrsid2831636\charrsid2831636 ng c\'e1c quy \'f0}{\f0\insrsid2831636\charrsid2831636 \u7883\'3fnh c\u7911\'3f}{\f250\insrsid2831636\charrsid2831636 a Nh\'e0 n\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc v\u7873
\'3f ti\'eau hu\u7927\'3f ti\u7873\'3fn
\par - Th\u7921\'3fc hi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 n v\'e0 ho\'e0n th\'e0nh \'f0}{\f0\insrsid2831636\charrsid2831636 \u7847\'3f}{\f242\insrsid2831636\charrsid2831636 y \'f0}{\f0\insrsid2831636\charrsid2831636 \u7911\'3f nhi\u7879\'3fm v
\u7909\'3f do Ch\u7911\'3f t\u7883\'3fch H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t giao cho, ch\u7883\'3fu tr\'e1ch nhi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 m tr\'fd
}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc Ch\u7911\'3f t\u7883\'3fch H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t v\u7873\'3f m\u7885\'3fi c\'f4ng vi\u7879\'3f}{
\f250\insrsid2831636\charrsid2831636 c \'f0\'fd}{\f0\insrsid2831636\charrsid2831636 \u7907\'3fc giao.
\par }{\f250\insrsid2831636\charrsid2831636 - Trong tr\'fd}{\f0\insrsid2831636\charrsid2831636 \u7901\'3fng h\u7907\'3fp  ph\'e1t hi\u7879\'3fn nh\u7919\'3fng h\'e0nh vi vi ph\u7841\'3f}{\f242\insrsid2831636\charrsid2831636 m quy \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7883\'3fnh v\u7873\'3f ti\'eau hu\u7927\'3f ti\u7873\'3fn c\'f3 th\u7875\'3f g\'e2y ra s\u7921\'3f m\u7845\'3ft an to\'e0n v\u7873\'3f t\'e0i s\u7843\'3f}{\f250\insrsid2831636\charrsid2831636 n nh\'fd h\'e0nh vi tham 
\'f4, l}{\f0\insrsid2831636\charrsid2831636 \u7845\'3fy c\u7855\'3fp ti\u7873\'3fn... trong ti\'eau hu\u7927\'3f ti\u7873\'3fn th\'ec ph\u7843\'3fi c\'f3 nh\u7919\'3fng bi\u7879\'3fn ph\'e1p x\u7917\'3f l\'fd t\u7841\'3fm th\u7901\'3fi nh\u7857\'3fm h
\u7841\'3fn ch\u7871\'3f t\u7893\'3fn th\u7845\'3ft t\'e0i s\u7843\'3f}{\f250\insrsid2831636\charrsid2831636 n Nh\'e0 n\'fd}{\f0\insrsid2831636\charrsid2831636 \'f3c v\'e0 th\'f4ng b\'e1o cho H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7891\'3fng ti\'eau hu\u7927\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0}{\f0\insrsid2831636\charrsid2831636 \u7875\'3f l\u7853\'3fp bi\'ean b\u7843\'3fn ngay t\u7841\'3fi ch\u7895\'3f}{
\f242\insrsid2831636\charrsid2831636 , \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng th\u7901\'3fi, b\'e1o c\'e1o k\u7883\'3fp th\u7901\'3fi to\'e0n b\u7897\'3f s\u7921\'3f vi\u7879\'3fc x\u7843\'3fy ra cho Ch\u7911\'3f t\u7883\'3fch H\u7897\'3f}{
\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t. N\u7871\'3fu vi ph\u7841\'3fm nghi\'eam tr\u7885\'3fng th\'ec chuy\u7875\'3fn h\u7891\'3f}{\f250\insrsid2831636\charrsid2831636  s\'f5 \'f0}{
