\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid2831636\charrsid2831636 1. Nhi\u7879\'3fm v\u7909\'3f c\u7911\'3fa H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891
\'3fng gi\'e1m s\'e1t:
\par - Gi\'e1m s\'e1t v\'e0 ki\u7875\'3fm so\'e1t qu\'e1 tr\'ecnh ti\'eau hu\u7927\'3f ti\u7873\'3fn c\u7911\'3f}{\f250\insrsid2831636\charrsid2831636 a Ng\'e2n h\'e0ng Nh\'e0 n\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc.
\par }{\f242\insrsid2831636\charrsid2831636 - Th\'f4ng qua gi\'e1m s\'e1t \'f0}{\f0\insrsid2831636\charrsid2831636 \u7873\'3f xu\u7845\'3ft ki\u7871\'3fn ngh\u7883\'3f v\u7899\'3f}{\f250\insrsid2831636\charrsid2831636 i Ng\'e2n h\'e0ng Nh\'e0 n\'fd}{
\f0\insrsid2831636\charrsid2831636 \u7899\'3fc nh\u7919\'3fng v\u7845\'3f}{\f242\insrsid2831636\charrsid2831636 n \'f0}{\f0\insrsid2831636\charrsid2831636 \u7873\'3f c\u7847\'3fn thi\u7871\'3f}{\f250\insrsid2831636\charrsid2831636 t li\'ean quan \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7871\'3fn ti\'eau hu\u7927\'3f ti\u7873\'3f}{\f242\insrsid2831636\charrsid2831636 n \'f0}{\f0\insrsid2831636\charrsid2831636 \u7875\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0}{\f0\insrsid2831636\charrsid2831636 
\u7843\'3fm b\u7843\'3fo an to\'e0n tuy\u7879\'3f}{\f242\insrsid2831636\charrsid2831636 t \'f0}{\f0\insrsid2831636\charrsid2831636 \u7889\'3fi trong qu\'e1 tr\'ecnh ti\'eau hu\u7927\'3f ti\u7873\'3fn.
\par T\u7893\'3fng h\u7907\'3fp b\'e1o c\'e1o Li\'ean B\u7897\'3f k\u7871\'3ft qu\u7843\'3f gi\'e1m s\'e1t ti\'eau hu\u7927\'3f ti\u7873\'3fn.
\par 2. Nhi\u7879\'3fm v\u7909\'3f, quy\u7873\'3fn h\u7841\'3fn c\u7911\'3fa Ch\u7911\'3f t\u7883\'3fch H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t:
\par - Ch\u7881\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0}{\f0\insrsid2831636\charrsid2831636 \u7841\'3fo chung to\'e0n b\u7897\'3f c\'f4ng vi\u7879\'3fc gi\'e1m s\'e1t ti\'eau hu\u7927\'3f ti\u7873\'3fn c\u7911\'3fa H\u7897\'3f}{
\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t.
\par - Ph\'e2n c\'f4ng tr\'e1ch nhi\u7879\'3fm ho\u7863\'3fc u\u7927\'3f quy\u7873\'3f}{\f242\insrsid2831636\charrsid2831636 n \'f0}{\f0\insrsid2831636\charrsid2831636 \u7875\'3f c\'e1c th\'e0nh vi\'ean trong H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 
i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng tr\u7921\'3fc ti\u7871\'3fp ph\u7909\'3f tr\'e1ch c\'f4ng t\'e1c gi\'e1m s\'e1t \u7903\'3f}{\f242\insrsid2831636\charrsid2831636  c\'e1c \'f0i}{\f0\insrsid2831636\charrsid2831636 \u7875\'3fm ti\'ea
u hu\u7927\'3f ti\u7873\'3fn.
\par - Ch\u7883\'3fu tr\'e1ch nhi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 m tr\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc Li\'ean B\u7897\'3f}{\f250\insrsid2831636\charrsid2831636  v\'e0 tr\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3f
c ph\'e1p lu\u7853\'3ft v\u7873\'3f qu\'e1 tr\'ecnh gi\'e1m s\'e1t ti\'eau hu\u7927\'3f ti\u7873\'3fn.
\par - C\'f3 quy\u7873\'3fn y\'eau c\u7847\'3fu H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng ti\'eau hu\u7927\'3f ng\u7915\'3fng nh\u7919\'3fng vi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 c l
\'e0m kh\'f4ng \'f0\'fang qu}{\f242\insrsid2831636\charrsid2831636 y \'f0}{\f0\insrsid2831636\charrsid2831636 \u7883\'3fnh v\u7873\'3f ti\'eau hu\u7927\'3f ti\u7873\'3f}{\f242\insrsid2831636\charrsid2831636 n, kh\'f4ng \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7843\'3fm b\u7843\'3fo an to\'e0n v\u7873\'3f t\'e0i s\u7843\'3fn ho\u7863\'3fc ki\u7871\'3fn ngh\u7883\'3f Th\u7889\'3f}{\f242\insrsid2831636\charrsid2831636 ng \'f0}{\f0\insrsid2831636\charrsid2831636 \u7889\'3f}{
\f250\insrsid2831636\charrsid2831636 c Ng\'e2n h\'e0ng Nh\'e0 n\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3f}{\f242\insrsid2831636\charrsid2831636 c \'f0}{\f0\insrsid2831636\charrsid2831636 \'ecnh ch\u7881\'3f}{\f242\insrsid2831636\charrsid2831636  
\'f0}{\f0\insrsid2831636\charrsid2831636 \u7907\'3ft ti\'eau hu\u7927\'3f ti\u7873\'3f}{\f250\insrsid2831636\charrsid2831636 n trong tr\'fd}{\f0\insrsid2831636\charrsid2831636 \u7901\'3fng h\u7907\'3fp c\'f3 vi ph\u7841\'3fm nghi\'eam tr\u7885\'3fng.

\par }{\f242\insrsid2831636\charrsid2831636 - \'d0}{\f0\insrsid2831636\charrsid2831636 \'ecnh ch\u7881\'3f}{\f242\insrsid2831636\charrsid2831636  c\'f4ng t\'e1c \'f0}{\f0\insrsid2831636\charrsid2831636 \u7889\'3fi v\u7899\'3fi c\'e1c c\'e1 nh\'e2n c\'f3 h\'e0
