\'3f l\'fd tr}{\f250\insrsid2831636\charrsid2831636 \'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc ph\'e1p lu\u7853\'3ft.
\par 4. Nhi\u7879\'3fm v\u7909\'3f c\u7911\'3fa t\u7893\'3f chuy\'ean vi\'ean gi\'fap vi\u7879\'3fc.
\par - Tr\u7921\'3fc ti\u7871\'3fp gi\'e1m s\'e1t c\'e1c kh\'e2u c\u7911\'3fa qu\'e1 tr\'ecnh ti\'eau hu\u7927\'3f ti\u7873\'3fn theo s\u7921\'3f ph\'e2n c\'f4ng v\'e0 ch\u7881\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7841\'3fo c\u7911\'3fa H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t. Ghi ch\'e9p, theo d\'f5i di\u7877\'3fn bi\u7871\'3fn h\'e0ng ng\'e0y c
\u7911\'3fa c\'f4ng t\'e1c ti\'eau hu\u7927\'3f ti\u7873\'3fn. H\'e0ng tu\u7847\'3fn, b\'e1o c\'e1o k\u7871\'3ft qu\u7843\'3f ti\'eau hu\u7927\'3f ti\u7873\'3fn trong tu\u7847\'3fn cho H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{
\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t.
\par - Ph\'e1t hi\u7879\'3fn v\'e0 b\'e1o c\'e1o  v\u7899\'3fi H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t nh\u7919\'3fng h\'e0nh vi vi ph\u7841\'3f}{
\f242\insrsid2831636\charrsid2831636 m quy \'f0}{\f0\insrsid2831636\charrsid2831636 \u7883\'3fnh v\u7873\'3f ti\'eau hu\u7927\'3f ti\u7873\'3f}{\f242\insrsid2831636\charrsid2831636 n \'f0}{\f0\insrsid2831636\charrsid2831636 \u7875\'3f H\u7897\'3f}{
\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng c\'f3 nh\u7919\'3fng quy\u7871\'3f}{\f242\insrsid2831636\charrsid2831636 t \'f0}{\f0\insrsid2831636\charrsid2831636 \u7883\'3fnh ch\u7845\'3fn ch\u7881\'3fnh k
\u7883\'3fp th\u7901\'3fi.
\par - Ch\u7883\'3fu tr\'e1ch nhi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 m tr\'fd}{\f0\insrsid2831636\charrsid2831636 \u7899\'3fc H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1
t v\u7873\'3f c\'e1c c\'f4ng vi\u7879\'3f}{\f250\insrsid2831636\charrsid2831636 c \'f0\'fd}{\f0\insrsid2831636\charrsid2831636 \u7907\'3fc giao.
\par 5. Ch\u7871\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0}{\f0\insrsid2831636\charrsid2831636 \u7897\'3f l\'e0m vi\u7879\'3fc c\u7911\'3fa H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1
m s\'e1t: H\'e0ng tu\u7847\'3fn H\u7897\'3f}{\f242\insrsid2831636\charrsid2831636 i \'f0}{\f0\insrsid2831636\charrsid2831636 \u7891\'3fng gi\'e1m s\'e1t h\u7885\'3f}{\f242\insrsid2831636\charrsid2831636 p \'f0}{\f0\insrsid2831636\charrsid2831636 \u7875
\'3f}{\f242\insrsid2831636\charrsid2831636  \'f0\'e1nh gi\'e1 c\'f4ng t\'e1c gi\'e1m s\'e1t, r\'fat kinh nghi}{\f0\insrsid2831636\charrsid2831636 \u7879\'3fm v\'e0 th\u7889\'3fng nh\u7845\'3ft k\u7871\'3f ho\u7841\'3fch c\u7911\'3fa tu\u7847\'3fn ti\u7871
\'3fp theo.
\par 
