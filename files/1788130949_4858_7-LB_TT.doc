\par 1. Ph\'e2n lo\u7841\'3fi nh\'e0:
\par V\u7873\'3f nguy\'ean t\u7855\'3fc, khi ph\'e2n lo\u7841\'3fi nh\'e0 }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 \u7875\'3f x\'e1c }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 \u7883
\'3fnh gi\'e1 t\'ednh thu\u7871\'3f l\'e0 d\u7921\'3fa v\'e0o ch\u7845\'3ft l}{\f217\insrsid4799384\charrsid4799384 \'fd\u7907\'3f}{\f0\insrsid4799384\charrsid4799384 ng c\'e1c b\u7897\'3f ph\u7853\'3fn k\u7871\'3ft c\u7845\'3fu ch\u7911\'3f y\u7871\'3f
u v\'e0 gi\'e1 tr\u7883\'3f s\u7917\'3f d\u7909\'3fng c\u7911\'3fa t\u7915\'3fng ng\'f4i nh\'e0. Nh\'e0 }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f217\insrsid4799384\charrsid4799384 \'fd\u7907\'3f}{\f0\insrsid4799384\charrsid4799384 c ph\'e2n th\'e0
nh 6 lo\u7841\'3fi: bi\u7879\'3ft th\u7921\'3f, c\u7845\'3fp I, c\u7845\'3fp II, c\u7845\'3fp III, c\u7845\'3fp IV v\'e0 nh\'e0 t\u7841\'3fm theo c\'e1c ti\'eau chu\u7849\'3fn sau }{\f209\insrsid4799384\charrsid4799384 \'f0}{
\f0\insrsid4799384\charrsid4799384 \'e2y:
\par a) Bi\u7879\'3ft th\u7921\'3f:
\par a.1 - Ng\'f4i nh\'e0 ri\'eang bi\u7879\'3ft, c\'f3 s\'e2n v}{\f217\insrsid4799384\charrsid4799384 \'fd\u7901\'3f}{\f0\insrsid4799384\charrsid4799384 n, h\'e0ng r\'e0o bao quanh;
\par a.2 - K\u7871\'3ft c\u7845\'3fu ch\u7883\'3fu l\u7921\'3fc khung, s\'e0n, t}{\f217\insrsid4799384\charrsid4799384 \'fd\u7901\'3f}{\f0\insrsid4799384\charrsid4799384 ng b\u7857\'3fng b\'ea t\'f4ng c\u7889\'3ft th\'e9p ho\u7863\'3fc t}{
\f217\insrsid4799384\charrsid4799384 \'fd\u7901\'3f}{\f0\insrsid4799384\charrsid4799384 ng g\u7841\'3fch;
\par a.3 - Bao che nh\'e0 v\'e0 t}{\f217\insrsid4799384\charrsid4799384 \'fd\u7901\'3f}{\f0\insrsid4799384\charrsid4799384 ng ng}{\f209\insrsid4799384\charrsid4799384 \'e3}{\f0\insrsid4799384\charrsid4799384 n c\'e1ch c\'e1c ph\'f2ng b\u7857\'3fng b\'ea t\'f4
ng c\u7889\'3ft th\'e9p ho\u7863\'3fc x\'e2y g\u7841\'3fch;
\par a.4 - M\'e1i b\u7857\'3fng ho\u7863\'3fc m\'e1i ng\'f3i, c\'f3 h\u7879\'3f th\u7889\'3fng c\'e1ch \'e2m v\'e0 c\'e1ch nhi\u7879\'3ft t\u7889\'3ft;
\par a.5 - V\u7853\'3ft li\u7879\'3fu ho\'e0n thi\u7879\'3fn (tr\'e1t, l\'e1t, \u7889\'3fp) trong v\'e0 ngo\'e0i nh\'e0 t\u7889\'3ft;
\par a.6 - Ti\u7879\'3fn nghi sinh ho\u7841\'3ft (b\u7871\'3fp, x\'ed, t\u7855\'3fm, }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 i\u7879\'3fn n}{\f217\insrsid4799384\charrsid4799384 \'fd\u7899\'3f}{
\f0\insrsid4799384\charrsid4799384 c) }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 \u7847\'3fy }{\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 \u7911\'3f ti\u7879\'3fn d\'f9ng, ch\u7845
\'3ft l}{\f217\insrsid4799384\charrsid4799384 \'fd\u7907\'3f}{\f0\insrsid4799384\charrsid4799384 ng t\u7889\'3ft;
\par a.7 - S\u7889\'3f t\u7847\'3fng kh\'f4ng h\u7841\'3fn ch\u7871\'3f, nh}{\f217\insrsid4799384\charrsid4799384 \'fd}{\f0\insrsid4799384\charrsid4799384 ng m\u7895\'3fi t\u7847\'3fng ph\u7843\'3fi c\'f3 \'edt nh\u7845\'3ft 2 ph\'f2ng }{
\f209\insrsid4799384\charrsid4799384 \'f0}{\f0\insrsid4799384\charrsid4799384 \u7875\'3f \u7903\'3f.
