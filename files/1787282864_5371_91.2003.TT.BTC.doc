\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid8071873 {\rtlch\fcs1 \af309 \ltrch\fcs0 \f309\insrsid6647364\charrsid15875786 C\'e1c n\u7897\'3fi dung kh\'e1c t
