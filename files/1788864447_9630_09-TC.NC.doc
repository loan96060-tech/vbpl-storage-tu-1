\par + V\u7889\'3fn c\u7911\'3fa ng\'e2n s\'e1ch c\u7845\'3fp:
\par 42 tr x 100
\par 120 tr =35%
\par + V\u7889\'3fn vay ng\'e2n h\'e0ng:
\par 60 tr x 100
\par 120 tr = 50%
\par + V\u7889\'3fn chi\u7871\'3fm d\u7909\'3fng c\u7911\'3fa Ng\'e2n s\'e1ch v\'e0 kh\'e1ch h\'e0ng:
\par 12 tr x 100
\par 120 tr = 10%
\par + V\u7889\'3f}{\f38\fs28\cgrid0\insrsid2565583\charrsid5253561 n \'f0}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \'e3 tr\'edch t\u7915\'3f qu\u7929\'3f khuy\u7871\'3fn kh\'edch ph\'e1t tri\u7875\'3fn s\u7843\'3fn xu\u7845\'3f}{
\f38\fs28\cgrid0\insrsid2565583\charrsid5253561 t \'f0}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7875\'3f b\u7893\'3f sung v\u7889\'3f}{\f46\fs28\cgrid0\insrsid2565583\charrsid5253561 n l\'fdu \'f0}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 
\u7897\'3fng v\'e0 c\'e1c ngu\u7891\'3fn v\u7889\'3f}{\f46\fs28\cgrid0\insrsid2565583\charrsid5253561 n l\'fdu \'f0}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7897\'3fng c\'f2n l\u7841\'3fi kh\'e1c:
\par 6 tr x 100
\par 120 tr = 5%
\par - S\u7889\'3f ch\'eanh l\u7879\'3fch gi\'e1:
\par }{\f38\fs28\cgrid0\insrsid2565583\charrsid5253561 + Ghi t\'e3ng v}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7889\'3fn ng\'e2n s\'e1ch (bao g\u7891\'3fm 1/2 s\u7889\'3f ch\'eanh l\u7879\'3fch gi\'e1 thu\u7897\'3fc ph\u7847\'3fn v\u7889\'3fn chi
\u7871\'3fm d\u7909\'3fng c\u7911\'3fa ng\'e2n s\'e1ch v\'e0 kh\'e1ch h\'e0ng):
\par  
\par (39% x 30tr) + ( 10% x 30tr) = 19,5 tr + 1,5tr = 12 tr.
\par  2
\par }{\f38\fs28\cgrid0\insrsid2565583\charrsid5253561  + Ghi t\'e3ng v}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7889\'3fn vay Ng\'e2n h\'e0ng (bao g\u7891\'3fm 1/2 s\u7889\'3f ch\'eanh l\u7879\'3fch gi\'e1 thu\u7897\'3fc ph\u7847\'3fn v\u7889\'3f
n chi\u7871\'3fm d\u7909\'3fng c\u7911\'3fa ng\'e2n s\'e1ch v\'e0 ng\'e2n h\'e0ng):
\par  (50% x 30tr) + (10% x 30tr)
\par  2 = 15tr + 1,5tr = 16,5tr.
\par }{\f38\fs28\cgrid0\insrsid2565583\charrsid5253561  + Ghi tr\'e3ng v}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7889\'3fn tr\'edch t\u7915\'3f qu\u7929\'3f khuy\u7871\'3fn kh\'edch ph\'e1t tri\u7875\'3fn s\u7843\'3fn xu\u7845\'3f}{
