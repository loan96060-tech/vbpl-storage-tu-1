\par  5% x 30tr = 1,5 tr
\par  Vi\u7879\'3f}{\f38\fs28\cgrid0\insrsid2565583\charrsid5253561 c ghi t\'e3ng v}{\f0\fs28\cgrid0\insrsid2565583\charrsid5253561 \u7889\'3fn c\u7911\'3fa ng\'e2n s\'e1ch, Ng\'e2n h\'e0ng v\u7873\'3f ph\u7847\'3fn v\u7853\'3f}{
