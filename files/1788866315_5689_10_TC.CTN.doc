\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid2306847 {\f47\fs28\cgrid0\insrsid867582\charrsid5003811 Khi x\'e9t m\u7897\'3ft s
\u7889\'3f c\'f5 s\u7903\'3f n\'e0o l\'e0 c\'f3 quan h\u7879\'3f kinh t\u7871\'3f v\u7899\'3fi Nh\'e0 n\'fd\u7899\'3fc, ph\u7843\'3fi d\u7921\'3fa v\'e0o nh\u7919\'3fng c\'e3n c\u7913\'3f sau \'f0\'e2y:
\par - \'d0\'fd\u7907\'3fc Nh\'e0 n\'fd\u7899\'3fc giao nguy\'ean li\u7879\'3fu l\'e0m gia c\'f4ng ho\u7863\'3fc b\'e1n nguy\'ean li\u7879\'3fu (to\'e0n b\u7897\'3f nguy\'ean li\u7879\'3fu ho\u7863\'3fc ch\u7881\'3f nh\u7919\'3fng nguy\'ean li\u7879\'3fu ch
\u7911\'3f y\u7871\'3fu) thu mua th\'e0nh ph\u7849\'3fm; l\'e0m \'f0\u7841\'3fi l}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd b\'e1n h\'e0ng ho\u7863\'3fc u\u7927\'3f th\'e1c thu mua h\'e0ng cho Nh\'e0 n}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd\u7899\'3fc , h\'fd\u7903\'3fng hoa h\u7891\'3fng.
\par - C\'f3 h\u7907\'3fp \'f0\u7891\'3fng \'f0\'fd\u7907\'3fc k}{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd k\u7871\'3ft theo \'f0\'fang nguy}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'ean t\u7855\'3fc Nh\'e0 n\'fd\u7899\'3fc quy \'f0\u7883
\'3fnh v\u7873\'3f qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd nguy\'ean li\u7879\'3fu, gi\'e1 c\u7843\'3f, c\'f4ng th\u7913\'3fc s\u7843\'3fn xu\u7845\'3ft , ph\u7849\'3fm ch\u7845\'3ft, quy c\'e1ch h\'e0ng ho\'e1...
\par 9/ C\'e1c h\u7907\'3fp t\'e1c x\'e3 n\'f4ng nghi\u7879\'3fp, ngh\u7873\'3f c\'e1, ngh\u7873\'3f mu\u7889\'3fi ki\'eam s\u7843\'3fn xu\u7845\'3ft ti\u7875\'3fu, th\u7911\'3f c\'f4ng nghi\u7879\'3fp, ki\'eam v\u7853\'3fn t\u7843\'3fi, ki\'eam x\'e2y d\u7921
\'3fng ho\u7863\'3fc ki\'eam kinh doanh n\'f4ng nghi\u7879\'3fp kh\'f4ng thu\u7897\'3fc di\u7879\'3fn n\u7897\'3fp thu\u7871\'3f n\'f4ng nghi\u7879\'3fp, t\u7915\'3f nay n\u7897\'3fp thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp  theo thu
\u7871\'3f su\u7845\'3ft th\u7845\'3fp nh\u7845\'3ft ghi trong bi\u7875\'3fu thu\u7871\'3f m\u7899\'3fi: 12%.
\par }{\b\f0\fs28\cgrid0\insrsid867582\charrsid6053321 IV. Th\u7871\'3f bu\'f4n chuy\u7871\'3fn:
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 1/ Trong vi\u7879\'3fc thu thu\u7871\'3f bu\'f4n chuy\u7871\'3fn, c\u7847\'3fn c\'f3 bi\u7879\'3fn ph\'e1p qu\u7843\'3fn l\'fd }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 ch\u7863\'3ft ch\u7869\'3f t
\u7841\'3fi g\u7889\'3fc v\'e0 tr\'ean \'f0\'fd\u7901\'3fng v\u7853\'3fn chuy\u7875\'3fn. \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f bu\'f4n chuy\u7871\'3fn l\u7899\'3fn, ph\u7843\'3fi c\'f3 bi\u7879\'3fn ph\'e1p ch\u7889\'3fng th\u7911
\'3f \'f0o\u7841\'3fn ph\'e2n t\'e1n h\'e0ng ho\'e1 \'f0\u7875\'3f h\u7841\'3f th\u7845\'3fp thu\u7871\'3f su\u7845\'3ft. \'d0\u7889\'3fi v\u7899\'3fi  nh\u7919\'3fng c\'f5 s\u7903\'3f bu\'f4n chuy\u7871\'3fn mang t\'ednh ch\u7845\'3ft th\'fd\u7901\'3f
ng xuy\'ean ho\u7863\'3fc bu\'f4n chuy\u7871\'3fn t\u7915\'3fng k\u7923\'3f h\u7841\'3fn v\u7899\'3fi nh\u7919\'3fng chu}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 y\u7871\'3fn h\'e0ng l\u7899\'3fn th\'ec ph\u7843\'3fi chuy\u7875\'3fn sang ph}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd\'f5ng th\u7913\'3fc thu thu\u7871\'3f doanh nghi\u7879\'3fp v\'e0 thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp .
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 2/ H\u7907\'3fp t\'e1c x\'e3 mua b\'e1n, h\u7907\'3fp t\'e1c x\'e3 ti\'eau th\u7909\'3f ph\u7843\'3fi l\u7845\'3fy x\'e3 vi\'ean v\'e0 nh\'e2n d\'e2n trong }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 
\'f0\u7883\'3fa ph\'fd\'f5ng l\'e0m \'f0\u7889\'3fi t\'fd\u7907\'3fng ph\u7909\'3fc v\u7909\'3f ch\'ednh. H\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3  }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0i c\u7845\'3ft h\'e0
ng (\'f0\'fd\u7907\'3fc c\'f5 quan th\'fd\'f5ng nghi\u7879\'3fp c\'f3 th\u7849\'3fm quy\u7873\'3fn cho ph\'e9p) v\u7873\'3f b\'e1n cho nh\'e2n d\'e2n trong \'f0\u7883\'3fa ph\'fd\'f5ng th}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ec kh\'f4ng coi l
\'e0 bu\'f4n chuy\u7871\'3fn v\'e0 kh\'f4ng ph\u7843\'3fi n\u7897\'3fp thu\u7871\'3f bu\'f4n chuy\u7871\'3fn. Nh}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fdng n\u7871\'3fu bu\'f4n b\'e1n mang t\'ednh ch\u7845\'3ft bu\'f4n chuy\u7871\'3fn \'f0
\u7875\'3f ki\u7871\'3fm l\u7901\'3fi (kh\'f4ng b\'e1n cho nh\'e2n d\'e2n trong \'f0\u7883\'3fa ph\'fd\'f5ng) th}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ec ph\u7843\'3fi n\u7897\'3fp thu\u7871\'3f bu\'f4n chuy\u7871\'3fn.
\par }{\b\f0\fs28\cgrid0\insrsid867582\charrsid6053321 V. Thu\u7871\'3f h\'e0ng ho\'e1:
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 1/ Bi\u7875\'3fu thu\u7871\'3f h\'e0ng ho\'e1 \'f0}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3 }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\'fd\u7907\'3fc H\u7897\'3fi \'f0\u7891\'3fng Nh
\'e0 n\'fd\u7899\'3fc ban h\'e0nh ph\u7843\'3fi \'f0\'fd\u7907\'3fc thi h\'e0nh th\u7889\'3fng nh\u7845\'3ft trong c\u7843\'3f n\'fd\u7899\'3fc.
\par Trong bi\u7875\'3fu thu\u7871\'3f h\'e0ng ho\'e1 m\u7899\'3fi ban h\'e0nh, c\'f3 4 m\u7863\'3ft h\'e0ng m\u7899\'3fi b\u7893\'3f sung. \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng m\u7863\'3ft h\'e0ng n\'e0y v\'e0 nh\u7919\'3fng m\u7863\'3ft h\'e0ng kh\'e1
c ph\u7843\'3fi c}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 h\u7883\'3fu thu\u7871\'3f h\'e0ng ho\'e1, ph\u7843\'3fi ki\u7875\'3fm k\'ea h\'e0ng t\u7891\'3fn kho v\'e0 thu thu\u7871\'3f theo bi\u7875\'3fu thu\u7871\'3f m\u7899\'3fi.
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 2/ \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng h\'e0ng ho\'e1 xu\u7845\'3ft nh\u7853\'3fp kh\u7849\'3fu phi m\u7853\'3fu d\u7883\'3fch v\'fd\u7907\'3ft qu\'e1 ti\'eau chu\u7849\'3fn \'f0\'fd\u7907\'3fc mi
\u7877\'3fn thu\u7871\'3f c\u361\'3fng ph\u7843\'3fi ti\u7871\'3fn h\'e0nh ki\u7875\'3fm k\'ea \'f0\u7875\'3f thu thu\u7871\'3f theo bi\u7875\'3fu thu\u7871\'3f v\'e0 gi\'e1 t\'ednh thu\u7871\'3f m\u7899\'3fi.
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 Li\'ean B\u7897\'3f T\'e0i c}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 h\'ednh - Ngo\u7841\'3fi th\'fd\'f5ng \'f0}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3 ra th\'f4ng t}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd  Li\'ean B\u7897\'3f s\u7889\'3f 09 - TTLB/TC-BNgT ng\'e0y 25/3/1983 h\'fd\u7899\'3fng d\u7851\'3fn c\u7909\'3f th\u7875\'3f vi\u7879\'3fc thu thu\u7871\'3f \'f0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng h
\'e0ng n\'e0y.
\par \'d0\u7875\'3f thi h\'e0nh nghi\'eam ch\u7881\'3fnh Ph\'e1p l\u7865\'3fnh c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng Nh\'e0 n\'fd\u7899\'3fc  v\u7873\'3f thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp,UBND t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0
\u7863\'3fc khu tr\u7921\'3fc thu\u7897\'3fc TW v\'e0 C\u7909\'3fc thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp c\u7847\'3fn t\'e3ng c\'fd\u7901\'3fng h\'f5n n\u7919\'3fa s\u7921\'3f ch\u7881\'3f \'f0\u7841\'3fo v\'e0 ki\u7875\'3fm tra c\'f4ng t\'e1
c thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp, \'f0\u7863\'3fc bi\u7879\'3ft l\'e0 trong b\'fd\u7899\'3fc tri\u7875\'3fn khai vi\u7879\'3fc thi h\'e0nh Ph\'e1p l\u7879\'3fnh.
\par }{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 C\u7847\'3fn ch\'fa \'fd nh\u7919\'3fng kh\'e2u c\'f4ng t\'e1c l\u7899\'3fn sau \'f0\'e2y:
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 1/ T\u7893\'3f ch\u7913\'3fc vi\u7879\'3fc tuy\'ean truy\u7873\'3fn ph\u7893\'3f bi}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \u7871\'3fn ch\'ednh s\'e1ch v\'e0 ph\'e1p lu\u7853\'3ft v\u7873\'3f thu
\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp  r\u7897\'3fng r}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3i trong c\'e1c ng\'e0nh, c\'e1c c\u7845\'3fp, c\'e1c }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0o\'e0n th\u7875\'3f trong m\u7863
\'3ft tr\u7853\'3fn v\'e0 c\'e1c t\u7847\'3fng l\u7899\'3fp nh\'e2n d\'e2n, n\'e2ng cao }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd th\u7913\'3fc t\u7921\'3f gi\'e1c l\'e0m ngh\u297\'69a v\u7909\'3f }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\'f3ng thu\u7871\'3f cho Nh\'e0 n\'fd\u7899\'3fc , t\u7841\'3fo ra m\u7897\'3ft phong tr\'e0o qu\u7847\'3fn ch\'fang \u7911\'3fng h\u7897\'3f ch\'ednh s\'e1ch thu\u7871\'3f; t\'edch c\u7921\'3fc \'f0
\u7845\'3fu tranh ch\u7889\'3fng tr\u7889\'3fn thu\u7871\'3f, l\u7853\'3fu thu\u7871\'3f, \'f0\u7847\'3fu c\'f5, n\'e2ng gi\'e1.
\par 2/L\'e0m t\u7889\'3ft m\u7897\'3ft s\u7889\'3f c\u7897\'3fng t\'e1c c\u7847\'3fn thi\u7871\'3ft \'f0\u7875\'3f tri\u7875\'3fn khai vi\u7879\'3fc thi h\'e0nh Ph\'e1p l\u7879\'3fnh: k\u7883\'3fp th\u7901\'3fi ban h\'e0nh c\'e1c quy \'f0\u7883\'3fnh chi ti
\u7871\'3ft thu\u7897\'3fc th\u7849\'3fm quy\u7873\'3fn c\u7911\'3fa U\u7927\'3f ban nh\'e2n d\'e2n \'f0\u7883\'3fa ph\'fd\'f5ng (danh m\u7909\'3fc ng\'e0nh, ngh\u7873\'3f, m\u7863\'3ft h\'e0ng v\'e0 d\u7883\'3fch v\u7909\'3f c\u7847\'3fn h\u7841\'3fn ch
\u7871\'3f; gi\'e1 ch\u7881\'3f \'f0\u7841\'3fo \'e1p d\u7909\'3fng cho c\'e1c ngh\u7873\'3f ph\u7909\'3fc v\u7909\'3f \u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng....); s\u7899\'3fm ho\'e0n th\'e0nh vi\u7879\'3fc \'f0i\u7873\'3fu tra, ph\'e2n lo\u7841\'3fi c
\'e1c s\'f5 s\u7903\'3f kinh doanh  c\u7843\'3fi ti\u7871\'3fn c\'f4ng t\'e1c qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd c\'e1c c}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5 s\u7903\'3f kinh doanh , \'f0\u7863\'3fc bi
\u7879\'3ft l\'e0 qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd c\'e1c c}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5 s\u7903\'3f tr\u7885\'3fng \'f0i\u7875\'3fm (cac c\'f5 s\u7903\'3f}{
\f0\fs28\cgrid0\insrsid867582\charrsid5003811  n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i b\u7853\'3fc 1, b\u7853\'3fc 2, b\u7853\'3fc 3) v.v...
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 3/ Ch\u7845\'3fn ch\u7881\'3fnh v\'e0 t\'e3ng c\'fd\u7901\'3fng t\u7893\'3f ch\u7913\'3fc thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp \u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng , t\u7915\'3f Chi c\u7909
\'3fc \'f0\u7871\'3fn ph}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'f2ng thu\u7871\'3f qu\u7853\'3fn huy\u7879\'3fn, th\u7883\'3f x\'e3, th\'e0nh ph\u7889\'3f thu\u7897\'3fc t\u7881\'3fnh, c\'e1c tr\u7841\'3fm, }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7897\'3fi c\'f4ng t\'e1c thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp ;so\'e1t x\'e9t l\u7841\'3fi vi\u7879\'3fc tuy\u7875\'3fn ch\u7885\'3fn c\'e1c u\u7927\'3f nhi\u7879\'3fm thu thu\u7871\'3f. T
\'e3ng c\'fd\u7901\'3fng ki\u7875\'3fm tra c\'f4ng t\'e1c thu\u7871\'3f, gi\'e1m s\'e1t ho\u7841\'3ft \'f0\u7897\'3fng c\u7911\'3fa c\'e1n b\u7897\'3f thu\'ea u\u7927\'3f nhi\u7879\'3fm thu thu\u7871\'3f; \'f0\u7891\'3fng th\u7901\'3fi b\u7843\'3fo v
\u7879\'3f v\'e0 t\u7841\'3fo \'f0i\u7873\'3fu ki\u7879\'3fn thu\u7853\'3fn l\u7907\'3fi cho c\'e1n b\u7897\'3f thu\u7871\'3f ho\'e0n th\'e0nh nhi\u7879\'3fm v\u7909\'3f.
\par 4/ Ph\u7889\'3fi h\u7907\'3fp ch\u7863\'3ft ch\u7869\'3f gi\u7919\'3fa c\'f5 quan th\u7871\'3f v\u7899\'3fi c\'e1c c\'f5 quan c\'f3 li\'ean quan (th\'fd\'f5ng nghi\u7879\'3fp, c\'f4ng an, qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd
