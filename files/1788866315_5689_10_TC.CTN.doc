\f47\fs28\cgrid0\insrsid867582\charrsid5003811 Thi h\'e0nh ph\'e1p l\u7879\'3fnh c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng Nh\'e0 n\'fd\u7899\'3fc v\'e0 Ngh\u7883\'3f \'f0\u7883\'3fnh c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903
\'3fngv\u7873\'3f thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp, B\u7897\'3f T\'e0i ch\'ednh h\'fd\u7899\'3fng d\u7851\'3fn nh\'fd sau:
\par }{\b\f0\fs28\cgrid0\insrsid867582\charrsid10649362 I. Thu\u7871\'3f m\'f4n b\'e0i:
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 1/Thu\u7871\'3f m\'f4n b\'e0i \'f0\u7863\'3ft ra nh\u7857\'3fm th\u7921\'3fc hi\u7879\'3fn y\'eau c\u7847\'3fu ki\u7875\'3fm k\'ea, ki\u7875\'3fm so\'e1t v\'e0 ph\'e2n lo\u7841\'3fi c\'e1c c\'f5 s\u7903\'3f
 kinh doanh c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp ri\'eang l\u7867\'3f v\'e0 t\u7853\'3fp th\u7875\'3f.
\par M\u7885\'3fi t\u7893\'3f ch\u7913\'3fc v\'e0 c\'e1 nh\'e2n dinh doanh c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp chuy\'ean nghi\u7879\'3fp v\'e0 n\u7917\'3fa chuy\'ean nghi\u7879\'3fp \'f0\u7873\'3fu ph\u7843\'3fi n\u7897\'3fp thu\u7871\'3f m\'f4n b\'e0i. C\'f5
 quan thu\u7871\'3f thu Thu\u7871\'3f m\'f4n b\'e0i  v\'e0 c\u7845\'3fp m\'f4n b\'e0i cho c\'e1c c\'f5 s\u7903\'3f kinh doanh c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp c\'e3n c\u7913\'3f v\'e0o gi\u7845\'3fy ph\'e9p kinh doanh do c\'e1c c\'f5 quan c\'f3 th
\u7849\'3fm quy\u7873\'3fn c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc c\u7845\'3fp.
\par }\pard\plain \s16\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid14551869 
\f36\fs24\cf2\lang3081\langfe1033\cgrid\langnp3081\langfenp1033 {\f47\fs28\cf0\insrsid867582\charrsid5003811 2/ Thu\u7871\'3f m\'f4n b\'e0i thu m\u7895\'3fi n\'e3m m\u7897\'3ft l\u7847\'3fn v\'e0o \'f0\u7847\'3fu n\'e3m d\'fd\'f5ng l\u7883\'3fch. \'d0
\u7871\'3fn ng\'e0y 31/5/1983 vi\u7879\'3fc thu Thu\u7871\'3f m\'f4n b\'e0i n\'e3m 1983 ph\u7843\'3fi l\'e0m xong. \'d0\u7875\'3f k\u7871\'3ft h\u7907\'3fp gi\u7919\'3fa vi\u7879\'3fc c\u7845\'3fp gi\u7845\'3fy ph\'e9p kinh doanh v\'e0 vi\u7879\'3f
c thu Thu\u7871\'3f m\'f4n b\'e0i , UBND t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu tr\u7921\'3fc thu\u7897\'3fc Trung \'fd\'f5ng, c\u7847\'3fn ch\u7881\'3f \'f0\u7841\'3fo v\'e0 \'f0\'f4n \'f0\u7889\'3fc c\'e1c ng\'e0nh c\'f3 li\'ean quan 
\u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng t\u7893\'3f ch\u7913\'3fc m\u7897\'3ft \'f0\u7907\'3ft x\'e9t duy\u7879\'3ft vi\u7879\'3fc c\u7845\'3fp gi\'e2}{\f0\fs28\cf0\insrsid867582\charrsid5003811 \'fd ph\'e9p kinh doanh cho t\u7845\'3ft c\u7843\'3f nh
\u7919\'3fng c}{\f47\fs28\cf0\insrsid867582\charrsid5003811 \'f5 s\u7903\'3f ch\'fda c\'f3 gi\u7845\'3fy ph\'e9p, ch\u7853\'3fm nh\u7845\'3ft l\'e0 \'f0\u7871\'3fn ng\'e0y 16/5/1983 ph\u7843\'3fi xong.
\par }\pard\plain \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid14551869 
\f36\fs26\lang3081\langfe1033\cgrid\langnp3081\langfenp1033 {\f47\fs28\cgrid0\insrsid867582\charrsid5003811 T\u7915\'3f ng\'e0y 1/6/1983 tr\u7903\'3f \'f0i, nh\u7919\'3fng c\'f5 s\u7903\'3f kinh doanh kh\'f4ng c\'f3 m\'f4n b\'e0i s\u7869\'3f b\u7883\'3f x
\u7917\'3f l}{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd  theo \'f0i\u7873\'3fu 44 c\u7911\'3fa \'f0i\u7873\'3fu l\u7879\'3f thu\u7871\'3f c\'f4ng th}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd\'f5ng nghi\u7879\'3fp \'f0}{
\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3 }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\'fd\u7907\'3fc s\u7917\'3fa \'f0\u7893\'3fi theo \'f0i\u7873\'3fu 6 c\u7911\'3fa Ph\'e1p l\u7879\'3fnh ng\'e0y 26/2/1983 c\u7911\'3fa H\u7897\'3fi 
\'f0\u7891\'3fng Nh\'e0 n\'fd\u7899\'3fc . UBND t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu tr\u7921\'3fc thu\u7897\'3fc Trung \'fd\'f5ng c\u7847\'3fn c\'f4ng b\u7889\'3f ngay th\u7901\'3fi h\u7841\'3fn n\'e0y cho c\'e1c c\'f5 s\u7903\'3f
 kinh doanh trong \'f0\u7883\'3fa ph\'fd\'f5ng bi\u7871\'3ft \'f0\u7875\'3f l\'e0m th\u7911\'3f t\u7909\'3fc xin c\u7845\'3fp gi\u7845\'3fy ph\'e9p kinh doanh v\'e0 m\'f4n b\'e0i.
\par 3/ C\'e3n c\u7913\'3f \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh m\u7913\'3fc thu\u7871\'3f m\'f4n b\'e0i l\'e0 thu nh\u7853\'3fp v\u7873\'3f kinh doanh (doanh thu t\u7915\'3f chi ph\'ed nh\'fdng ch\'fda tr\u7915\'3f su\u7845\'3ft mi\u7877\'3fn thu). M\u7913
\'3fc Thu\u7871\'3f m\'f4n b\'e0i do c\'f5 quan thu\u7871\'3f huy\u7879\'3fn, qu\u7853\'3fn, th\u7883\'3f x}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3, th\'e0nh ph\u7889\'3f thu\u7897\'3fc t\u7881\'3fnh }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7883\'3fnh cho t\u7915\'3fng c\'f5 s\u7903\'3f, m\u7895\'3fi n\'e3m m\u7897\'3ft l\u7847\'3fn.
\par C\'f5 quan thu\u7871\'3f huy\u7879\'3fn, qu\u7853\'3fn, th\u7883\'3f x}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3, th\'e0nh ph\u7889\'3f thu\u7897\'3fc t\u7881\'3fnh, c}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3n c\u7913\'3f v\'e0o nguy
\'ean t\u7855\'3fc tr\'ean, tham kh\u7843\'3fo doanh thu c\u7911\'3fa c\'e1c h\u7897\'3f s\u7843\'3fn xu\u7845\'3ft, kinh doanh n\'e3m 1982 \'f0\u7875\'3f x\'e1c \'f0\u7883\'3fnh m\u7913\'3fc Thu\u7871\'3f m\'f4n b\'e0i m\'e0 m\u7895\'3fi h\u7897\'3f s
\u7869\'3f ph\u7843\'3fi n\u7897\'3fp n\'e3m 1983. C\u7847\'3fn ch\'fa }{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd ki\u7875\'3fm tra \'f0\u7875\'3f n\u7855\'3fm \'f0\'fang s\u7889\'3f doanh thu n\'e3m 1982 c\u7911\'3fa m\u7895\'3fi c}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5 s\u7903\'3f.
\par \'d0\u7889\'3fi v\u7899\'3fi c\'e1c c\'f5 s\u7903\'3f m\u7899\'3fi khai tr\'fd\'f5ng trong n\'e3m 1983, c\'f5 quan thu\u7871\'3f huy\u7879\'3fn, qu\u7853\'3fn, th\u7883\'3f x}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3, th\'e0nh ph\u7889\'3f th}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 u\u7897\'3fc t\u7881\'3fnh c\'e3n c\u7913\'3f v\'e0o quy m\'f4 c\u7911\'3fa c\'f5 s\u7903\'3f kinh doanh , \'f0\u7889\'3fi chi\u7871\'3fu v\u7899\'3fi c\'f5 s\u7903\'3f kinh doanh t\'fd\'f5ng \'f0\'fd\'f5ng c
\'f9ng ng\'e0nh, ngh\u7873\'3f m\'e0 \'f0\u7883\'3fnh m\u7913\'3fc thu\u7871\'3f ph\u7843\'3fi n\u7897\'3fp n\'e3m 1983. Sang n\'e3m 1984 s\u7869\'3f c\'e3n c\u7913\'3f v\'e0o th\u7921\'3fc t\u7871\'3f kinh doanh n\'e3m 1983 m\'e0 \'f0i\u7873\'3fu ch
\u7881\'3fnh l\u7841\'3fi m\u7913\'3fc thu\u7871\'3f ph\u7843\'3fi n\u7897\'3fp c\'f9ng m\u7897\'3ft l\u7847\'3fn v\u7899\'3fi vi\u7879\'3fc thu thu\u7871\'3f m\'f4n b\'e0i n\'e3m 1984. 
\par 4/ Vi\u7879\'3fc \'f0\u7893\'3fi m\'f4n b\'e0i ch\u7881\'3f \'e1p d\u7909\'3fng \'f0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f kinh doanh \'f0}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3 n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i m
\'e0 mu\u7889\'3fn thay }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7893\'3fi ng\'e0nh, ngh\u7873\'3f, m\u7863\'3ft h\'e0ng kinh doanh ho\u7863\'3fc \'f0\u7883\'3fa b\'e0n kinh doanh theo h\'fd\u7899\'3fng Nh\'e0 n\'fd\u7899\'3fc khuy\u7871\'3f
n kh\'edch. Vi\u7879\'3fc \'f0\u7893\'3fi m\'f4n b\'e0i ch\u7881\'3f \'e1p d\u7909\'3fng cho n\'e3m di\u7877\'3fn ra s\u7921\'3f thay \'f0\u7893\'3fi v\u7873\'3f ng\'e0nh, ngh\u7873\'3f, m\u7863\'3ft h\'e0ng v\'e0 \'f0\u7883\'3fa b\'e0
n kinh doanh ; sang n\'e3m sau, c\'f5 quan thu\u7871\'3f s\u7869\'3f x\'e1c \'f0\u7883\'3fnh l\u7841\'3fi m\u7913\'3fc Thu\u7871\'3f m\'f4n b\'e0i cho ph\'f9 h\u7907\'3fp v\u7899\'3fi thu nh\u7853\'3fp v\u7873\'3f kinh doanh .
\par }{\b\f0\fs28\cgrid0\insrsid867582\charrsid10649362 II. Thu\u7871\'3f Doanh nghi\u7879\'3fp:
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 1/ Vi\u7879\'3fc s\u7855\'3fp x\u7871\'3fp c\'e1c ng\'e0nh, ngh\u7873\'3f kinh doanh v\'e0o c\'e1c b\u7853\'3fc thu\u7871\'3f}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811  su\u7845\'3ft thu\u7871\'3f
 doanh nghi\u7879\'3fp ph\u7843\'3fi theo \'f0\'fang \'f0i\u7873\'3fu 4 Ngh\u7883\'3f \'f0\u7883\'3fnh c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903\'3fng.
\par 2/\'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f s\u7843\'3fn xu\u7845\'3ft l\'e0m gia c\'f4ng d\'fd\u7899\'3fi b\u7845\'3ft c\u7913\'3f h}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ecnh th\u7913\'3fc n\'e0o, }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7873\'3fu thu thu\u7871\'3f doanh nghi\u7879\'3fp tr\'ean t\u7893\'3fng s\u7889\'3f ti\u7873\'3fn c\'f4ng ho\u7863\'3fc doanh thu theo thu\u7871\'3f su\'e2t \'e1p d\u7909\'3fng cho ng\'e0nh s\u7843\'3f
n xu\u7845\'3ft}{\f39\fs28\cgrid0\insrsid867582\charrsid5003811  \'f0\'f3. 
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 Ngo\'e0i ra, v\'ec thu\u7871\'3f su\u7845\'3ft thu\u7871\'3f doanh nghi\u7879\'3fp \'e1p d\u7909\'3fng }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7889\'3fi v\u7899\'3fi c\'e1c c\'f5 s\u7903\'3f
 kinh doanh c\'e1c ng\'e0nh ph\u7909\'3fc v\u7909\'3f, th\'fd\'f5ng nghi\u7879\'3fp v\'e0 \'e3n u\u7889\'3fng v\u7915\'3fa c\'e3n c\u7913\'3f v\'e0o quy m\'f4 c\u7911\'3fa c\'f5 s\u7903\'3f kinh doanh , v\u7915\'3fa c\'e3n c\u7913\'3f v\'e0o m\u7863\'3f
t h\'e0ng kinh doanh , cho n\'ean UBND t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu tr\u7921\'3fc thu\u7897\'3fc TW c\u7847\'3fn c\'e3n c\u7913\'3f v\'e0o t}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ecnh h\'ecnh \u7903\'3f }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0\u7883\'3fa ph\'fd\'f5ng m\'e0 h\'fd\u7899\'3fng d\u7851\'3fn c\u7909\'3f th\u7875\'3f c\'e1c ti\'eau chu\u7849\'3fn v\u7873\'3f quy m\'f4 v\'e0 v\u7873\'3f m\u7863\'3ft h\'e0ng kinh doanh \'f0\u7875\'3f
 l\'e0m c\'e3n c\u7913\'3f x\u7871\'3fp b\u7853\'3fc thu\u7871\'3f doanh nghi\u7879\'3fp cho c\'e1c c\'f5 s\u7903\'3f kinh doanh  \u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng, C\u7909\'3fc thu\u7871\'3f c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp c\u7847\'3fn theo d}
{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5i, h}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd\u7899\'3fng d\u7851\'3fn c\'e1c \'f0\u7883\'3fa ph\'fd\'f5ng trong c\'f4ng th\'fd\'f5ng nghi\u7879\'3fp  c\u7847\'3fn theo d}{
\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5i, h}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd\u7899\'3fng d\u7851\'3fn c\'e1c \'f0\u7883\'3fa ph\'fd\'f5ng trong vi\u7879\'3fc n\'e0y \'f0\u7875\'3f b\u7843\'3fo \'f0\u7843\'3fm t\'ednh th
\u7889\'3fng nh\u7845\'3ft c\u7911\'3fa ch\'ednh s\'e1ch trong c\u7843\'3f n\'fd\u7899\'3fc.
\par }{\b\f0\fs28\cgrid0\insrsid867582\charrsid10649362 III. Thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 1/ Ph\'fd\'f5ng th\u7913\'3fc thu thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp \'f0\u7889\'3fi v\u7899\'3fi t\u7915\'3fng lo\u7841\'3fi c\'f5 s\u7903\'3f kinh doanh t\u7853\'3fp th\u7875
\'3f c\u361\'3fng nh\'fd ri\'eang l\u7867\'3f quy \'f0\u7883\'3fnh nh\'fd sau:
\par - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i b\u7853\'3fc 6: ch\u7881\'3f thu thu\u7871\'3f doanh nghi\u7879\'3fp , kh\'f4ng thu thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3f
p , Thu\u7871\'3f doanh nghi\u7879\'3fp  thu h\'e0ng th\'e1ng.
\par - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i b\u7853\'3fc 5: thu thu\u7871\'3f doanh nghi\u7879\'3fp  h\'e0ng th\'e1ng g\u7897\'3fp v\u7899\'3fi thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi
\u7879\'3fp h\'e0ng th\'e1ng theo m\u7913\'3fc c\u7889\'3f \'f0\u7883\'3fnh cho t\u7915\'3fng qu}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd.
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i b\u7853\'3fc 4: thu thu\u7871\'3f doanh nghi\u7879\'3fp  h\'e0ng th\'e1ng v\'e0 thu\u7871\'3f l\u7907
\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp h\'e0ng th\'e1ng c\'e3n c\u7913\'3f v\'e0o k\u7871\'3ft qu\u7843\'3f kinh doanh c\u7911\'3fa th\'e1ng \'f0\'f3.
\par }{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 - \'d0}{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f n\u7897\'3fp Thu\u7871\'3f m\'f4n b\'e0i  b\u7853\'3fc 3: thu thu\u7871\'3f doanh nghi\u7879
\'3fp  h\'e0ng th\'e1ng v\'e0 thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp h\'e0ng th\'e1ng c\'e3n c\u7913\'3f v\'e0o k\u7871\'3ft qu\u7843\'3f kinh doanh c\u7911\'3fa th\'e1ng \'f0\'f3. C\'f5 s\u7903\'3f kinh doanh b\u7855\'3ft bu\u7897
\'3fc ph\u7843\'3fi ghi ch\'e9p k\u7871\'3f to\'e1n theo m\u7851\'3fu \'f0\'f5n gi\u7843\'3fn.
\par - \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng c\'f5 s\u7903\'3f n\u7897\'3fp T}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 hu\u7871\'3f m\'f4n b\'e0i  b\u7853\'3fc 2 v\'e0 b\u7853\'3fc 1: thu thu\u7871\'3f doanh nghi\u7879\'3fp  h\'e0ng th\'e1ng; t
\u7841\'3fm thu thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp h\'e0ng th\'e1ng v\'e0 quy\u7871\'3ft to\'e1n v\'e0o cu\u7889\'3fi qu\'fd (ph\u7843\'3fi }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f0i\u7873\'3fu ch\u7881\'3fnh s\u7889
\'3f thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp  ph\u7843\'3fi n\u7897\'3fp cho ph\'f9 h\u7907\'3fp v\u7899\'3fi th\u7921\'3fc t\u7871\'3f kinh doanh c\u7843\'3f qu}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd). C}{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 \'f5 s\u7903\'3f kinh doanh b\u7855\'3ft bu\u7897\'3fc ph\u7843\'3fi ghi ch\'e9p k\u7871\'3f to\'e1n theo \'f0\'fang th\u7875\'3f th\u7913\'3fc Nh\'e0 n\'fd\u7899\'3fc quy \'f0\u7883\'3fnh.
\par 2/ Nh\u7919\'3fng c\'f5 s\u7903\'3f kinh doanh m\u7899\'3fi t\u7841\'3fm n\u7897\'3fp thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp qu}{\f39\fs28\cgrid0\insrsid867582\charrsid5003811 \'fd I/1983, \'f0\u7871\'3fn cu\u7889\'3fi n\'e3m m
\u7899\'3fi quy\u7871\'3ft to\'e1n, th}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ec khi quy\u7871\'3ft to\'e1n ph\u7843\'3fi t\'ednh thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp c\u7843\'3f n}{
\f39\fs28\cgrid0\insrsid867582\charrsid5003811 \'e3m theo quy \'f0\u7883\'3fnh c\u7911\'3fa Ph\'e1p }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 l\u7879\'3fnh.
\par }{\f47\fs28\cgrid0\insrsid867582\charrsid5003811 3/ Thu\u7871\'3f l\u7907\'3fi t\u7913\'3fc doanh nghi\u7879\'3fp c\'f3 3 bi\u7875\'3fu thu\u7871\'3f: bi\u7875\'3fu thu\u7871\'3f \'f0\u7889\'3fi v\u7899\'3fi ng\'e0nh s\u7843\'3fn xu\u7845\'3ft , v\u7853
\'3fn t\u7843\'3fi; bi\u7875\'3fu thu\u7871\'3f \'f0\u7889\'3fi v\u7899\'3fi ng\'e0nh ph\u7909\'3fc v\u7909\'3f v\'e0 bi\u7875\'3fu thu\u7871\'3f \'f0\u7889\'3fi v\u7899\'3fi ng\'e0nh th\'fd\'f5ng nghi\u7879\'3fp, \'e3n u\u7889\'3fng.
\par Ng\'e0nh \'e3n u\u7889\'3fng tr\'fd\u7899\'3fc \'f0\'e2y ch\u7883\'3fu thu\u7871\'3f theo bi\u7875\'3fu thu\u7871\'3f c\u7911\'3fa ng\'e0nh ph\u7909\'3fc v\u7909\'3f th}{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 \'ec t\u7915\'3f nay }{
\f47\fs28\cgrid0\insrsid867582\charrsid5003811 ch\u7883\'3fu thu\u7871\'3f theo bi\u7875\'3fu thu\u7871\'3f c\u7911\'3fa t\u7915\'3fng ng\'e0nh th\'fd\'f5ng nghi\u7879\'3fp, \'e3n u\u7889\'3fng m\u7899\'3fi ban h\'e0nh.
\par }{\f0\fs28\cgrid0\insrsid867582\charrsid5003811 4/ Thu\u7871\'3f su\u7845\'3ft b\u7893\'3f sung:
