\'3fc ph\'e2n c\'f4ng d\u7841\'3fy thay m\u7895\'3fi tu\u7847\'3fn 2 gi\u7901\'3f, th\'ec s\u7889\'3f gi\u7901\'3f}{\f166\fs28\cf0\insrsid4199420\charrsid16603118  x\'e1c \'f0}{\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7883\'3f}{
\f174\fs28\cf0\insrsid4199420\charrsid16603118 nh nh\'fd sau:
\par }{\f0\fs28\cf0\insrsid4199420\charrsid16603118 16 gi\u7901\'3f + 4 gi\u7901\'3f ch\u7911\'3f nhi\u7879\'3fm + 2 gi\u7901\'3f d\u7841\'3fy thay = 22 gi\u7901\'3f (m\u7897\'3ft tu\u7847\'3fn).
\par So v\u7899\'3fi gi\u7901\'3f ti\'eau chu\u7849\'3fn h\'e0ng tu\u7847\'3fn c\u7911\'3fa gi\'e1o vi\'ean c\u7845\'3fp II (20 gi\u7901\'3f), th\'ec gi\'e1o vi\'ean c\u7845\'3f}{\f174\fs28\cf0\insrsid4199420\charrsid16603118 p II n\'e0y \'f0\'fd}{
\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7907\'3fc t\'ednh 2 gi\u7901\'3f d\u7841\'3fy th\'eam m\u7895\'3fi tu\u7847\'3fn, 4 tu\u7847\'3fn l\'e0 8 gi\u7901\'3f}{\f174\fs28\cf0\insrsid4199420\charrsid16603118 , v\'e0 \'f0\'fd}{
\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7907\'3f}{\f166\fs28\cf0\insrsid4199420\charrsid16603118 c thanh to\'e1n 1,60 \'f0 x 8 = 12,80 \'f0}{\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7891\'3fng.
\par }{\f174\fs28\cf0\insrsid4199420\charrsid16603118 Tr\'fd}{\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7901\'3fng h\u7907\'3fp gi\'e1o vi\'ean d\u7841\'3fy l\u7841\'3fi m\u7897\'3ft ti\u7871\'3ft h\u7885\'3fc n\'e0o m\'e0 trong gi\u7901\'3f d\u7841\'3f}{
\f174\fs28\cf0\insrsid4199420\charrsid16603118 y tr\'fd}{\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7899\'3f}{\f174\fs28\cf0\insrsid4199420\charrsid16603118 c ch\'fda}{\f166\fs28\cf0\insrsid4199420\charrsid16603118  \'f0}{
\f0\fs28\cf0\insrsid4199420\charrsid16603118 \u7841\'3ft y\'eau c\u7847\'3fu ho\u7863\'3fc d\u7841\'3fy gi\'fap gi\'e1o vi\'ean kh\'e1c ngh\u7881\'3f v\'ec vi\u7879\'3fc ri\'eang th\'ec kh\'f4ng coi l\'e0 gi\u7901\'3f d\u7841\'3fy th\'eam.}{
\f0\fs28\cf0\insrsid4011305 
