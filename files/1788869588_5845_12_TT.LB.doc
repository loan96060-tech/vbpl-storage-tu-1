\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd v\'e0 c\u7845\'3fp ph\'e1t v\u7889\'3fn }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f \'f0\u7875\'3f khai hoang m\u7903\'3f r\u7897\'3fng di\u7879
\'3fn t\'edch x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi do ng\'e0nh n\'f4ng nghi\u7879\'3fp qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 Nay \'f0\u7875\'3f ti\u7871\'3fp t\u7909\'3fc tri\u7875\'3fn khai c\'e1c quy\u7871\'3ft \'f0\u7883\'3fnh v\'e0 ch\u7881\'3f th\u7883\'3f n\'f3i tr\'ean c\u7911\'3fa Ch\'ednh ph\u7911\'3f trong ng\'e0
nh L\'e2m nghi\u7879\'3fp, Li\'ean B\u7897\'3f T\'e0i ch\'ednh - L\'e2m nghi\u7879\'3fp h\'fd\u7899\'3fng d\u7851\'3fn m\u7897\'3ft s\u7889\'3f v\u7845\'3fn \'f0\u7873\'3f}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755  c\u7909\'3f th\u7875\'3f v\u7873
\'3f vi\u7879\'3fc l\u7853\'3fp k\u7871\'3f ho\u7841\'3fch, nguy\'ean t\u7855\'3fc th\u7911\'3f t\u7909\'3fc c\u7845\'3fp ph\'e1t  v\'e0 qu\u7843\'3fn l\'fd v\u7889\'3fn }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7847\'3fu t\'fd h\u7895
\'3f tr\u7907\'3f h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn su\u7845\'3ft l\'e2m nghi\u7879\'3fp, th\u7921\'3fc hi\u7879\'3fn }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd v\'e0 x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp nh\'fd sau:
\par }\pard \qc \li0\ri0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid8788422 {\b\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
I. NGUY\'caN T\u7854\'3fC CHUNG 
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid13386600 {
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 1. Nh\'e0 n\'fd\u7899\'3fc \'f0\u7847\'3fu t\'fd \'f0\u7875\'3f m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3f
nh canh \'f0\u7883\'3fnh c\'fd theo ph\'fd\'f5ng ch\'e2m Nh\'e0 n\'fd\u7899\'3fc v\'e0 nh\'e2n d\'e2n c\'f9ng l\'e0m. \'d0\'fd\u7907\'3fc s\u7921\'3f h\u7895\'3f tr\u7907\'3f v\u7873\'3f v\u7889\'3fn c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc c\'e1c h\u7907\'3f
p t\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 ph\u7843\'3fi ph\'e1t huy }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7871\'3fn m\u7913\'3fc cao nh\u7845\'3ft v\u7889\'3fn t\u7921\'3f c\'f3 c\u7911\'3fa m}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh, n\u7871\'3fu c\'f2n thi\u7871\'3fu th\'ec h\u7907\'3fp t\'e1c x\'e3 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc Ng\'e2n h\'e0ng Nh\'e0 n\'fd\u7899\'3fc cho vay v\u7889
\'3fn \'f0\u7875\'3f th\u7921\'3fc hi\u7879\'3fn nhi\u7879\'3fm v\u7909\'3f k\u7871\'3f ho\u7841\'3fch \'f0\'fd\u7907\'3fc Nh\'e0 n\'fd\u7899\'3fc giao, kh\'f4ng \u7927\'3f l\u7841\'3fi v\'e0o Nh\'e0 n\'fd\u7899\'3fc.
\par - \'d0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc tr\u7907\'3f c\u7845\'3fp l\'e0 c\'e1c h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp, c\'e1c h\u7907\'3fp t\'e1c x\'e3
 n\'f4ng nghi\u7879\'3fp ki\'eam doanh ngh\u7873\'3f r\u7915\'3fng m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp; }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7891\'3f}{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 ng b\'e0o c\'e1c d\'e2n t\u7897\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd, \'f0\u7891\'3fng b\'e0o \'f0i x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l
\'e2m nghi\u7879\'3fp.
\par - Ngu\u7891\'3fn v\u7889\'3fn do ng\'e2n s\'e1ch Trung \'fd\'f5ng tr\u7907\'3f c\u7845\'3fp cho c\'e1c t\u7881\'3fnh, B\u7897\'3f L\'e2m nghi\u7879\'3fp c\'e3n c\u7913\'3f nguy\'ean t\u7855\'3fc k\u7871\'3ft h\u7907\'3fp qu\u7843\'3fn l}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd theo ng\'e0nh v\u7899\'3fi qu\u7843\'3fn l\'fd theo }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fa ph\'fd\'f5ng  c\'f3 tr\'e1ch nhi\u7879\'3fm ph\'e2n b\u7893\'3f c\u7909\'3f th
\u7875\'3f v\u7889\'3fn Nh\'e0 n\'fd\u7899\'3fc \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f cho c\'e1c t\u7881\'3fnh \'f0\u7875\'3f \'f0\u7843\'3fm b\u7843\'3fo th\u7921\'3fc hi\u7879\'3fn \'f0\'fang k\u7871\'3f ho\u7841\'3fch khai hoang m\u7903\'3f r
\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp, th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd, \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc Ch\'ednh ph\u7911\'3f duy\u7879\'3ft cho t\u7915\'3fng \'f0\u7883\'3fa ph\'fd\'f5ng. \'d0\u7883\'3fa ph\'fd\'f5ng ch\u7881\'3f \'f0\'fd\u7907\'3fc d\'f9ng v\u7889\'3fn n\'e0y \'f0
\u7875\'3f chi theo \'f0\'fang m\u7909\'3fc \'f0\'edch, \'f0\'fang ch\'ednh s\'e1ch ch\u7871\'3f \'f0\u7897\'3f, \'f0\'fang \'f0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc duy\u7879\'3ft.  
\par V\u7889\'3fn Nh\'e0 n\'fd\u7899\'3fc \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f cho c\'f4ng t\'e1c khai hoang m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp, th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3f
nh canh \'f0\u7883\'3fnh c\'fd bao g\u7891\'3fm 2 lo\u7841\'3fi: V\u7889\'3fn XDCB v\'e0 kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 1. V\u7889\'3fn x\'e2y d\u7921\'3fn}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 g c\'f5 b\u7843\'3fn.
\par a. X\'e2y d\u7921\'3fng c\'e1c c\'f5 s\u7903\'3f h\u7841\'3f t\u7847\'3fng trong v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp v\'e0 v\'f9ng \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd theo quy ho\u7841\'3fch, k\u7871\'3f ho\u7841\'3fch Nh
\'e0 n\'fd\u7899\'3fc duy\u7879\'3ft cho t\u7915\'3fng v\'f9ng quy \'f0\u7883\'3fnh t\u7841\'3fi \'f0i\u7875\'3fm 2 m\u7909\'3fc II quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 272 - CP ng\'e0y 3/10/1977 c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng Ch\'ed
nh ph\u7911\'3f.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 Trong nh\u7919\'3fng c\'f4ng tr\'ecnh n\'f3i tr\'ean, n\u7871\'3fu c\'f4ng tr\'ecnh n\'e0o thu\u7897\'3fc }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7889\'3fi t\'fd\u7907\'3fng \'f0\u7847
\'3fu t\'fd b\u7857\'3fng v\u7889\'3fn t\'edn d\u7909\'3fng c\u7911\'3fa Ng\'e2n h\'e0ng Nh\'e0 n\'fd\u7899\'3fc th}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ec B\u7897\'3f L\'e2m nghi\u7879\'3fp v\'e0 U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3f
nh ph\u7843\'3fi ghi v\'e0o k\u7871\'3f ho\u7841\'3fch vay v\u7889\'3fn c\u7911\'3fa Ng\'e2n h\'e0ng Nh\'e0 n}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\u7899\'3fc theo \'f0\'fang Quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 32-CP ng\'e0
y 11/2/1977 c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng Ch\'ednh ph\u7911\'3f v\'e0 Th\'f4ng t\'fd Li\'ean B\u7897\'3f T\'e0i ch\'ednh - Ng\'e2n h\'e0ng Nh\'e0 n\'fd\u7899\'3fc -  U\u7927\'3f ban k\u7871\'3f ho\u7841\'3fch Nh\'e0 n\'fd\u7899\'3fc s\u7889
\'3f 21TT/LB ng\'e0y 17/2/1978.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 b. H\u7895\'3f tr\u7907\'3f m\u7897\'3ft ph\u7847\'3fn cho c\'e1c h\u7907\'3fp t\'e1c x\'e3 mi\u7873\'3fn n\'fai, trung du, ven bi\u7875\'3fn v\'e0 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 
\'f0\u7891\'3fng b\'e0o c\'e1c d\'e2n t\u7897\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd \'f0\'fd\u7907\'3fc giao th\'eam \'f0\u7845\'3ft, th\'eam r\u7915\'3fng \'f0\u7875\'3f m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t
\'edch tr\u7891\'3fng r\u7915\'3fng t\u7853\'3fp trung v\'e0 tu b\u7893\'3f r\u7915\'3fng theo quy ho\u7841\'3fch, cung c\u7845\'3fp nguy\'ean li\u7879\'3fu cho Nh\'e0 n\'fd\u7899\'3fc v\'e0 quy ho\u7841\'3fch ph}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2ng h\u7897\'3f c\'e1c }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7847\'3fu ngu\u7891\'3fn xung y\u7871\'3fu quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 1, 2 m\u7909\'3fc I ph\u7847
\'3fn A Th\'f4ng t\'fd Li\'ean B\u7897\'3f s\u7889\'3f 14 TT/LB. M\u7913\'3fc h\u7895\'3f tr\u7907\'3f c\u7909\'3f th\u7875\'3f do U\u7927\'3f ban nh\'e2n}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755  d\'e2n th\'e0nh ph\u7889\'3f x\'e9t duy\u7879\'3f
t cho t\u7915\'3fng ti\u7875\'3fu v\'f9ng v\'e0 U\u7927\'3f ban nh\'e2n d\'e2n huy\u7879\'3fn x\'e9t duy\u7879\'3ft cho t\u7915\'3fng h\u7907\'3fp t\'e1c x\'e3. 
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 c. H\u7895\'3f tr\u7907\'3f cho \'f0\u7891\'3fng b\'e0o c\'e1c d\'e2n t\u7897\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd v\'e0 \'f0\u7891\'3fng b\'e0o \'f0i x\'e2y d
\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi: X\'e2y d\u7921\'3fng nh\'e0 \u7903\'3f, c\'f4ng tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh n}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\u7899\'3fc cho sinh ho\u7841\'3ft, c
\'e1c}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755  c\'f4ng tr\'ecnh ph\'fac l\u7907\'3fi c\'f4ng c\u7897\'3fng cho h\u7907\'3fp t\'e1c x\'e3 (ho\u7863\'3fc x\'e3 n\u7871\'3fu ch}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fda c\'f3 h\u7907
\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3) nh}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd: Tr\u7909\'3f s\u7903\'3f l\'e0m vi\u7879\'3fc ki\'eam nh\'e0 h\u7885\'3fp, c\'e2u l\u7841\'3fc b\u7897\'3f, nh\'e0 tr\u7867
\'3f, nh\'e0 m\u7851\'3fu gi\'e1o theo quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 4, 6 m\u7909\'3fc I ph\u7847\'3fn A th\'f4ng t\'fd li\'ean B\u7897\'3f s\u7889\'3f 14 TT/LB.
\par d. Ri\'eang \'f0\u7889\'3fi v\u7899\'3fi \'f0\u7891\'3fng b\'e0o d\'e2n t\u7897\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd c}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2n }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f th\'eam b\u7857\'3fng v\u7889\'3fn x\'e2y d\u7921\'3fng c\'f5 b\u7843\'3fn:
\par - Chi ph\'ed cho khai hoang m\u7899\'3fi v\'e0 x\'e2y d\u7921\'3fng \'f0\u7891\'3fng ru\u7897\'3fng li\'ean v\'f9ng li\u7873\'3fn khoang.
\par - Chi ph\'ed l\u7847\'3fn \'f0\u7847\'3fu tr\u7891\'3fng c\'e2y c\'f4ng nghi\u7879\'3fp d\'e0i ng\'e0y, c\'e2y \'f0\u7863\'3fc s\u7843\'3fn (kh\'f4ng ph\u7843\'3fi c\'e2y l\'e2m nghi\u7879\'3fp) v\'e0 m\u7897\'3ft ph\u7847\'3fn ch}{
\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 i ph\'ed \'f0\u7875\'3f ch\'e3m s\'f3c trong 3 n\'e3m \'f0\u7847\'3fu (nh\u7919\'3fng c\'e2y kh\'f4ng ph\u7843\'3fi ch\'e3m s\'f3c t\u7899\'3fi 3 n\'e3m th}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ec h\u7895\'3f tr\u7907\'3f theo s\u7889\'3f n}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3m th\u7921\'3fc t\u7871\'3f) quy \'f0\u7883\'3fnh trong ti\u7871\'3ft a \'f0i\u7875\'3fm 6 m\u7909
\'3fc I ph\u7847\'3fn A th\'f4ng t\'fd Li\'ean B\u7897\'3f s\u7889\'3f 14 TT/LB.
\par - Chi ph\'ed c\u7843\'3fi t\u7841\'3fo \'f0\u7891\'3fng c\u7887\'3f v\'e0 mua con gi\u7889\'3fng: tr\'e2u b}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2 l\u7907\'3fn }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7921\'3fc gi\u7889
\'3fng \'f0\u7875\'3f ph\'e1t tri}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \u7875\'3fn ch\'e3n nu\'f4i t\u7853\'3fp th\u7875\'3f theo quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 6 m\u7909\'3fc II ph\u7847\'3fn A th\'f4ng t\'fd Li\'ean B
\u7897\'3f s\u7889\'3f 14 TT/LB. \'d0\u7889\'3fi v\u7899\'3fi v\'f9ng th\u7921\'3fc t\u7871\'3f c\'f3 nhi\u7873\'3fu  kh\'f3 kh\'e3n v\u7873\'3f s\u7913\'3fc k\'e9o th}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ec }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc x\'e9t h\u7895\'3f tr\u7907\'3f m\u7897\'3ft ph\u7847\'3fn chi ph\'ed \'f0\u7875\'3f mua th\'eam tr\'e2u b}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2 c\'e0y k\'e9o.
\par 2. Kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp.
\par a. Chi cho vi\u7879\'3fc kh\u7843\'3fo s\'e1t thi\u7871\'3ft k\u7871\'3f h\u7907\'3fp t\'e1c x\'e3; n\u7871\'3fu h\u7907\'3fp t\'e1c x\'e3 c\u361\'75 sau khi }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc giao \'f0\u7845\'3f
t, giao r\u7915\'3fng ph\u7843\'3fi quy ho\u7841\'3fch l\u7841\'3fi xc\u361\'3fng \'f0\'fd\u7907\'3fc tr\u7907\'3f c\u7845\'3fp theo m\u7913\'3fc quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 8 m\u7909\'3fc II ph\u7847\'3fn A th\'f4ng t\'fd Li\'ean B
\u7897\'3f s\u7889\'3f 14 TT/LB.
\par b. Chi ph\'ed c\'e1c kho\u7843\'3fn quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 1, 2, 3, 4, 5 m\u7909\'3fc II ph\u7847\'3fn A th\'f4ng t\'fd Li\'ean B\u7897\'3f s\u7889\'3f 14 TT/LB cho \'f0\u7891\'3fng b\'e0o c\'e1c d\'e2n t\u7897\'3fc th\u7921\'3f
c hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd v\'e0 \'f0\u7891\'3fng b\'e0o \'f0i x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp.
\par c. Ri\'eang \'f0\u7889\'3fi v\u7899\'3fi \'f0\u7891\'3fng b\'e0o d\'e2n t\u7897\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd c}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2n }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc c\u7845\'3fp ph\'e1t kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp \'f0\u7875\'3f:
\par }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 - Tr\u7907\'3f c\u7845\'3fp l\u7847\'3fn \'f0\u7847\'3fu mua s\u7855\'3fm c\'f4ng }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 c\u7909\'3f s\u7843\'3fn xu\u7845\'3ft v\'e0 t\'fd li\u7879\'3f
u sinh ho\u7841\'3ft cho gia \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh \u7903\'3f v\'f9ng m\u7899\'3fi gi\u7843\'3fi ph\'f3ng (t\'e2y nguy\'ean, mi\u7873\'3fn n\'fai, khu 5) nh}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd
 ti\u7871\'3ft a \'f0i\u7875\'3fm 6 m\u7909\'3fc II ph\u7847\'3fn A th\'f4ng t\'fd Li\'ean B\u7897\'3f s\u7889\'3f 14 TT/LB.
\par - Khai hoang nh\u7887\'3f (ph\'e2n t\'e1n kh\'f4ng li\u7873\'3fn kho\u7843\'3fnh) m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch t\u7841\'3fi ch\u7895\'3f \u7903\'3f c\'e1c v\'f9ng \'f0inh canh \'f0\u7883\'3fnh c\'fd (t\u7915\'3f 3 ha tr\u7903\'3f xu
\u7889\'3fng).
\par - Chi ph\'ed l\u7847\'3fn \'f0\u7847\'3fu v\u7873\'3f gi\u7889\'3fng v\'e0 ph\'e2n ho\'e1 h\u7885\'3fc \'f0\u7875\'3f tr\u7891\'3fng c\'e2y c\'f4ng nghi\u7879\'3fp ng\u7855\'3fn ng\'e0y (d\'fd\u7899\'3fi 1 n\'e3m).
\par - Chi ph\'ed l\u7847\'3fn \'f0\u7847\'3fu v\u7873\'3f gi\u7889\'3fng m\u7899\'3fi v\'e0 ph\'e2n ho\'e1 h\u7885\'3fc \'f0\u7875\'3f tr\u7891\'3fng c\'e2y l\'fd\'f5ng th\u7921\'3fc v\'e0 th\u7921\'3fc ph\u7849\'3fm.
\par - Chi ph\'ed mua v\u7853\'3ft t\'fd x\'e2y d\u7921\'3fng l\u7841\'3fi c\u7847\'3fu c\u7889\'3fng nh\u7887\'3f c\'e1c l\u7899\'3f}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 p h\u7885\'3fc trong th\'f4n ban.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 - Chi ph\'ed cho ho\u7841\'3ft \'f0\u7897\'3fng c\u7911\'3fa c\'e1c ban \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh v\'e0 c\'e1c huy\u7879\'3fn trong ph\u7841\'3fm vi ch\u7881\'3f ti\'ea
u bi\'ean ch\u7871\'3f \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc Nh\'e0 n\'fd\u7899\'3fc duy\u7879\'3ft cho ng\'e0nh l\'e2m nghi\u7879\'3fp.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid13315484 {\b\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
III. NGUY\'caN T\u7854\'3fC TH\u7910\'3f T\u7908\'3fC L\u7852\'3fP K\u7870\'3f HO\u7840\'3fCH V\u7888\'3fN.
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid13386600 {
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 1. Nguy\'ean t\u7855\'3fc chung
\par - Ch\u7881\'3f ghi v\'e0o k\u7871\'3f ho\u7841\'3fc v}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \u7889\'3fn \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f cho h\u7907\'3fp t\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 m\u7903
\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 th\u7921\'3fc hi\u7879\'3fn }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd quy \'f0\u7883\'3fnh trong th
\'f4ng t\'fd Li\'ean B\u7897\'3f n\'e0y c\'e1c kho\u7843\'3fn chi x\'e2y d\u7921\'3fng c\'e1c c\'f5 s\u7903\'3f h\u7841\'3f t\u7847\'3fng trong v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp v\'e0 v\'f9ng \'f0\u7883\'3fnh canh \'f0\u7883\'3f
nh c\'fd do B\u7897\'3f L\'e2m nghi\u7879\'3fp ph\u7909\'3f tr\'e1ch \u7903\'3f ngo\'e0i c\'e1c v\'f9ng kinh t\u7871\'3f m\u7899\'3fi n\'f4ng nghi\u7879\'3fp. B\u7897\'3f L\'e2m nghi\u7879\'3fp v\'e0 B\u7897\'3f N\'f4ng nghi\u7879\'3fp s\u7869\'3f b\'e0
n b\u7841\'3fc v\'e0 c\'f3 quy \'f0\u7883\'3fnh c\u7909\'3f th\u7875\'3f v\u7873\'3f vi\u7879\'3fc ghi ch\u7881\'3f ti\'eau k\u7871\'3f ho\u7841\'3fch cho s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3f
nh canh \'f0\u7883\'3fnh c\'fd trong c\'e1c v\'f9ng kinh t\u7871\'3f m\u7899\'3fi do B\u7897\'3f N\'f4ng nghi\u7879\'3fp ph\u7909\'3f tr\'e1ch.}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 - Kh\'f4ng ghi v\'e0o k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn n\'e0y c\'e1c kho\u7843\'3fn chi b\u7857\'3fng v\u7889\'3fn t\'edn d\u7909\'3fng \'f0\u7847\'3fu t\'fd, c\'e1c kho\u7843\'3fn chi x\'e2y d
\u7921\'3fng c\'e1c x\'ed nghi\u7879\'3fp qu\u7889\'3fc doanh l\'e2m nghi\u7879\'3fp, n\'f4ng nghi\u7879\'3fp v\'e0 c\'e1c c\'f4ng tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh giao th\'f4ng thu\u7927\'3f l\u7907\'3fi thu\u7897\'3fc c\'e1
c ng\'e0nh c\'f3 li\'ean quan \u7903\'3f Trung }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\'f5ng v\'e0 \u7903\'3f t\u7881\'3fnh ph\u7909\'3f tr\'e1ch. Ri\'eang c\'e1c}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755  c\'f4ng tr\'ecnh }{
\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 2 m\u7909\'3fc II Quy
\u7871\'3ft \'f0\u7883\'3fnh s\u7889\'3f 272 Ch\'ednh ph\u7911\'3f ng\'e0y 3/10/1977 c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng Ch\'ednh ph\u7911\'3f \'f0\'fd\u7907\'3fc ghi v\'e0o k\u7871\'3f ho\u7841\'3fch n\'e0y.
\par 2. Ch\u7871\'3f \'f0\u7897\'3f l\u7853\'3fp k\u7871\'3f ho\u7841\'3fch v\'e0 giao ch\u7881\'3f ti\'eau h\'e0ng n\'e3m v\'e0 t\u7915\'3fng qu}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 a. H\'e0ng n\'e3m c\'e1c t\u7881\'3fnh, th\'e0nh ph\u7889\'3f l\u7853\'3fp to\'e0n b\u7897\'3f k\u7871\'3f ho\u7841\'3fch lao \'f0\u7897\'3fng v\u7853\'3ft t\'fd, thi\u7871\'3ft b\u7883\'3f, l\'fd\'f5
ng th\u7921\'3fc, ti\u7873\'3fn v\u7889\'3fn (k\u7875\'3f c\u7843\'3f ph\u7847\'3fn chu\u7849\'3fn b\u7883\'3f cho n\'e3m sau) c\'e1c v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp, c\'e1c h\u7907\'3fp t\'e1c x}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp, th\u7921\'3fc hi\u7879\'3fn }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3f
nh canh \'f0\u7883\'3fnh c\'fd ngo\'e0i v\'f9ng kinh t\u7871\'3f m\u7899\'3fi n\'f4ng nghi\u7879\'3fp (k\u7875\'3f c\u7843\'3f ph\u7847\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd c\u361\'3f ch\'fda ho\'e0n ch\u7881\'3fnh) g\u7917\'3fi B\u7897\'3f L
\'e2m nghi\u7879\'3fp v\'e0 U\u7927\'3f ban k\u7871\'3f ho\u7841\'3fch Nh\'e0 n\'fd\u7899\'3fc, B\u7897\'3f L\'e2m nghi\u7879\'3fp t\u7893\'3fng h\u7907\'3fp v\'e0 b\u7843\'3fo v\u7879\'3f k\u7871\'3f ho\u7841\'3fch n\'e0y tr\'fd\u7899\'3fc Ch\'ednh ph
\u7911\'3f UBKH Nh\'e0 n\'fd\u7899\'3fc), sau khi Ch\'ednh ph\u7911\'3f duy\u7879\'3ft, giao ch\u7881\'3f ti\'eau cho B\u7897\'3f L\'e2m nghi\u7879\'3fp theo ng\'e0nh th}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ec B\u7897\'3f L\'e2m nghi\u7879
\'3fp c\'f3 tr\'e1ch nhi\u7879\'3fm ph\'e2n b\u7893\'3f}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755  c\u7909\'3f th\u7875\'3f ti\u7873\'3fn v\u7889\'3fn cho t\u7915\'3fng \'f0\u7883\'3fa ph\'fd\'f5ng v\'e0 th\'f4ng b\'e1o cho B\u7897\'3f T\'e0i ch
\'ednh bi\u7871\'3ft \'f0\u7875\'3f ghi k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn tr\u7907\'3f c\u7845\'3fp cho c\'e1c \'f0\u7883\'3fa ph\'fd\'f5ng.
\par b. C\'e1c t\u7881\'3fnh c\'e3n c\u7913\'3f v\'e0o s\u7889\'3f v\u7889\'3fn ghi trong th\'f4ng b\'e1o c\u7911\'3fa B\u7897\'3f L\'e2m nghi\u7879\'3fp l\u7853\'3fp k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn v\'e0 n\u7897\'3fi dung c\'f4ng vi\u7879\'3fc ph
\u7843\'3fi l\'e0m t\u7915\'3fng qu}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd g\u7917\'3fi v\u7873\'3f B\u7897\'3f L}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e2m nghi\u7879\'3fp \'f0\u7875\'3f t\u7893\'3fng h\u7907\'3fp x\'e9
t duy\u7879\'3ft v\'e0 th\'f4ng b\'e1o cho B\u7897\'3f T\'e0i ch\'ednh bi\u7871\'3ft l\'e0m c\'f5 s\u7903\'3f chuy\u7875\'3fn v\u7889\'3fn tr\u7907\'3f c\u7845\'3fp t\u7915\'3fng qu}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd cho t\u7881\'3f
nh, th\'e0nh ph\u7889\'3f.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 c. C\'f5 quan gi\'fap U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3fnh l\u7853\'3fp v\'e0 t\u7893\'3fng h\u7907\'3fp k\u7871\'3f ho\u7841\'3fch n\'f3i tr\'ean l\'e0:
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 + Ty L\'e2m nghi\u7879\'3fp t\u7881\'3fnh: C\'f3 tr\'e1ch nhi\u7879\'3fm t\u7893\'3fng h\u7907\'3fp k\u7871\'3f ho\u7841\'3fch }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7847\'3fu t\'fd h
\u7895\'3f tr\u7907\'3f m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch ph\'e1t tri\u7875\'3fn s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp.
\par + Ban \'f0\u7883\'3fnh canh, \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh: c\'f3 tr\'e1ch nhi\u7879\'3fm t\u7893\'3fng h\u7907\'3fp k\u7871\'3f ho\u7841\'3fch \'f0\u7883\'3fnh canh, \'f0\u7883\'3fnh c\'fd (tr\u7915\'3f ph\u7847\'3fn tr\u7891\'3fng r\u7915\'3f
ng, ch\'e3m s\'f3c, tu b\u7893\'3f r\u7915\'3fng do Ty L\'e2m nghi\u7879\'3fp t\u7893\'3fng h\u7907\'3fp)}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
\par }{\f0\fs28\ul\cgrid0\insrsid13192936\charrsid15956755 Ch\'fa \'fd}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 : Ty L\'e2m nghi\u7879\'3fp v\'e0 Ban \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh th\'e0nh ph\u7889\'3f }{
\f0\fs28\ul\cgrid0\insrsid13192936\charrsid15956755 ph\u7843\'3fi t\u7893\'3fng h\u7907\'3fp ri\'eang}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755  ph\u7847\'3fn v\u7889\'3fn chi cho khai hoang m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s
\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd trong v\'f9ng kinh t\u7871\'3f  m\u7899\'3fi t\u7881\'3fnh \'f0\u7891\'3fng th\u7901\'3fi b\'e1o c\'e1o v\u7873\'3f B\u7897\'3f
 L\'e2m nghi\u7879\'3fp \'f0\u7875\'3f th\u7889\'3fng nh\u7845\'3ft}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755  v\u7899\'3fi B\u7897\'3f N\'f4ng nghi\u7879\'3fp ghi v\'e0o k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn v\'f9ng kinh t\u7871\'3f m\u7899\'3f
i n\'f4ng nghi\u7879\'3fp. (Do T\u7893\'3fng c\u7909\'3fc khai hoang v\'e0 x\'e2y d\u7921\'3fng v\'f9ng kinh t\u7871\'3f m\u7899\'3fi ph\u7909\'3f tr\'e1ch).
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 3/ V\u7889\'3fn \'f0\u7875\'3f \'f0i\u7873\'3fu ch\u7881\'3fnh k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn h\'e0ng qu}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd v\'e0 n}{
\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3m:
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 Trong qu\'e1 tr\'ecnh th\u7921\'3fc hi\u7879\'3fn k\u7871\'3f ho\u7841\'3fch n\u7871\'3fu c\'e1c t\u7881\'3fnh, th\'e0nh ph\u7889\'3f c\'f3 kh\u7843\'3f n}{
\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3n}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 g ho\'e0n th\'e0nh v\'fd\u7907\'3ft m\u7913\'3fc nh\u7919\'3fng thi\u7871\'3fu v\u7889\'3fn th}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
\'ec b\'e1o c\'e1o ngay v\u7873\'3f B\u7897\'3f L\'e2m nghi\u7879\'3fp, B\u7897\'3f L\'e2m nghi\u7879\'3fp x\'e9t v\'e0 b\'e0n v\u7899\'3fi B\u7897\'3f T\'e0i ch\'ednh vi\u7879\'3fc:
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 - \'d0i\u7873\'3fu ho\'e0 ti\u7873\'3fn v\u7889\'3fn c\u7911\'3fa ng\'e2n s\'e1ch ho\u7863\'3fc t\u7841\'3fm \u7913\'3fng v\u7889\'3fn ng\'e2n s\'e1ch cho \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7875\'3f tri
\u7875\'3fn khai ph\'e2n c\'f4ng vi\u7879\'3fc l\'e0m v\'fd\u7907\'3ft m\u7913\'3fc \'f0\'f3, n\u7871\'3fu x\'e9t s\u7889\'3f v\u7889\'3fn y\'eau c\u7847\'3fu th\'eam kh\'f4ng v\'fd\u7907\'3ft m\u7913\'3fc Ch\'ednh ph\u7911\'3f  \'f0}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 duy\u7879\'3ft cho c\u7843\'3f n}{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3m.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 - N\u7871\'3fu s\u7889\'3f v\u7889\'3fn y\'eau c\u7847\'3fu t\'e3ng th\'eam v\'fd\u7907\'3ft m\u7913\'3fc t\u7893\'3fng s\u7889\'3f v\u7889\'3fn chung Nh\'e0 n\'fd\u7899\'3fc \'f0}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 duy\u7879\'3ft cho c\u7843\'3f n}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3m B\u7897\'3f L\'e2m nghi\u7879\'3fp b\'e1o c\'e1o Nh\'e0 n\'fd\u7899\'3fc xin duy\u7879\'3ft b\u7893\'3f
 sung. Khi n\'e0o Nh\'e0 n\'fd\u7899\'3fc duy\u7879\'3ft \'f0\u7883\'3fa ph\'fd\'f5ng m\u7899\'3fi \'f0\'fd\u7907\'3fc ph\'e9p tri\u7875\'3fn kha}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 i c\'f4ng vi\u7879\'3fc l\'e0m th\'eam.
\par }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 - \'d0\u7871\'3fn cu\u7889\'3fi n\'e3m n\u7871\'3fu t\u7881\'3fnh n\'e0o kh\'f4ng ho\'e0n th\'e0nh k\u7871\'3f ho\u7841\'3fch, t\u7881\'3fnh ph\u7843\'3fi n\u7897\'3fp tr\u7843\'3f kinh ph\'ed th\u7915
\'3fa v\'e0o ng\'e2n s\'e1ch trung \'fd\'f5ng, kh\'f4ng \'f0\'fd\u7907\'3fc d\'f9ng s\u7889\'3f v\u7889\'3fn c}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f2n th\u7915\'3fa n\'e0y chi v\'e0o vi\u7879\'3fc kh\'e1c.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid4534230 {\b\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 
IV. NGUY\'caN T\u7854\'3fC, TH\u7910\'3f T\u7908\'3fC C\u7844\'3fP PH\'c1T, QU\u7842\'3fN L\'dd V\'c0 QUY\u7870\'3fT TO\'c1N TI\u7872\'3fN V\u7888\'3fN}{\b\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 :
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid13386600 {
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 1/ Nguy\'ean t\u7855\'3fc v\'e0 th\u7911\'3f t\u7909\'3fc c\u7845\'3fp ph\'e1t v\u7889\'3fn. C\'e3n  c\u7913\'3f v\'e0o k\u7871\'3f ho\u7841\'3fch n\'e3m \'f0}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc Ch\'ednh ph\u7911\'3f duy\u7879\'3ft, k\u7871\'3f ho\u7841\'3fch qu}{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd 
\'f0}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\u7907\'3fc B\u7897\'3f L\'e2m nghi\u7879\'3fp duy\u7879\'3ft v\'e0 th\'f4ng b\'e1o cho c\'e1c \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7875\'3f c\u7845\'3fp ph\'e1t b\u7843\'3fo \'f0\u7843\'3fm v
\u7889\'3fn cho c\'f4ng t\'e1c khai  hoang m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd.
\par \'d0\u7875\'3f ph\'f9 h\u7907\'3fp v\u7899\'3fi \'f0\u7863\'3fc \'f0i\u7875\'3fm s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd B\u7897\'3f T\'e0i ch\'ednh giao tr\'e1ch nhi\u7879\'3fm cho Ng\'e2n h
\'e0ng ki\u7871\'3fn thi\u7871\'3ft Vi\u7879\'3ft Nam th\u7889\'3fng nh\u7845\'3ft qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd c\u7843\'3f 2 lo\u7841\'3fi v\u7889\'3fn x\'e2y d\u7921\'3fng c}{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5 b\u7843\'3fn v\'e0 kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp. Khi nh\u7853\'3fn \'f0\'fd\u7907\'3fc v\u7889\'3fn tr\u7907\'3f c\u7845\'3fp c\u7911\'3fa ng\'e2n s\'e1ch trung \'fd\'f5ng Ty T\'e0i ch\'ed
nh ph\u7843\'3fi chuy\u7875\'3fn ngay v\u7889\'3fn sang chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft \'f0\u7875\'3f c\u7845\'3fp ph\'e1t. Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft c\'e3n c\u7913\'3f v\'e0o ch\u7871\'3f \'f0\u7897\'3f hi\u7879\'3fn h\'e0nh m
\u7903\'3f s\u7893\'3f s\'e1ch theo d}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5i ri\'eang t\u7915\'3fng lo\u7841\'3fi v\u7889\'3fn, t\u7893\'3f ch\u7913\'3fc vi\u7879\'3fc c\u7845\'3fp ph\'e1t, t}{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3ng c\'fd\u7901\'3fng qu\u7843\'3fn l}{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd, gi\'e1m \'f0\u7889\'3fc ch\u7863\'3ft ch\u7869\'3f vi\u7879\'3fc s\u7917\'3f d\u7909\'3fng v\u7889\'3fn}{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755  theo \'f0\'fang m\u7909\'3fc \'f0\'edch, \'f0\'fang ch\'ednh s\'e1ch ch\u7871\'3f \'f0\u7897\'3f, \'f0\'fang \'f0\u7883\'3fnh m\u7913\'3fc \'f0\'fd\u7907\'3fc duy\u7879\'3ft nh\u7857\'3fm \'f0em l\u7841
\'3fi hi\u7879\'3fu qu\u7843\'3f kinh t\u7871\'3f cao.
\par Do \'f0\u7863\'3fc \'f0i\u7875\'3fm c\u7911\'3fa s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp trong k\u7871\'3f ho\u7841\'3fch v\u7889\'3fn h\'e0ng n\'e3m \'f0\'fd\u7907\'3fc ghi m\u7897\'3ft s\u7889\'3f ti\u7873\'3fn xin \u7913\'3fng tr\'fd\u7899
\'3fc \'f0\u7875\'3f chu\u7849\'3fn b\u7883\'3f cho vi\u7879\'3fc tr\u7891\'3fng r\u7915\'3fng c\u7911\'3fa n\'e3m sau. M\u7913\'3fc t\u7841\'3fm \u7913\'3fng do B\u7897\'3f L\'e2m nghi\u7879\'3fp quy \'f0\u7883\'3fnh tu\u7923\'3f theo t\u7915\'3fng lo
\u7841\'3fi c\'e2y tr\u7891\'3fng. Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft c\u7847\'3fn theo d}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5i ch\u7863\'3ft ch\u7869\'3f cho vi\u7879\'3fc s\u7917\'3f d\u7909\'3fng s\u7889\'3f ti\u7873\'3fn t
\u7841\'3fm \u7913\'3fng n\'e0y }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7875\'3f tr\u7915\'3f d\u7847\'3fn v\'e0o v\u7889\'3fn c\u7845\'3fp ph\'e1t c\u7911\'3fa c\'e1c qu}{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd trong n
\'e3m sau.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 C\'e1c ph\'f2ng l\'e2m nghi\u7879\'3fp huy\u7879\'3fn (ho\u7863\'3fc Ban n\'f4ng l\'e2m nghi\u7879\'3fp huy\u7879\'3fn) c}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e1c ban \'f0\u7883\'3f
nh canh \'f0\u7883\'3fnh c\'fd huy\u7879\'3fn, c\'e1c x}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3, h\u7907\'3fp t\'e1c x\'e3 trong v\'f9ng kinh t\u7871\'3f m\u7899\'3fi l\'e2m nghi\u7879\'3fp, }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd ph\u7843\'3fi m\u7903\'3f t\'e0i kho\u7843\'3fn t\u7841\'3fi Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft \'f0\u7875\'3f nh\u7853\'3fn v\u7889\'3fn, theo d}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5i qu\u7843\'3fn l\'fd vi\u7879\'3fc s\u7917\'3f d\u7909\'3fng v\u7889\'3fn cho c\'f4ng t\'e1c n\'e0y.
\par Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft c\u7847\'3fn c\'f3 c\'e1c ti\u7875\'3fu kho\u7843\'3fn ri\'eang theo d\'f5i c\u7845\'3fp ph\'e1t v\u7873\'3f v\u7889\'3fn x\'e2y d\u7921\'3fng c}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5 b\u7843\'3f
n v\'e0 kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp. Vi\u7879\'3fc c\u7845\'3fp ph\'e1t chung ph\u7843\'3fi ch\u7845\'3fp h\'e0nh \'f0\'fang ch\u7871\'3f \'f0\u7897\'3f v\'e0 c\'e1c nguy\'ean t\u7855\'3fc th\u7911\'3f t\u7909\'3fc hi\u7879\'3fn h\'e0nh.

\par Ri\'eang \'f0\u7889\'3fi v\u7899\'3fi c\'f4ng t\'e1c x\'e2y d\u7921\'3fng c\'f5 b\u7843\'3fn do \'f0\u7863\'3fc \'f0i\u7875\'3fm s\u7843\'3fn xu\u7845\'3ft l\'e2m nghi\u7879\'3fp v\'e0 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd \u7903\'3f c\'e1c t\u7881
\'3fnh mi\u7873\'3fn n\'fai c\'f3 tr\'fd\u7901\'3fng h\u7907\'3fp \'f0\u7863\'3fc bi\u7879\'3ft: C\'e1c c\'f4ng tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh ch}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fda c\'f3 \'f0\u7911\'3f
 th\u7911\'3f t\u7909\'3fc v\'e0 tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh t\u7921\'3f x\'e2y d\u7921\'3fng c}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5 b\u7843\'3fn ph\u7843\'3fi \'f0\'fd\u7907\'3fc B\u7897\'3f L\'e2m nghi
\u7879\'3fp v\'e0 U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3fnh, th\'e0nh ph\u7889\'3f \'f0\u7891\'3fng }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd (tu\u7923\'3f theo s\u7921\'3f ph\'e2n c\u7845\'3fp hi\u7879\'3fn h\'e0nh c\u7911\'3fa Nh\'e0 n}
{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\u7899\'3fc) b\u7857\'3fng v\'e3n b\u7843\'3fn, x\'e1c \'f0\u7883\'3fnh r}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5 }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fa b
\'e0n, nhi\u7879\'3fm v\u7909\'3f bi\u7879\'3fn ph}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e1p k\u7929\'3f thu\u7853\'3ft, m\u7913\'3fc v\u7889\'3fn v\'e0 th\u7901\'3fi gian tr\'ecnh duy\u7879\'3ft nhi\u7879\'3fm v\u7909\'3f thi\u7871\'3ft k
\u7871\'3f m\u7899\'3fi }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft t\u7841\'3fm c\u7845\'3fp v\u7889\'3fn x\'e2y d\u7921\'3fng. Sau 1/3 th\u7901\'3fi gian thi c\'f4ng n\u7871\'3fu nhi
\u7879\'3fm v\u7909\'3f thi\u7871\'3ft k\u7871\'3f ch\'fda \'f0\'fd\u7907\'3fc tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh duy\u7879\'3ft th\'ec Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft s\u7869\'3f }{
\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh ch\u7881\'3f c\u7845\'3fp ph\'e1t v\u7889\'3fn. Tr}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\u7901\'3fng h\u7907\'3fp c\'f4
ng tr}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecn}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 h \'f0\'fd\u7907\'3fc ph\'e9p v\u7915\'3fa thi\u7871\'3ft k\u7871\'3f v\u7915\'3fa thi c\'f4ng th}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ec: Thi c\'f4ng b\u7897\'3f ph\u7853\'3fn n\'e0o ph\u7843\'3fi c\'f3 thi\u7871\'3ft k\u7871\'3f b\u7897\'3f ph\u7853\'3fn }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'f3.
\par 2/ Ch\u7871\'3f \'f0\u7897\'3f thanh quy\u7871\'3ft to\'e1n ti\u7873\'3fn v\u7889\'3fn.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 a. H\'e0ng qu\'fd c\'e1c Ph\'f2ng L\'e2m nghi\u7879\'3fp huy\u7879\'3fn (ho\u7863\'3fc Ban N\'f4ng l\'e2m nghi\u7879\'3fp huy\u7879\'3fn), Ban }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0
\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd huy\u7879\'3fn v\'e0 c\'e1c \'f0\'f5n v\u7883\'3f \'f0\'fd\u7907\'3fc c\u7845\'3fp v\u7889\'3fn x\'e2y d\u7921\'3fng c\'f5 b\u7843\'3fn, kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp ph\u7843\'3fi b\'e1o c\'e1o ch\'ed
nh th\u7913\'3fc t}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'ecnh h\'ecnh th\u7921\'3fc hi\u7879\'3fn k\u7871\'3f ho\u7841\'3fch v\'e0 s\u7917\'3f d\u7909\'3fng ti\u7873\'3fn v\u7889\'3fn v\u7899\'3fi Ty L\'e2m nghi\u7879\'3fp, Ban }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh. Ty L\'e2m nghi\u7879\'3fp, Ban \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh ph\u7843\'3fi t\u7893\'3fng h\u7907\'3fp g\u7917\'3f
i b\'e1o c\'e1o ch\'ednh th\u7913\'3fc v\'e0 U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3fnh, Ty T\'e0i ch\'ednh v\'e0 Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7891\'3fng g\u7917\'3fi v\u7873\'3f B\u7897\'3f L\'e2m nghi
\u7879\'3fp, B\u7897\'3f T\'e0i ch\'ednh v\'e0 Ng\'e2n h\'e0ng ki\u7871\'3fn thi\u7871\'3ft Trung \'fd\'f5ng.
\par b. H\'e0ng n\'e3m c\'e1c \'f0\'f5n v\u7883\'3f tr\u7921\'3fc ti\u7871\'3fp s\u7917\'3f d\u7909\'3fng v\u7889\'3fn \'f0\u7847\'3fu t\'fd h\u7895\'3f tr\u7907\'3f x\'e2y d\u7921\'3fng c\'f5 b\u7843\'3fn v\'e0 kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp n\'f3
i tr\'ean ph\u7843\'3fi l\u7853\'3fp b\'e1o c\'e1o quy\u7871\'3ft to\'e1n ri\'eang t\u7915\'3fng lo\u7841\'3fi v\u7889\'3fn theo ch\u7871\'3f \'f0\u7897\'3f hi\u7879\'3fn h\'e0nh v\u7899\'3fi Ty L\'e2m nghi\u7879\'3fp, Ban \'f0\u7883\'3fnh canh \'f0\u7883
\'3fnh c\'fd t\u7881\'3fnh. B\'e1o c\'e1o quy\u7871\'3ft to\'e1n ph\u7843\'3fi \'f0\'fd\u7907\'3fc Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft x\'e1c nh\u7853\'3fn s\u7889\'3f v\u7889\'3fn \'f0}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 c\u7845
\'3fp ph\'e1t v\'e0 c\'f3 \'fd ki\u7871\'3fn nh\u7853\'3fn x\'e9t v\u7873\'3f t\'ecnh h\'ecnh qu\u7843\'3fn l\'fd, s\u7917\'3f d\u7909\'3fng v\u7889\'3fn.
\par }{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 Ty L\'e2m nghi\u7879\'3fp, Ban \'f0\u7883\'3fnh ca}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 nh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh duy\u7879\'3ft v\'e0 t\u7893\'3fng h\u7907\'3fp quy\u7871
\'3ft to\'e1n ri\'eang t\u7915\'3fng lo\u7841\'3fi v\u7889\'3fn x\'e2y d\u7921\'3fng c\'f5 b\u7843\'3fn v\'e0 kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp g\u7917\'3fi: U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3fnh, Ty T\'e0i ch\'ednh, Chi h\'e0ng ki\u7871\'3f
n thi\u7871\'3ft \u7903\'3f \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7891\'3fng g\u7917\'3fi: B\u7897\'3f L\'e2m nghi\u7879\'3fp, B\u7897\'3f T\'e0i ch\'ednh v\'e0 Ng\'e2n h\'e0ng ki\u7871\'3fn thi\u7871\'3ft Trung \'fd\'f5ng.
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 C\'e1c T}{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 y T\'e0i ch\'ednh gi\'fap U\u7927\'3f ban nh\'e2n d\'e2n t\u7881\'3fnh x\'e9t duy\u7879\'3ft c\'e1c quy\u7871\'3ft to\'e1n n\'e0y v\'e0 t\u7893
\'3fng h\u7907\'3fp v\'e0o quy\u7871\'3ft to\'e1n chung c\u7911\'3fa ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7875\'3f quy\u7871\'3ft to\'e1n v\u7899\'3fi ng\'e2n s\'e1ch Nh\'e0 n\'fd\u7899\'3fc theo ch\u7871\'3f \'f0\u7897\'3f hi\u7879\'3fn h
\'e0nh.
\par C\'e3n c\u7913\'3f v\'e0o quy\u7871\'3ft to\'e1n do c\'e1c Ty L\'e2m nghi\u7879\'3fp, Ban \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 g\u7917\'3fi v\u7873\'3f, B\u7897\'3f L\'e2m nghi\u7879
\'3fp ph\u7843\'3fi t\u7893\'3fng h\u7907\'3fp to\'e0n ng\'e0nh v\u7873\'3f t\'ecnh h\'ecnh th\u7921\'3fc hi\u7879\'3fn k\u7871\'3f ho\u7841\'3fch v\'e0 c\'e1c ch\u7881\'3f ti\'eau k\u7871\'3f ho\u7841\'3fch ti\u7873\'3fn v\u7889\'3fn g\u7917\'3fi B\u7897
\'3f T\'e0i ch\'ednh v\'e0 Ng\'e2n h\'e0ng ki\u7871\'3fn thi\u7871\'3ft Trung }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\'f5ng.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid1014679 {\b\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 V. 
\'d0I\u7872\'3fU KHO\u7842\'3fN THI H\'c0NH.
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin0\lin0\itap0\pararsid13386600 {
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 Th\'f4ng t\'fd n\'e0y \'f0\'fd\u7907\'3fc thi h\'e0nh k\u7875\'3f t\u7915\'3f ng\'e0y 1/1/1978 nh\u7919\'3fng quy \'f0\u7883\'3fnh tr\'fd\u7899\'3fc \'f0\'e2y tr\'e1i v\u7899\'3fi th\'f4ng t\'fd n\'e0y 
\'f0\u7873\'3fu b}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3i b\u7887\'3f.
\par U\u7927\'3f ban nh\'e2n d\'e2n c\'e1c t\u7881\'3fnh, th\'e0nh ph\u7889\'3f c\'f3 tr\'e1ch nhi\u7879\'3fm tr\u7921\'3fc ti\u7871\'3fp trong vi\u7879\'3fc qu\u7843\'3fn l\'fd v\u7889\'3fn do ng\'e2n s\'e1ch Trung }{
\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'fd\'f5ng tr\u7907\'3f c\u7845\'3fp cho \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\u7875\'3f chi cho c\'f4ng t\'e1c khai hoang m\u7903\'3f r\u7897\'3fng di\u7879\'3fn t\'edch s\u7843\'3fn xu\u7845\'3ft l\'e2
m nghi\u7879\'3fp, th\u7921\'3fc hi\u7879\'3fn \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd theo \'f0\'fang k\u7871\'3f ho\u7841\'3fch \'f0\'fd\u7907\'3fc B\u7897\'3f L\'e2m nghi\u7879\'3fp duy\u7879\'3ft cho \'f0\u7883\'3fa ph\'fd\'f5ng, U\u7927\'3f
 ban nh\'e2n d\'e2n c\'e1c t\u7881\'3fnh c\u7847\'3fn nhanh ch\'f3ng c\u7911\'3fng c\u7889\'3f v\'e0 ki\u7871\'3fn to\'e0n t\u7893\'3f ch\u7913\'3fc b\u7897\'3f m\'e1y c\'e1c c\'f5 quan c\'f3 li\'ean quan \'f0\u7875\'3f l\'e0m t\u7889\'3ft c\'f4ng t\'e1
c n\'e0y; ch\u7881\'3f \'f0\u7841\'3fo Ty L\'e2m nghi\u7879\'3fp, Ban \'f0\u7883\'3fnh canh \'f0\u7883\'3fnh c\'fd t\u7881\'3fnh ki\u7875\'3fm t}{\f185\fs28\cgrid0\insrsid13192936\charrsid15956755 ra nh\u7919\'3fng vi\u7879\'3fc \'f0}{
\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'e3 l\'e0m }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fd\u7907\'3fc cho \'f0\u7871\'3fn ng\'e0y b\'e0n giao (1/1/1978) \'f0\u7875\'3f chuy\u7875\'3fn sang thi h\'e0nh ch\u7871\'3f \'f0
\u7897\'3f m\u7899\'3fi quy \'f0\u7883\'3fnh trong th\'f4ng t\'fd Li\'ean B\u7897\'3f n\'e0y, t\u7893\'3f ch\u7913\'3fc c\'f4ng t\'e1c ki\u7875\'3fm k\'ea, m\u7903\'3f \'f0\u7911\'3f c\'e1c s\u7893\'3f s\'e1ch c\u7847\'3fn thi\u7871\'3ft \'f0\u7875\'3f
 theo d}{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f5i qu\u7843\'3fn l\'fd chi ti\'eau theo }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0\'fang c\'e1c ngu\u7891\'3fn v\u7889\'3fn th\'edch h\u7907\'3fp v\'e0 c\'e1c nguy\'ean t\u7855
\'3fc th\u7911\'3f t\u7909\'3fc quy \'f0\u7883\'3fnh. 
\par }{\f0\fs28\cgrid0\insrsid13192936\charrsid15956755 C\'e1c Ty T\'e0i ch\'ednh, Ph\'f2ng T\'e0i ch\'ednh, c\'e1c Chi h\'e0ng ki\u7871\'3fn thi\u7871\'3ft, chi }{\f193\fs28\cgrid0\insrsid13192936\charrsid15956755 \'f0i\u7875\'3fm Ng\'e2n h\'e0ng ki\u7871\'3f
