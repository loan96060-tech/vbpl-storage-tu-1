\par }{\b\f0\insrsid9193529\charrsid9193529 II. C\'e1ch l\u7853\'3fp bi\u7875\'3fu m\u7851\'3fu:
\par }{\f0\insrsid9193529\charrsid9193529 1. B\'e1o c\'e1o c\u7911\'3fa Kho b\u7841\'3fc Nh\'e0 n}{\f60\insrsid9193529\charrsid9193529 \'fd\u7899\'3f}{\f0\insrsid9193529\charrsid9193529 c Trung }{\f60\insrsid9193529\charrsid9193529 \'fd\'f5}{
\f0\insrsid9193529\charrsid9193529 ng g\u7917\'3fi B\u7897\'3f T\'e0i ch\'ednh:
\par 1.1. Bi\u7875\'3fu 1A/BC: B\'e1o c\'e1o t\'ecnh h\'ecnh thanh to\'e1n v\u7889\'3fn }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7847\'3fu t}{\f60\insrsid9193529\charrsid9193529 \'fd}{\f0\insrsid9193529\charrsid9193529 
 XDCB h\'e0ng th\'e1ng.
\par - Th\u7901\'3fi gian b\'e1o c\'e1o: }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7883\'3fnh k\u7923\'3f h\'e0ng th\'e1ng, ch\u7853\'3fm nh\u7845\'3ft v\'e0o ng\'e0y 10 th\'e1ng sau.
\par - C\'e1ch l\u7845\'3fy s\u7889\'3f li\u7879\'3fu:
\par + C\u7897\'3ft s\u7889\'3f 2: ch\u7881\'3f ghi t\u7893\'3fng s\u7889\'3f }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7889\'3fi v\u7899\'3fi m\u7895\'3fi B\u7897\'3f, }{\f52\insrsid9193529\charrsid9193529 \'f0}{
\f0\insrsid9193529\charrsid9193529 \u7883\'3fa ph}{\f60\insrsid9193529\charrsid9193529 \'fd\'f5}{\f0\insrsid9193529\charrsid9193529 ng (kh\'f4ng chi ti\u7871\'3ft t\u7915\'3fng t\u7915\'3fng d\u7921\'3f \'e1n; ri\'eang b\'e1o c\'e1o th\'e1ng 3, 6, 9 c\'f3
 chi ti\u7871\'3ft t\u7915\'3fng d\u7921\'3f \'e1n).
\par + C\u7897\'3ft s\u7889\'3f 3: ghi theo s\u7889\'3f k\u7871\'3f ho\u7841\'3fch Nh\'e0 n}{\f60\insrsid9193529\charrsid9193529 \'fd\u7899\'3f}{\f0\insrsid9193529\charrsid9193529 c giao.
\par + C\u7897\'3ft s\u7889\'3f 4: ghi theo s\u7889\'3f th\'f4ng b\'e1o c\u7911\'3fa c}{\f60\insrsid9193529\charrsid9193529 \'f5}{\f0\insrsid9193529\charrsid9193529  quan t\'e0i ch\'ednh.
\par + C\u7897\'3ft s\u7889\'3f 5, 6, 7: ghi gi\'e1 tr\u7883\'3f kh\u7889\'3fi l}{\f60\insrsid9193529\charrsid9193529 \'fd\u7907\'3f}{\f0\insrsid9193529\charrsid9193529 ng XDCB ho\'e0n th\'e0nh c\'f3 phi\u7871\'3fu gi\'e1.
\par + C\u7897\'3ft s\u7889\'3f 8, 9, 10, 11, 12: bao g\u7891\'3fm c\u7843\'3f v\u7889\'3fn t\u7841\'3fm \u7913\'3fng ch}{\f60\insrsid9193529\charrsid9193529 \'fd}{\f0\insrsid9193529\charrsid9193529 a ho\'e0n tr\u7843\'3f.
\par 1.2. Bi\u7875\'3fu 1B/BC: B\'e1o c\'e1o t\'ecnh h\'ecnh thanh to\'e1n c\'e1c d\u7921\'3f \'e1n }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7847\'3fu t}{\f60\insrsid9193529\charrsid9193529 \'fd}{
\f0\insrsid9193529\charrsid9193529  nh\'f3m A.
\par - Th\u7901\'3fi gian b\'e1o c\'e1o: }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7883\'3fnh k\u7923\'3f h\'e0ng th\'e1ng, ch\u7853\'3fm nh\u7845\'3ft ng\'e0y 10 th\'e1ng sau v\'e0 b\'e1o c\'e1o }{
\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7897\'3ft xu\u7845\'3ft t\u7915\'3fng c\'f4ng tr\'ecnh c\u7909\'3f th\u7875\'3f (n\u7871\'3fu c\u7847\'3fn).
\par - C\'e1ch l\u7845\'3fy s\u7889\'3f li\u7879\'3fu:
\par + Ghi chi ti\u7871\'3ft theo B\u7897\'3f, }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7883\'3fa ph}{\f60\insrsid9193529\charrsid9193529 \'fd\'f5}{\f0\insrsid9193529\charrsid9193529 ng, d\u7921\'3f \'e1n.
\par + C\u7897\'3ft s\u7889\'3f 3: ghi theo s\u7889\'3f k\u7871\'3f ho\u7841\'3fch Nh\'e0 n}{\f60\insrsid9193529\charrsid9193529 \'fd}{\f0\insrsid9193529\charrsid9193529 \u7899\'3fc giao.
\par + C\u7897\'3ft s\u7889\'3f 4: ghi s\u7889\'3f th\'f4ng b\'e1o c\u7911\'3fa c}{\f60\insrsid9193529\charrsid9193529 \'f5}{\f0\insrsid9193529\charrsid9193529  quan t\'e0i ch\'ednh.
\par + C\u7897\'3ft s\u7889\'3f 6: k\u7875\'3f c\u7843\'3f s\u7889\'3f v\u7889\'3fn t\u7841\'3fm \u7913\'3fng ch}{\f60\insrsid9193529\charrsid9193529 \'fd}{\f0\insrsid9193529\charrsid9193529 a ho\'e0n tr\u7843\'3f.
\par 1.3. Bi\u7875\'3fu 1C/BC: B\'e1o c\'e1o t\'ecnh h\'ecnh thanh to\'e1n v\u7889\'3fn }{\f52\insrsid9193529\charrsid9193529 \'f0}{\f0\insrsid9193529\charrsid9193529 \u7847\'3fu t}{\f60\insrsid9193529\charrsid9193529 \'fd}{\f0\insrsid9193529\charrsid9193529 
 XDCB h\'e0ng n}{\f52\insrsid9193529\charrsid9193529 \'e3}{\f0\insrsid9193529\charrsid9193529 m (thay b\'e1o c\'e1o th\'e1ng 12):
\par - Th\u7901\'3fi gian b\'e1o c\'e1o: ch\u7853\'3fm nh\u7845\'3ft v\'e0o ng\'e0y 31/1 n}{\f52\insrsid9193529\charrsid9193529 \'e3}{\f0\insrsid9193529\charrsid9193529 m sau.
