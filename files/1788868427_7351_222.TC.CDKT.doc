\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid1139483 {\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 7 -}{\f286\fs28\cf0\insrsid4667741\charrsid150754  K
\u7871\'3f to\'e1n t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh ph\u7843\'3fi ghi s\u7893\'3f theo t\u7915\'3fng \'f0\u7889\'3fi t\'fd\u7907\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh (g\u7885\'3fi l\'e0 \'f0\u7889\'3fi t\'fd\u7907\'3f
ng ghi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh).}{\f0\fs28\cf0\insrsid4667741\charrsid150754 
\par }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'d0\u7889\'3fi t\'fd\u7907\'3fng ghi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh l\'e0 t\u7915\'3fng v\u7853\'3ft k\u7871\'3ft c\u7845\'3fu ho\'e0n ch\u7881\'3fnh v\u7899\'3fi t\u7845\'3ft c\u7843\'3f c
\'e1c v\u7853\'3ft g\'e1 l\u7855\'3fp v\'e0 ph\u7909\'3f t\'f9ng k\'e8m theo, ho\u7863\'3fc l\'e0 nh\u7919\'3fng v\u7853\'3ft th\u7875\'3f ri\'eang bi\u7879\'3ft v\u7873\'3f m\u7863\'3ft k\u7871\'3ft c\u7845\'3fu d\'f9ng \'f0\u7875\'3f th\u7921\'3fc hi
\u7879\'3fn nh\u7919\'3fng ch\u7913\'3fc n\'e3ng \'f0\u7897\'3fc l\u7853\'3fp nh\u7845\'3ft \'f0\u7883\'3fnh, ho\u7863\'3fc l\'e0 t\u7915\'3fng t\u7893\'3f h\u7907\'3fp bao g\u7891\'3fm nhi\u7873\'3fu v\u7853\'3ft k\u7871\'3ft c\u7845\'3fu h\u7907\'3fp th
\'e0nh c\'f9ng th\u7921\'3fc hi\u7879\'3fn m\u7897\'3ft ch\u7913\'3fc n\'e3ng nh\u7845\'3ft \'f0\u7883\'3fnh.
\par C\'e1c B\u7897\'3f, T\u7893\'3fng c\u7909\'3fc ch\u7911\'3f qu\u7843\'3fn c\'e3n c\u7913\'3f v\'e0o quy \'f0\u7883\'3fnh chung tr\'ean \'f0\'e2y v\'e0 b\u7843\'3fn ch\u7881\'3f d\u7851\'3fn (ph\u7909\'3f l\u7909\'3fc s\u7889\'3f 1), quy \'f0\u7883\'3fnh c
\u7909\'3f th\u7875\'3f \'f0\u7889\'3fi t\'fd\u7907\'3fng ghi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh cho t\u7915\'3fng lo\u7841\'3fi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh \'f0\u7875\'3f \'e1p d\u7909\'3fng th\u7889\'3fng nh\u7845\'3f
t cho c\'e1c x\'ed nghi\u7879\'3fp thu\u7897\'3fc ng\'e0nh m}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ecnh qu\u7843\'3fn l\'fd.}{\f0\fs28\cf0\insrsid8272184 
\par }{\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 8 -}{\f286\fs28\cf0\insrsid4667741\charrsid150754  M\u7895\'3fi \'f0\u7889\'3fi t\'fd\u7907\'3fng ghi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh kh\'f4ng ph\'e2n bi
\u7879\'3ft \'f0ang s\u7917\'3f d\u7909\'3fng hay d\u7921\'3f tr\u7919\'3f \'f0\u7873\'3fu ph\u7843\'3fi c\'f3 s\u7889\'3f hi\u7879\'3fu ri\'eang.
\par S\u7889\'3f hi\u7879\'3fu t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh l\'e0 m\u7897\'3ft t\u7853\'3fp h\u7907\'3fp s\u7889\'3f bao g\u7891\'3fm nhi\u7873\'3fu ch\u7919\'3f s\u7889\'3f s\u7855\'3fp x\u7871\'3fp theo m\u7897\'3ft th\u7913\'3f t\u7921
\'3f nh\u7845\'3ft \'f0\u7883\'3fnh \'f0\u7875\'3f ch\u7881\'3f lo\u7841\'3fi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh, nh\'f3m t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh v\'e0 \'f0\u7889\'3fi t\'fd\u7907\'3fng t\'e0i s\u7843\'3fn c\u7889
\'3f \'f0\u7883\'3fnh trong nh\'f3m. S\u7889\'3f hi\u7879\'3fu d\'e0nh cho m\u7895\'3fi nh\'f3m t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh ph\u7843\'3fi \'f0\u7911\'3f \'f0\u7875\'3f ghi nh\u7919\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3f
nh hi\u7879\'3fn c\'f3 v\'e0 nh\u7919\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh s\u7869\'3f t\'e3ng th\'eam trong nh\u7919\'3fng n\'e3m t\u7899\'3fi thu\u7897\'3fc nh\'f3m t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh \'f0\'f3.
\par \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng \'f0\u7889\'3fi t\'fd\u7907\'3fng ghi t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh g\u7891\'3fm nhi\u7873\'3fu b\u7897\'3f ph\u7853\'3fn ri\'eang l\u7867\'3f h\u7907\'3fp th\'e0nh, th}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ec ngo\'e0i s\u7889\'3f hi\u7879\'3fu chung c\u7911\'3fa }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7889\'3fi t\'fd\u7907\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh \'f0\'f3 c}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f2n c\'f3 th\u7875\'3f }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\'e1nh th\'eam s\u7889\'3f hi\u7879\'3fu ph\u7909\'3f cho t\u7915\'3fng}{\f0\fs28\cf0\insrsid4667741\charrsid150754  b\u7897\'3f ph
\u7853\'3fn.}{\f0\fs28\cf0\insrsid8272184 
\par }{\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 9 -}{\f286\fs28\cf0\insrsid4667741\charrsid150754  S\u7889\'3f hi\u7879\'3fu t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh do ph}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f2ng k\u7871\'3f to\'e1n ph\u7889\'3fi h\u7907\'3fp v\u7899\'3fi ph\'f2ng k\u7929\'3f thu\u7853\'3ft c}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f5 \'f0i\u7879\'3fn (ho\u7863\'3fc ph}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f2ng ch\u7913\'3fc n}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'e3ng t\'fd\'f5ng \u7913\'3fng) c\u7911\'3fa x\'ed nghi\u7879\'3fp x\'e2y d\u7921\'3fng v\'e0 do ph}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f2ng k\u7871\'3f to\'e1n qu\u7843\'3fn l\'fd }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7875\'3f ghi v\'e0o c\'e1c ch\u7913\'3fng t\u7915\'3f, c\'e1c s\u7893\'3f k\u7871\'3f to\'e1n t\'e0i s\u7843\'3f
