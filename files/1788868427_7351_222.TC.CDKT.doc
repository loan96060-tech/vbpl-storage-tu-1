nh trong n\u7897\'3fi b\u7897\'3f x\'ed nghi\u7879\'3fp. Sau khi c\'f3 ch\u7919\'3f k}{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'fd c\u7911\'3fa \'f0\u7841\'3fi di\u7879\'3fn b}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'ean giao, b\'ean nh\u7853
\'3fn v\'e0 Gi\'e1m \'f0\u7889\'3fc x\'ed nghi\u7879\'3fp duy\u7879\'3ft y, bi\'ean b\u7843\'3fn \'f0\'fd\u7907\'3fc chuy\u7875\'3fn v\u7873\'3f ph}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f2ng k\u7871\'3f to\'e1n x\'ed nghii\u7879\'3fp.
\par }{\f286\fs28\cf0\insrsid4667741\charrsid150754 C\'e3n c\u7913\'3f v\'e0o bi\'ean b\u7843\'3fn di chuy\u7875\'3fn t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh trong n\u7897\'3fi b\u7897\'3f x\'ed nghi\u7879\'3fp, k\u7871\'3f to\'e1n ghi s\u7889\'3f hi
\u7879\'3fu bi\'ean b\u7843\'3fn di chuy\u7875\'3fn v\'e0 nh\u7919\'3fng n\u7897\'3fi dung c\u7847\'3fn thi\u7871\'3ft v\'e0o th\u7867\'3f v\'e0 s\u7893\'3f t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh, \'f0\u7891\'3fng th\u7901\'3fi chuy\u7875\'3f
n th\u7867\'3f t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh t\u7915\'3f ng\'e3n th\u7867\'3f c\u7911\'3fa b\u7897\'3f ph\u7853\'3fn s\u7917\'3f d\u7909\'3fng c\u361\'3f sang ng\'e3n th\u7867\'3f c\u7911\'3fa b\u7897\'3f ph\u7853\'3fn s\u7917\'3f d
\u7909\'3fng m\u7899\'3fi. C\'e1c chi ph\'ed c\'f3 li\'ean quan \'f0\u7871\'3fn vi\u7879\'3fc di chuy\u7875\'3fn t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh trong n\u7897\'3fi b\u7897\'3f x\'ed nghi\u7879\'3fp (chi ph\'ed v\u7873\'3f th\'e1o d\u7905
\'3f, v\u7853\'3fn chuy\u7875\'3fn, l\u7855\'3fp \'f0\u7863\'3ft....) \'f0\'fd\u7907\'3fc h\u7841\'3fch to\'e1n v\'e0o c\'e1c t\'e0i kho\u7843\'3fn chi ph\'ed s\u7843\'3fn xu\u7845\'3ft li\'ean quan ho\u7863\'3fc t\'e0i kho\u7843\'3fn chi ph\'ed l\'fdu th
\'f4ng.}{\f0\fs28\cf0\insrsid8272184 
\par }{\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 65-}{\f286\fs28\cf0\insrsid4667741\charrsid150754  M\u7885\'3fi tr\'fd\u7901\'3fng h\u7907\'3fp gi\u7843\'3fm t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh n\'f3i \u7903
\'3f c\'e1c \'d0i\u7873\'3fu 55, 60, 62, 63 tr\'ean \'f0\'e2y \'f0\u7873\'3fu d\u7851\'3fn \'f0\u7871\'3fn s\u7921\'3f gi\u7843\'3fm v\u7889\'3fn c\u7889\'3f \'f0\u7883\'3fnh c\u7911\'3fa x\'ed nghi\u7879\'3fp, v}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ec v\u7853\'3fy ph\'f2ng k\u7871\'3f to\'e1n x\'ed nghi\u7879\'3fp ph\u7843\'3fi th\'f4ng qua vi\u7879\'3fc ghi ch\'e9p k\u7871\'3f to\'e1n h\'e0ng ng\'e0y,  ki\u7875\'3fm tra gi\'e1m s\'e1t ch\u7863\'3ft ch
\u7869\'3f c\'e1c th\u7911\'3f t\u7909\'3fc xu\u7845\'3ft t\'e0i s\u7843\'3fn c\u7889\'3f }{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7883\'3fnh quy \'f0\u7883\'3fnh trong ch\u7871\'3f \'f0\u7897\'3f}{\f0\fs28\cf0\insrsid4667741\charrsid150754 
 qu\u7843\'3fn l\'fd t\'e0i s\u7843\'3fn hi\u7879\'3fn h\'e0nh c\u7911\'3fa Nh\'e0 n}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'fd\u7899\'3fc; t\'ednh to\'e1n x\'e1c \'f0\u7883\'3fnh l\u7907\'3fi \'edch v\'e0 thi\u7879\'3ft h\u7841\'3fi x\u7843\'3f
y ra trong t\u7915\'3fng tr\'fd\u7901\'3fng h\u7907\'3fp thanh l}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'fd, nh}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'fd\u7907\'3fng b\'e1n ho\u7863\'3fc chuy\u7875\'3fn giao t\'e0i s\u7843\'3fn c\u7889\'3f 
\'f0\u7883\'3fnh, tr\'ean c\'f5 s\u7903\'3f \'f0\'f3 \'f0\u7873\'3f ngh\u7883\'3f Gi\'e1m \'f0\u7889\'3fc x\'ed nghi\u7879\'3fp ra quy\u7871\'3ft \'f0\u7883\'3fnh x\u7917\'3f l}{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'fd c\'f3 hi\u7879\'3fu qu
\u7843\'3f nh\u7845\'3ft \'f0\u7889\'3fi v\u7899\'3fi t\u7915\'3fng }{\f286\fs28\cf0\insrsid4667741\charrsid150754 tr\'fd\u7901\'3fng h\u7907\'3fp \'f0\u7863\'3ft ra.}{\f0\fs28\cf0\insrsid8272184 
\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid3690937 {\b\f286\fs28\expnd5\expndtw28\cf0\insrsid4667741\charrsid150754 CH\'dd\'d5NG VIII\line KI\u7874\'3fM K\'ca T\'c0I S\u7842\'3fN C\u7888\'3f \'d0\u7882\'3fNH}{
