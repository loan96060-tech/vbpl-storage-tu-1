ng c\u7911\'3fa m\'e1y m\'f3c thi\u7871\'3ft}{\f286\fs28\cf0\insrsid4667741\charrsid150754  b\u7883\'3f do c\'f4ng nh\'e2n \'f0\u7913\'3fng m\'e1y, ng\'fd\u7901\'3fi ph\u7909\'3f tr\'e1ch ch\'ednh c\u7911\'3fa m\'e1y (tr\'fd\u7901\'3fng h\u7907\'3fp m
\u7897\'3ft m\'e1y do nhi\u7873\'3fu c\'f4ng nh\'e2n \'f0i\u7873\'3fu khi\u7875\'3fn) ho\u7863\'3fc t\u7893\'3f tr\'fd\u7903\'3fng s\u7843\'3fn xu\u7845\'3ft (tr\'fd\u7901\'3fng h\u7907\'3fp c\u7843\'3f t\u7893\'3f s\u7843\'3fn xu\u7845\'3ft \'f0i\u7873
\'3fu khi\u7875\'3fn m\u7897\'3ft m\'e1y) ghi ch\'e9p h\'e0ng ng\'e0y c\'e3n c\u7913\'3f v\'e0o t}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ecnh h\'ecnh ho\u7841\'3ft }{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7897\'3fng th\u7921\'3fc t
\u7871\'3f c\u7911\'3fa m\'e1y m\'f3c thi\u7871\'3ft b}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \u7883\'3f do m\'ecnh ph\u7909\'3f tr\'e1ch v\'e0 s\u7889\'3f l}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'fd\u7907\'3fng s\u7843\'3fn ph\u7849\'3f
m (ho\u7863\'3fc kh\u7889\'3fi l\'fd\u7907\'3fng c\'f4ng vi\u7879\'3fc) ho\'e0n th\'e0nh \'f0}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'e3 }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\'fd\u7907\'3fc ki\u7875\'3fm tra k\u7929\'3f thu\u7853\'3ft.

\par Cu\u7889\'3fi m\u7895\'3fi ca, t\u7893\'3f tr\'fd\u7903\'3fng s\u7843\'3fn xu\u7845\'3ft k}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'fd x\'e1c nh\u7853\'3fn v\'e0 chuy\u7875\'3fn c\'e1c ch\u7913\'3fng t\u7915\'3f theo d\'f5i ho\u7841\'3ft }{
\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7897\'3fng c\u7911\'3fa m\'e1y m\'f3c thi\u7871\'3ft b\u7883\'3f cho nh\'e2n vi\'ean h\u7841\'3fch to\'e1n ph\'e2n x\'fd\u7903\'3fng (\'f0\u7897\'3fi).}{\f0\fs28\cf0\insrsid8272184 
\par }{\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 31 -}{\f286\fs28\cf0\insrsid4667741\charrsid150754  C\'e3n c\u7913\'3f v\'e0o c\'e1c ch\u7913\'3fng t\u7915\'3f theo d}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f5i ho
\u7841\'3ft }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7897\'3fng c\u7911\'3fa m\'e1y m\'f3c thi\u7871\'3ft b\u7883\'3f nh\u7853\'3fn \'f0\'fd\u7907\'3fc h\'e0ng ng\'e0y, nh\'e2n vi\'ean h\u7841\'3fch to\'e1n ph\'e2n x\'fd\u7903\'3fng, \'f0
\u7897\'3fi s\u7843\'3fn xu\u7845\'3ft ghi s\u7893\'3f t\u7893\'3fng h\u7907\'3fp s\u7917\'3f d\u7909\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh c\u7911\'3fa t\u7915\'3fng t\u7893\'3f, \'f0\u7897\'3fi, ph\'e2n x\'fd\u7903\'3fng v\'e0 h\'e0
ng ng\'e0y ho\u7863\'3fc \'f0\u7883\'3fnh k\u7923\'3f 3 ho\u7863\'3fc 5 ng\'e0y m\u7897\'3ft l\u7847\'3fn (tu\u7923\'3f theo y\'eau c\u7847\'3fu c\u7909\'3f th\u7875\'3f \u7903\'3f m\u7895\'3fi x\'ed nghi\u7879\'3fp) b\'e1o c\'e1o qu\u7843\'3fn \'f0\u7889
\'3fc ph\'e2n x\'fd\u7903\'3fng, \'f0\u7897\'3fi tr\'fd\u7903\'3fng s\u7843\'3fn xu\u7845\'3ft v\u7873\'3f t}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ecnh h\'ecnh s\u7917\'3f d\u7909\'3fng m\'e1y m\'f3c thi\u7871\'3ft b\u7883\'3f trong ph\'e2n x}{
\f286\fs28\cf0\insrsid4667741\charrsid150754 \'fd\u7903\'3fng, \'f0\u7897\'3fi s\u7843\'3fn xu\u7845\'3ft, \'f0\u7891\'3fng th\u7901\'3fi l\u7853\'3fp b\'e1o c\'e1o t\u7893\'3fng h\u7907\'3fp s\u7917\'3f d\u7909\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0
\u7883\'3fnh k\'e8m theo c\'e1c ch\u7913\'3fng t\u7915\'3f theo d}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'f5i ho\u7841\'3ft }{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7897\'3f}{\f0\fs28\cf0\insrsid4667741\charrsid150754 ng c\u7911\'3fa m
\'e1y m\'f3c thi\u7871\'3ft b\u7883\'3f v\'e0 c\'e1c ki\u7871\'3fn ngh\u7883\'3f g\u7917\'3fi v\u7873\'3f ph\'f2ng k\u7871\'3f to\'e1n x\'ed nghi\u7879\'3fp }{\f278\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7875\'3f t\u7893\'3fng h\u7907\'3fp t}{
\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ecnh h\'ecnh s\u7917\'3f d\u7909\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0\u7883\'3fnh trong to\'e0n x\'ed nghi\u7879\'3fp.}{\f0\fs28\cf0\insrsid8272184 
\par }{\b\f278\fs28\expnd4\expndtw24\cf0\insrsid4667741\charrsid150754 \'d0i\u7873\'3fu 32 -}{\f278\fs28\cf0\insrsid4667741\charrsid150754  \'d0\u7883\'3fnh k\u7923\'3f (n\'e3m, qu\'fd, th\'e1ng ...) t\u7915\'3fng x\'ed nghi\u7879\'3fp, t\u7915\'3fng ph\'e2n x
}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'fd\u7903\'3fng, t\u7893\'3f, \'f0\u7897\'3fi s\u7843\'3fn xu\u7845\'3ft ph\u7843\'3fi t\u7893\'3f ch\u7913\'3fc cho qu\u7847\'3fn ch\'fa}{\f0\fs28\cf0\insrsid4667741\charrsid150754 ng ph\'e2n t\'edch t\'ec
nh h\'ecnh s\u7917\'3f d\u7909\'3fng m\'e1y m\'f3c thi\u7871\'3ft b\u7883\'3f trong th\'e1ng, qu\'fd, n}{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'e3m \u7903\'3f \'f0\'f5n v\u7883\'3f m}{\f0\fs28\cf0\insrsid4667741\charrsid150754 \'ecnh, x\'e1c nh
\u7853\'3fn th\'e0nh t\'edch, khuy\u7871\'3ft }{\f286\fs28\cf0\insrsid4667741\charrsid150754 \'f0i\u7875\'3fm, \'f0\'e1nh gi\'e1 ti\u7873\'3fm n\'e3ng v\'e0 bi\u7879\'3fn ph\'e1p huy \'f0\u7897\'3fng s\u7917\'3f d\u7909\'3fng h\u7871\'3ft ti\u7873\'3fm n
\'e3ng.
\par }{\f0\fs28\cf0\insrsid4667741\charrsid150754 Nh\u7919\'3fng s\u7889\'3f li\u7879\'3fu, t\'e0i li\u7879\'3fu ch\u7911\'3f y\u7871\'3fu c\u7847\'3fn thi\u7871\'3ft cho vi\u7879\'3fc ph\'e2n t\'edch g\u7891\'3fm:
\par - T\u7893\'3fng }{\f286\fs28\cf0\insrsid4667741\charrsid150754 s\u7889\'3f t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh hi\u7879\'3fn c\'f3 v\'e0 vi\u7879\'3fc ph\'e2n b\u7893\'3f, s\u7917\'3f d\u7909\'3fng t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883
\'3fnh trong x\'ed nghi\u7879\'3fp;
\par - S\u7889\'3f l\'fd\u7907\'3fng v\'e0 c\'f4ng su\u7845\'3ft t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh \'f0\'fd\u7907\'3fc huy \'f0\u7897\'3fng s\u7917\'3f d\u7909\'3fng so v\u7899\'3fi s\u7889\'3f l\'fd\u7907\'3fng v\'e0 c\'f4ng su\u7845\'3ft t\'e0
i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh hi\u7879\'3fn c\'f3;
\par - Th\u7901\'3fi gian l\'e0m vi\u7879\'3fc th\u7921\'3fc t\u7871\'3f c\u7911\'3fa t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh so v\u7899\'3fi t\u7893\'3fng qu\u7929\'3f th\u7901\'3fi gian theo ch\u7871\'3f \'f0\u7897\'3f, th\u7901\'3fi gian ng\u7915
\'3fng vi\u7879\'3fc theo c\'e1c nguy\'ean nh\'e2n;
\par - Gi\'e1 tr\u7883\'3f s\u7843\'3fn l\'fd\u7907\'3fng l\'e0m ra tr\'ean m\u7897\'3ft \'f0\'f5n v\u7883\'3f gi\'e1 tr\u7883\'3f t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh;
\par - M\u7913\'3fc l\u7907\'3fi nhu\u7853\'3fn thu \'f0\'fd\u7907\'3fc tr\'ean m\u7897\'3ft \'f0\'f5n v\u7883\'3f gi\'e1 tr\u7883\'3f t\'e0i s\u7843\'3fn c\u7889\'3f \'f0\u7883\'3fnh.
\par }{\f0\fs28\cf0\insrsid4667741\charrsid150754 V\'e0 c\'e1c s\u7889\'3f li\u7879\'3fu, t\'e0i li\u7879\'3fu c\u7847\'3fn thi\u7871\'3ft kh\'e1c theo y\'eau c\u7847\'3fu cu\u7843\'3f t\u7915\'3fng l\u7847\'3fn ph\'e2n t\'edch.}{\f0\fs28\cf0\insrsid8272184 

\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid11424825 {\b\f286\fs28\expnd5\expndtw28\cf0\insrsid4667741\charrsid150754 CH\'dd\'d5NG N\'c3M\line K\u7870\'3f TO\'c1N KH\u7844\'3fU HAO V\'c0 GI\'c1 TR\u7882\'3f HAO M}{
