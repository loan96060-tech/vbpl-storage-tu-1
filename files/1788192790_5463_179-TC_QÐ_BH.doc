\'e2y ra l\'e0m:
\par a. Thi\u7879\'3ft h\u7841\'3fi c\u7847\'3fu c\u7843\'3fng, k\'e8, c\u7889\'3fng, b\'e8 m\u7843\'3f}{\f251\insrsid9579906\charrsid9579906 ng, gi\'e0ng \'f0\'e1y, \'f0\'ea \'f0}{\f0\insrsid9579906\charrsid9579906 \u7853\'3fp, c\'f4ng tr\'ecnh tr\'ean b
\u7901\'3f}{\f251\insrsid9579906\charrsid9579906 , d\'fd}{\f0\insrsid9579906\charrsid9579906 \u7899\'3f}{\f251\insrsid9579906\charrsid9579906 i n\'fd}{\f0\insrsid9579906\charrsid9579906 \u7899\'3fc, c\u7889\'3f}{\f243\insrsid9579906\charrsid9579906  \'f0}
{\f0\insrsid9579906\charrsid9579906 \u7883\'3fnh ho\u7863\'3f}{\f243\insrsid9579906\charrsid9579906 c di \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng.
\par b. B\u7883\'3f}{\f251\insrsid9579906\charrsid9579906  th\'fd\'f5ng ho}{\f0\insrsid9579906\charrsid9579906 \u7863\'3fc thi\u7879\'3ft h\u7841\'3fi t\'ednh m\u7841\'3f}{\f251\insrsid9579906\charrsid9579906 ng ng\'fd}{\f0\insrsid9579906\charrsid9579906 
\u7901\'3fi th\u7913\'3f ba kh\'e1c (tr\u7915\'3f thuy\u7873\'3fn vi\'ean thu\u7897\'3fc bi\'ean ch\u7871\'3f ho\u7863\'3fc nh\u7919\'3f}{\f251\insrsid9579906\charrsid9579906 ng ng\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3f}{
\f251\insrsid9579906\charrsid9579906 i \'f0i tr\'ean t\'e0u thuy}{\f0\insrsid9579906\charrsid9579906 \u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3fm).
\par c. Nh\u7919\'3fng kho\u7843\'3fn chi ph\'ed ph\u7843\'3fi tr\u7843\'3f do s\u7921\'3f c\u7889\'3f}{\f251\insrsid9579906\charrsid9579906  \'f0\'e2m va l\'e0m cho t\'e0u thuy}{\f0\insrsid9579906\charrsid9579906 \u7873\'3fn kh\'e1c:
\par c.1. Thi\u7879\'3ft h\u7841\'3f}{\f251\insrsid9579906\charrsid9579906 i, h\'fd h}{\f0\insrsid9579906\charrsid9579906 \u7887\'3fng v\u7853\'3ft ch\u7845\'3ft, l\'e0m thi\u7879\'3ft h\u7841\'3fi kinh doanh l\'e0m m\u7845\'3ft gi\'e1 tr\u7883\'3f s\u7917\'3f
 d\u7909\'3fng.
\par c.2. Thi\u7879\'3ft h\u7841\'3fi h\'e0ng ho\'e1, t\'e0i s\u7843\'3fn tr\'ean t\'e0u thuy\u7873\'3fn b\u7883\'3f}{\f243\insrsid9579906\charrsid9579906  \'f0\'e2m va.
\par }{\f0\insrsid9579906\charrsid9579906 c.3. T\'e0u thuy\u7873\'3fn, h\'e0ng ho\'e1, t\'e0i s\u7843\'3fn b\u7883\'3f}{\f243\insrsid9579906\charrsid9579906  \'f0}{\f0\insrsid9579906\charrsid9579906 \u7855\'3fm ph\u7843\'3fi tr\u7909\'3fc v\u7899\'3ft, di chuy
\u7875\'3fn ho\u7863\'3fc ph\'e1 hu\u7927\'3f.
\par c.4. Tr\'e1ch nhi\u7879\'3fm v\u7873\'3f \'f4 nhi\u7877\'3fm d\u7847\'3fu.
\par c.5. G\'e2y ch\u7871\'3f}{\f251\insrsid9579906\charrsid9579906 t ng\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3fi, b\u7883\'3f}{\f251\insrsid9579906\charrsid9579906  th\'fd\'f5ng.
\par }{\f0\insrsid9579906\charrsid9579906 c.6. Nh\u7919\'3fng chi ph\'ed li\'ean quan t\u7893\'3fn th\u7845\'3ft chung v\'e0 chi ph\'ed c\u7913\'3fu n\u7841\'3fn.
\par 
\par }\pard \qj \fi720\li0\ri0\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f243\fs26\expnd4\expndtw24\insrsid9579906\charrsid9579906 \'d0i}{\b\f0\fs26\expnd4\expndtw24\insrsid9579906\charrsid9579906 \u7873\'3fu 4.}{
\f0\insrsid9579906\charrsid9579906  M\u7903\'3f r\u7897\'3fng ph\u7841\'3fm vi b\u7843\'3fo hi\u7875\'3fm
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid9579906\charrsid9579906 BAOVIET m\u7903\'3f r\u7897\'3fng tr\'e1ch nhi\u7879\'3fm b\u7891\'3f}{\f251\insrsid9579906\charrsid9579906 i th\'fd}{
\f0\insrsid9579906\charrsid9579906 \u7901\'3fng t\u7893\'3fn th\u7845\'3ft x\u7843\'3fy ra khi:
\par 1. T\'e0u thuy\u7873\'3fn bu\u7897\'3fc ph\u7843\'3fi ch\u7841\'3fy b\u7857\'3fng bu\u7891\'3f}{\f243\insrsid9579906\charrsid9579906 m hay \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3f}{\f251\insrsid9579906\charrsid9579906 ng c\'f5, ho}{
\f0\insrsid9579906\charrsid9579906 \u7863\'3fc k\u7871\'3ft h\u7907\'3fp c\'f9ng m\u7897\'3ft l\'fac c\u7843\'3f 2 lo\u7841\'3f}{\f251\insrsid9579906\charrsid9579906 i \'f0\'f3 trong ho\'e0n c}{\f0\insrsid9579906\charrsid9579906 \u7843\'3fnh v\'e0 l\'fd
 do ch\'ednh }{\f243\insrsid9579906\charrsid9579906 \'f0\'e1ng.
\par }{\f0\insrsid9579906\charrsid9579906 2. Lai k\'e9o v\'e0 tr\u7907\'3f gi\'fap t\'e0u thuy\u7873\'3fn kh\'e1c khi g\u7863\'3fp tai n\u7841\'3fn. Nh\u7919\'3f}{\f251\insrsid9579906\charrsid9579906 ng h\'fd h}{\f0\insrsid9579906\charrsid9579906 \u7887\'3f
ng, m\u7845\'3ft m\'e1t v\'e0 t\u7893\'3fn th\u7845\'3ft v\u7853\'3ft ch\u7845\'3ft x\u7843\'3fy ra trong th\u7901\'3fi gian n\'e0y ch\u7881\'3f thu\u7897\'3fc tr\'e1ch nhi\u7879\'3fm b\u7843\'3fo hi\u7875\'3fm ph\u7847\'3fn chi ph\'ed s\u7917\'3fa ch
\u7919\'3f}{\f251\insrsid9579906\charrsid9579906 a m\'e0 Ng\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3f}{\f251\insrsid9579906\charrsid9579906 i \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3fm kh\'f4ng thu h\u7891
\'3f}{\f251\insrsid9579906\charrsid9579906 i \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3f}{\f243\insrsid9579906\charrsid9579906 c \'f0}{\f0\insrsid9579906\charrsid9579906 \u7847\'3f}{\f243\insrsid9579906\charrsid9579906 y \'f0}{
\f0\insrsid9579906\charrsid9579906 \u7911\'3f}{\f251\insrsid9579906\charrsid9579906  do ph\'eda \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc c\u7913\'3fu gi\'fap th\u7921\'3fc s\u7921\'3f}{\f243\insrsid9579906\charrsid9579906  kh\'f4ng \'f0}{
\f0\insrsid9579906\charrsid9579906 \u7911\'3f kh\u7843\'3f}{\f243\insrsid9579906\charrsid9579906  n\'e3ng ho}{\f0\insrsid9579906\charrsid9579906 \'e0n tr\u7843\'3f.
\par 3. T\'e0u thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3f}{\f243\insrsid9579906\charrsid9579906 m \'f0\'e2m va v}{\f0\insrsid9579906\charrsid9579906 \u7899\'3fi t
\'e0u thuy\u7873\'3fn c\'f9ng ch\u7911\'3f ho\u7863\'3fc c\'f9ng quy\u7873\'3fn qu\u7843\'3fn l\'fd ho\u7863\'3f}{\f251\insrsid9579906\charrsid9579906 c \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc nh\u7919\'3fng t\'e0u thuy\u7873\'3f}{
\f251\insrsid9579906\charrsid9579906 n nh\'fd v}{\f0\insrsid9579906\charrsid9579906 \u7853\'3fy c\u7913\'3fu h\u7897\'3f.
\par 4. T\'e0u thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3fm c\u7843\'3f}{\f251\insrsid9579906\charrsid9579906  trong tr\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901
\'3fng h\u7907\'3fp:
\par a. C\'f3 s\u7921\'3f}{\f243\insrsid9579906\charrsid9579906  thay \'f0}{\f0\insrsid9579906\charrsid9579906 \u7893\'3fi v\u7873\'3f vi\u7879\'3f}{\f243\insrsid9579906\charrsid9579906 c \'f0\'e1nh b}{\f0\insrsid9579906\charrsid9579906 \u7855\'3ft h\u7843\'3f
i s\u7843\'3fn, v\u7873\'3f ng\'e0y kh\u7903\'3fi h\'e0nh (b\u7843\'3fo hi\u7875\'3fm chuy\u7871\'3fn), v\u7873\'3f ph\u7841\'3fm vi ho\u7841\'3f}{\f243\insrsid9579906\charrsid9579906 t \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng, lai d\u7855
\'3ft.
\par b. X\u7871\'3fp, d\u7905\'3f s\u7843\'3fn ph\u7849\'3fm h\u7843\'3fi s\u7843\'3fn ho\u7863\'3fc nhi\'ean v\u7853\'3ft li\u7879\'3fu \u7903\'3f ngo\'e0i bi\u7875\'3fn sang t\'e0u thuy\u7873\'3fn kh\'e1c ho\u7863\'3fc t\u7915\'3f t\'e0u thuy\u7873\'3fn kh
\'e1c sang t\'e0u thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3fm.
\par }{\f251\insrsid9579906\charrsid9579906 Nh\'fdng v}{\f0\insrsid9579906\charrsid9579906 \u7899\'3f}{\f243\insrsid9579906\charrsid9579906 i \'f0i}{\f0\insrsid9579906\charrsid9579906 \u7873\'3fu ki\u7879\'3fn ph\u7843\'3f}{
\f251\insrsid9579906\charrsid9579906 i th\'f4ng b\'e1o tr\'fd}{\f0\insrsid9579906\charrsid9579906 \u7899\'3fc v\'e0 tho\u7843\'3f thu\u7853\'3fn s\u7917\'3f}{\f243\insrsid9579906\charrsid9579906 a \'f0}{\f0\insrsid9579906\charrsid9579906 \u7893\'3fi b
\u7893\'3f sung v\'e0 tr\u7843\'3f th\'eam ph\'ed b\u7843\'3fo hi\u7875\'3fm.
\par 
\par }\pard \qc \li0\ri0\sb120\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f251\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 CH\'dd\'d5NG III\line KH\'d4NG THU}{\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 \u7896\'3fC TR
\'c1CH NHI\u7878\'3fM B\u7842\'3fO HI\u7874\'3fM}{\f0\insrsid9579906\charrsid9579906 
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid9579906\charrsid9579906 
\par }\pard \qj \fi720\li0\ri0\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f243\fs26\expnd4\expndtw24\insrsid9579906\charrsid9579906 \'d0i}{\b\f0\fs26\expnd4\expndtw24\insrsid9579906\charrsid9579906 \u7873\'3fu 5.}{
\f0\insrsid9579906\charrsid9579906  \'e1p d\u7909\'3fng cho 4 lo\u7841\'3fi b\u7843\'3fo hi\u7875\'3f}{\f251\insrsid9579906\charrsid9579906 m trong ch\'fd\'f5ng II
\par }\pard \qc \li0\ri0\sb120\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 A. BAOVIET KH\'d4NG CH\u7882\'3fU TR\'c1CH NHI\u7878\'3fM B\u7890\'3f}{
\b\f251\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 I TH\'dd}{\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 \u7900\'3fNG \line N\u7870\'3fU T\u7892\'3fN TH\u7844\'3fT X\u7842\'3f}{
\b\f251\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 Y RA DO NGUY\'caN NH\'c2N SAU \'d0\'c2Y:
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f0\insrsid9579906\charrsid9579906 
\par 1. T\'e0u thuy\u7873\'3f}{\f243\insrsid9579906\charrsid9579906 n kh\'f4ng \'f0}{\f0\insrsid9579906\charrsid9579906 \u7911\'3f kh\u7843\'3f}{\f243\insrsid9579906\charrsid9579906  n\'e3ng ho}{\f0\insrsid9579906\charrsid9579906 \u7841\'3f}{
\f243\insrsid9579906\charrsid9579906 t \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng, kh\'f4ng c\'f3 gi\u7845\'3fy ph\'e9p ho\u7841\'3f}{\f243\insrsid9579906\charrsid9579906 t \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng ho\u7863\'3fc ho
\u7841\'3f}{\f243\insrsid9579906\charrsid9579906 t \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng ngo\'e0i ph\u7841\'3f}{\f243\insrsid9579906\charrsid9579906 m vi quy \'f0}{\f0\insrsid9579906\charrsid9579906 \u7883\'3fnh.
\par }{\f251\insrsid9579906\charrsid9579906 2. H\'e0nh \'f0}{\f0\insrsid9579906\charrsid9579906 \u7897\'3fng x\u7845\'3fu, c\u7889\'3f \'fd c\u7911\'3f}{\f251\insrsid9579906\charrsid9579906 a Ng\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3f}{
\f251\insrsid9579906\charrsid9579906 i \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3f}{\f251\insrsid9579906\charrsid9579906 m ng\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3f}{\f243\insrsid9579906\charrsid9579906 
i \'f0}{\f0\insrsid9579906\charrsid9579906 \u7841\'3f}{\f243\insrsid9579906\charrsid9579906 i l\'fd, \'f0}{\f0\insrsid9579906\charrsid9579906 \u7841\'3fi di\u7879\'3fn ho\u7863\'3fc thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n tr\'fd}{
\f0\insrsid9579906\charrsid9579906 \u7903\'3fng, s\u297\'69 quan, v\'e0 thuy\u7873\'3fn vi\'ean.
\par 3. Vi ph\u7841\'3fm l\u7879\'3fnh c\u7845\'3fm do nh\'e0 ch\u7913\'3fc tr\'e1ch ban h\'e0nh, vi ph\u7841\'3fm nghi\'eam tr\u7885\'3fng lu\u7853\'3ft l\u7879\'3f giao th\'f4ng ho\u7863\'3fc ho\u7841\'3f}{\f243\insrsid9579906\charrsid9579906 t \'f0}{
\f0\insrsid9579906\charrsid9579906 \u7897\'3fng kinh doanh tr\'e1i ph\'e9p.
\par 4. T\'ednh ch\u7845\'3ft c\u7911\'3fa v\u7887\'3f, m\'e1y m\'f3c ho\u7863\'3fc trang thi\u7871\'3ft b\u7883\'3f c\u7911\'3fa t\'e0u thuy\u7873\'3fn, do c\u361\'75 k\u7929\'3f hay hao m\'f2n t\u7921\'3f nhi\'ean.
\par 5. Ch\u7853\'3fm tr\u7877\'3f h\'e0nh tr\'ecnh ho\u7863\'3fc k\'e9o d\'e0i s\u7843\'3fn xu\u7845\'3ft c\u7911\'3fa t\'e0u thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875
\'3fm, k\u7875\'3f c\u7843\'3f}{\f251\insrsid9579906\charrsid9579906  tr\'fd}{\f0\insrsid9579906\charrsid9579906 \u7901\'3fng h\u7907\'3fp ch\u7853\'3fm tr\u7877\'3f v\'e0 k\'e9o d\'e0i th\u7901\'3fi gian do r\u7911\'3f}{
\f251\insrsid9579906\charrsid9579906 i ro \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc b\u7843\'3fo hi\u7875\'3fm g\'e2y ra.
\par 6. B\u7883\'3f c\u7841\'3fn b\u7903\'3fi \u7843\'3f}{\f251\insrsid9579906\charrsid9579906 nh h\'fd}{\f0\insrsid9579906\charrsid9579906 \u7903\'3fng c\u7911\'3fa thu\u7927\'3f tri\u7873\'3fu ho\u7863\'3f}{\f251\insrsid9579906\charrsid9579906 c con n\'fd}{
\f0\insrsid9579906\charrsid9579906 \u7899\'3fc l\'ean xu\u7889\'3fng.
\par 7. Thuy\u7873\'3f}{\f251\insrsid9579906\charrsid9579906 n tr\'fd}{\f0\insrsid9579906\charrsid9579906 \u7903\'3f}{\f251\insrsid9579906\charrsid9579906 ng, m\'e1y tr\'fd}{\f0\insrsid9579906\charrsid9579906 \u7903\'3fng kh\'f4ng c\'f3 b\u7857\'3f}{
\f243\insrsid9579906\charrsid9579906 ng theo quy \'f0}{\f0\insrsid9579906\charrsid9579906 \u7883\'3fnh ho\u7863\'3fc kh\'f4ng c\'f3 kinh nghi\u7879\'3fm ho\u7863\'3fc tai n\u7841\'3fn x\u7843\'3f}{\f251\insrsid9579906\charrsid9579906 y ra do ng\'fd}{
\f0\insrsid9579906\charrsid9579906 \u7901\'3f}{\f251\insrsid9579906\charrsid9579906 i n\'e0y say r\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fu, bia, ma tu\'fd ho\u7863\'3fc c\'e1c ch\u7845\'3ft k}{\f251\insrsid9579906\charrsid9579906 \'edch th\'ed
ch t\'fd\'f5ng t}{\f0\insrsid9579906\charrsid9579906 \u7921\'3f kh\'e1c.
\par 8. T\'e0u thuy\u7873\'3f}{\f243\insrsid9579906\charrsid9579906 n \'f0}{\f0\insrsid9579906\charrsid9579906 \u7853\'3fu \u7903\'3f b\u7871\'3f}{\f251\insrsid9579906\charrsid9579906 n kh\'f4ng \'f0\'fd}{\f0\insrsid9579906\charrsid9579906 \u7907\'3fc neo, c
\u7897\'3ft ch\u7855\'3fc ch\u7855\'3fn ho\u7863\'3fc thuy\u7873\'3fn vi\'ean tr\u7921\'3fc b\u7843\'3fo qu\u7843\'3fn b\u7887\'3f t\u7847\'3fu thuy\u7873\'3f}{\f243\insrsid9579906\charrsid9579906 n \'f0i v}{\f0\insrsid9579906\charrsid9579906 \u7855\'3f
ng.
\par 
\par }\pard \qc \li0\ri0\sb120\sa120\keepn\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 B. BAOVIET KH\'d4NG CH\u7882\'3fU TR\'c1CH NHI\u7878\'3f}{
\b\f243\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 M \'d0}{\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 \u7888\'3fI V\u7898\'3fI\line  NH\u7918\'3fNG CHI PH\'cd C\'d3 LI\'caN QUAN D\'d9 NH\u7918\'3fNG CHI PH\'cd \line \u7844\'3f
Y DO NH\u7918\'3fNG R\u7910\'3f}{\b\f251\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 I RO \'d0\'dd}{\b\f0\fs22\expnd5\expndtw28\insrsid9579906\charrsid9579906 \u7906\'3fC B\u7842\'3fO HI\u7874\'3fM G\'c2Y RA:
\par 
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\faauto\adjustright\rin0\lin0\itap0 {\f251\insrsid9579906\charrsid9579906 1. Chi ph\'ed li\'ean quan \'f0}{\f0\insrsid9579906\charrsid9579906 \u7871\'3fn vi\u7879\'3fc ch\u7853\'3fm tr\u7877\'3f c\u7911\'3fa t\'e0
