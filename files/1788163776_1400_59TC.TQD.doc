\'3fA PH\'dd\'d5NG
\par }\pard \ltrpar\qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\wrapdefault\faauto\adjustright\rin0\lin0\itap0\pararsid9050252 {
\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 T\u7927\'3f l\u7879\'3f n\u7897\'3fp c\'e1c kho\u7843\'3fn ch\'eanh l\u7879\'3fch gi\'e1 v\'e0o Ng\'e2n s\'e1}{\rtlch\fcs1 \af383 \ltrch\fcs0 
\f383\fs28\cgrid0\insrsid1267181\charrsid3819778 ch trung \'fd\'f5ng v\'e0 Ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng \'f0\'fd\u7907\'3fc quy \'f0\u7883\'3fnh c\u7909\'3f th\u7875\'3f nh\'fd sau:
\par 1. C\'e1c \'f0\'f5n v\u7883\'3f kinh doanh th\'fd\'f5ng nghi\u7879\'3fp, cung \u7913\'3fng v\u7853\'3ft t\'fd \'e3n u\u7889\'3fng, d\u7883\'3fch v\u7909\'3f \u7903\'3f c\'e1c ng\'e0nh thu\u7897\'3fc trung \'fd\'f5ng qu\u7843\'3fn l}{\rtlch\fcs1 \af0 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 \'fd, n\u7897\'3fp 100% c\'e1c kho\u7843\'3fn ch\'eanh l\u7879\'3fch gi\'e1 ph\'e1t sinh v\'e0o Ng\'e2n s\'e1ch trung }{\rtlch\fcs1 \af383 \ltrch\fcs0 
\f383\fs28\cgrid0\insrsid1267181\charrsid3819778 \'fd\'f5ng.
\par }{\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 2. C\'e1c }{\rtlch\fcs1 \af383 \ltrch\fcs0 \f383\fs28\cgrid0\insrsid1267181\charrsid3819778 \'f0\'f5n v\u7883\'3f kinh doanh th\'fd\'f5ng nghi\u7879\'3fp, cung \u7913\'3fng v
\u7853\'3ft t\'fd, \'e3n u\u7889\'3fng, d\u7883\'3fch v\u7909\'3f c\'e1c ng\'e0nh thu\u7897\'3fc t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, qu\u7853\'3fn huy\u7879\'3fn qu\u7843\'3fn l}{\rtlch\fcs1 \af0 \ltrch\fcs0 
\f0\fs28\cgrid0\insrsid1267181\charrsid3819778 \'fd b\'e1n h\'e0ng, ch\'eanh l\u7879\'3fch gi\'e1 th\'ec }{\rtlch\fcs1 \af383 \ltrch\fcs0 \f383\fs28\cgrid0\insrsid1267181\charrsid3819778 \'f0i\u7873\'3fu ti\u7871\'3ft s\u7889\'3f thu theo nguy\'ean t
\u7855\'3fc sau \'f0\'e2y:
\par a) C\'e1c m\u7863\'3ft h\'e0ng v\u7853\'3ft t\'fd, t\'fd li\u7879\'3fu s\u7843\'3fn xu\u7845\'3ft nh\'fd s\u7855\'3ft th\'e9p, x\'e3ng d\u7847\'3fu, xi m\'e3ng, g\u7895\'3f v\'e0 nh\u7919\'3fng m\u7863\'3ft h\'e0ng ti\'eau d\'f9ng: v\u7843\'3fi, thu\u7889
\'3fc l\'e1, r\'fd\u7907\'3fu, bia ... do c\'e1c c\'f4ng ty cung \u7913\'3fng v\u7853\'3ft t\'fd v\'e0 th\'fd\'f5ng nghi\u7879\'3fp t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, qu\u7853\'3fn, huy\u7879\'3fn kinh doanh, c\'f3 ch\'eanh l\u7879\'3fch gi\'e1 ph\'e1
t sinh th}{\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 \'ec ph\u7843\'3fi n\u7897\'3fp s\u7889\'3f ch\'eanh l\u7879\'3fch gi\'e1 }{\rtlch\fcs1 \af383 \ltrch\fcs0 \f383\fs28\cgrid0\insrsid1267181\charrsid3819778 \'f0\'f3
 cho Ng\'e2n s\'e1ch trung \'fd\'f5ng 70% v\'e0 Ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng 30%.
\par b) C\'e1c m\u7863\'3ft h\'e0ng ti\'eau d\'f9ng kh\'e1c do c\'e1c c\'f4ng ty th\'fd\'f5ng nghi\u7879\'3fp t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, qu\u7853\'3fn huy\u7879\'3fn kinh doanh c\'f3 ch\'eanh l\u7879\'3fch gi\'e1 ph\'e1t sinh th}{\rtlch\fcs1 \af0 
\ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 \'ec ph\u7843\'3fi n\u7897\'3fp s\u7889\'3f ch\'eanh l\u7879\'3fch gi\'e1 }{\rtlch\fcs1 \af383 \ltrch\fcs0 \f383\fs28\cgrid0\insrsid1267181\charrsid3819778 \'f0\'f3 cho Ng\'e2n s\'e1ch trung \'fd
\'f5ng 50% v\'e0 ng\'e2n s\'e1ch \'f0\u7883\'3fa ph\'fd\'f5ng 50%.
\par }{\rtlch\fcs1 \af0 \ltrch\fcs0 \f0\fs28\cgrid0\insrsid1267181\charrsid3819778 Ri\'eang 6 m\u7863\'3ft h\'e0n}{\rtlch\fcs1 \af383 \ltrch\fcs0 \f383\fs28\cgrid0\insrsid1267181\charrsid3819778 g \'f0\u7883\'3fnh l\'fd\u7907\'3fng b\'e1n gi\'e1 \u7893\'3fn 
\'f0\u7883\'3fnh cho c\'e1n b\u7897\'3f c\'f4ng nh\'e2n vi\'ean tr\'ean \'f0\u7883\'3fa b\'e0n t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, n\u7871\'3fu c\'e1c \'f0\u7883\'3fa ph\'fd\'f5ng cho b\'e1n m\u7897\'3ft gi\'e1 cao h\'f5n gi\'e1 \u7893\'3fn \'f0\u7883
\'3fnh (Theo quy\u7871\'3ft \'f0\u7883\'3fnh 146/H\'d0BT ng\'e0y 22/9/1987 c\u7911\'3fa H\u7897\'3fi \'f0\u7891\'3fng B\u7897\'3f tr\'fd\u7903\'3fng) thi kho\u7843\'3fn ch\'eanh l\u7879\'3fch gi\'e1 \'f0\'fd\u7907\'3fc gi\u7919\'3f l\u7841\'3fi \'f0\u7875
\'3f b\'f9 tr\u7921\'3fc ti\u7871\'3fp cho c\'e1n b\u7897\'3f c\'f4ng nh\'e2n vi\'ean c\u7911\'3fa \'f0\u7883\'3fa ph\'fd\'f5ng v\'e0 trung \'fd\'f5ng \'f0\'f3ng tr\'ean \'f0\u7883\'3fa b\'e0n t\u7881\'3fnh, th\'e0nh ph\u7889\'3f.
\par }\pard \ltrpar\qc \li0\ri0\keepn\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\wrapdefault\faauto\outlinelevel2\adjustright\rin0\lin0\itap0\pararsid7748828 {\rtlch\fcs1 \af383 
