\par 1. Ban qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n k\'fd h\u7907\'3fp }{\f275\insrsid7238503\charrsid7238503 \'f0\u7891\'3f}{\f0\insrsid7238503\charrsid7238503 ng v\u7899\'3fi nh\'e0 th\u7847\'3fu. Nh\'e0 th\u7847\'3fu th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp }
{\f275\insrsid7238503\charrsid7238503 \'f0\u7891\'3f}{\f0\insrsid7238503\charrsid7238503 ng v\'e0 }{\f275\insrsid7238503\charrsid7238503 \'f0\u7873\'3f}{\f0\insrsid7238503\charrsid7238503  ngh\u7883\'3f thanh to\'e1n.
\par 2. Ban qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n ki\u7875\'3fm tra, ch\u7845\'3fp thu\u7853\'3fn v\'e0 }{\f275\insrsid7238503\charrsid7238503 \'f0\u7873\'3f}{\f0\insrsid7238503\charrsid7238503  ngh\u7883\'3f T\u7893\'3fng c\u7909\'3fc }{
\f275\insrsid7238503\charrsid7238503 \'d0\u7847\'3f}{\f0\insrsid7238503\charrsid7238503 u t}{\f283\insrsid7238503\charrsid7238503 \'fd}{\f0\insrsid7238503\charrsid7238503  ph\'e1t tri\u7875\'3fn thanh to\'e1n cho nh\'e0 th\u7847\'3fu b\u7857\'3fng ngu
\u7891\'3fn v\u7889\'3fn trong n}{\f283\insrsid7238503\charrsid7238503 \'fd\u7899\'3f}{\f0\insrsid7238503\charrsid7238503 c.
\par 3. T\u7893\'3fng c\u7909\'3fc }{\f275\insrsid7238503\charrsid7238503 \'d0\u7847\'3f}{\f0\insrsid7238503\charrsid7238503 u t}{\f283\insrsid7238503\charrsid7238503 \'fd}{\f0\insrsid7238503\charrsid7238503  ph\'e1t tri\u7875\'3fn thanh to\'e1n theo }{
\f275\insrsid7238503\charrsid7238503 \'f0\u7873\'3f}{\f0\insrsid7238503\charrsid7238503  ngh\u7883\'3f c\u7911\'3fa Ban qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n.
\par 4. Ban qu\u7843\'3fn l\'fd d\u7921\'3f \'e1n t\u7853\'3fp h\u7907\'3fp ch\u7913\'3fng t\u7915\'3f r\'fat ho\'e0n v\u7889\'3fn g\u7917\'3fi B\u7897\'3f T\'e0i ch\'ednh (V\u7909\'3f T\'e0i ch\'ednh }{\f275\insrsid7238503\charrsid7238503 \'f0\u7889\'3f}{
\f0\insrsid7238503\charrsid7238503 i ngo\u7841\'3fi).
\par 5. B\u7897\'3f T\'e0i ch\'ednh (V\u7909\'3f T\'e0i ch\'ednh }{\f275\insrsid7238503\charrsid7238503 \'f0\u7889\'3f}{\f0\insrsid7238503\charrsid7238503 i ngo\u7841\'3fi) xem x\'e9t v\'e0 k\'fd }{\f283\insrsid7238503\charrsid7238503 \'f0\'f5}{
\f0\insrsid7238503\charrsid7238503 n r\'fat v\u7889\'3fn v\'e0 g\u7917\'3fi nh\'e0 t\'e0i tr\u7907\'3f. Trong tr}{\f283\insrsid7238503\charrsid7238503 \'fd\u7901\'3f}{\f0\insrsid7238503\charrsid7238503 ng h\u7907\'3fp d\u7921\'3f \'e1n vay WB ho\u7863\'3f
c ADB, B\u7897\'3f T\'e0i ch\'ednh (V\u7909\'3f T\'e0i ch\'ednh }{\f275\insrsid7238503\charrsid7238503 \'f0\u7889\'3f}{\f0\insrsid7238503\charrsid7238503 i ngo\u7841\'3fi) c\'f3 \'fd ki\u7871\'3fn g\u7917\'3fi Ng\'e2n h\'e0ng ph\u7909\'3fc v\u7909\'3f }{
\f275\insrsid7238503\charrsid7238503 \'f0\u7875\'3f}{\f0\insrsid7238503\charrsid7238503  Ng\'e2n h\'e0ng ph\u7909\'3fc v\u7909\'3f k\'fd }{\f283\insrsid7238503\charrsid7238503 \'f0\'f5}{\f0\insrsid7238503\charrsid7238503 n g\u7917\'3fi nh\'e0 t\'e0i tr
\u7907\'3f.
\par 6. Nh\'e0 t\'e0i tr\u7907\'3f gi\u7843\'3fi ng\'e2n }{\f275\insrsid7238503\charrsid7238503 \'f0\u7875\'3f}{\f0\insrsid7238503\charrsid7238503  ho\'e0n tr\u7843\'3f v\'e0o t\'e0i kho\u7843\'3fn c\u7911\'3fa ng\'e2n s\'e1ch nh\'e0 n}{
