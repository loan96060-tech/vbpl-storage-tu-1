\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 Vi\u7879\'3fc c\u7845\'3fp ph\'e1t v\'e0 qu\u7843\'3fn l\'fd v\u7889\'3fn l}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fdu \'f0\u7897\'3fng ph\u7843\'3fi nh\u7857\'3fm m\u7909\'3fc \'f0\'edch: 
\'d0\u7843\'3fm b\u7843\'3fo nhu c\u7847\'3fu v\u7889\'3fn cho \'f0\'f5n v\u7883\'3f ho\u7841\'3ft \'f0\u7897\'3fng, \'f0\u7891\'3fng th\u7901\'3fi th\'fac \'f0\u7849\'3fy \'f0\'f5n v\u7883\'3f s\u7917\'3f d\u7909\'3fng v\u7889\'3fn h\u7907\'3fp l}{
\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd, ti\u7871\'3ft ki\u7879\'3fm, t\'e3ng nhanh v}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f2ng quay v\u7889\'3fn, ho\'e0n th\'e0nh k\u7871\'3f ho\u7841\'3fch s\u7843\'3fn xu\u7845\'3ft- k\u7929
\'3f thu\u7853\'3ft }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\'fda nhanh c\'f4ng tr}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ecnh x\'e2y d\u7921\'3fng v\'e0o s\u7843\'3fn xu\u7845\'3ft, s\u7917\'3f d\u7909\'3fng v\u7899\'3fi ch
\u7845\'3ft l}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd\u7907\'3fng t\u7889\'3ft, gi\'e1 th\'e0nh h\u7841\'3f.
\par \'d0i\u7873\'3fu 2. \'d0\u7889\'3fi t\'fd\u7907\'3fng \'f0\'fd\u7907\'3fc \'f0\u7883\'3fnh m\u7913\'3fc v\'e0 c\u7845\'3fp ph\'e1t v\u7889\'3fn l\'fdu \'f0\u7897\'3fng l\'e0 \'f0\'f5n v\u7883\'3f (x\'ed nghi\u7879\'3fp, c\'f4ng ty) x\'e2y l\u7855\'3fp qu
\u7889\'3fc doanh v\'e0 c\'f4ng t\'fd h\u7907\'3fp doanh \'f0\'fd\u7907\'3fc th\'e0nh l\u7853\'3fp theo \'f0\'fang quy \'f0\u7883\'3fnh c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc, h\u7841\'3fch to\'e1n kinh t\u7871\'3f \'f0\u7897\'3fc l\u7853\'3fp, c\'f3 k
\u7871\'3f ho\u7841\'3fch s\u7843\'3fn xu\'e1t, k\u7929\'3f thu\u7853\'3ft, t\'e0i ch\'ednh \'f0\'fd\u7907\'3fc duy\u7879\'3ft.
\par \'d0\u7889\'3fi v\u7899\'3fi li\'ean hi\u7879\'3fp c\'e1c x\'ed nghi\u7879\'3fp (ho\u7863\'3fc t\u7893\'3fng c\'f4ng ty) ho\u7841\'3ft \'f0\u7897\'3fng theo \'f0i\u7873\'3fu l\u7879\'3f c\u7911\'3fa li\'ean hi\u7879\'3fp c\'e1c x\'ed nghi\u7879\'3fp th}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ec vi\u7879\'3fc }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn v\'e0 c\u7845\'3fp ph\'e1t v\u7889\'3fn l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3f
c \'f0\'fd\u7907\'3fc th\u7921\'3fc hi\u7879\'3fn \'f0\u7889\'3fi v\u7899\'3fi t\u7915\'3fng \'f0\'f5n v\u7883\'3f (x\'ed nghi\u7879\'3fp, c\'f4ng ty) tr\u7921\'3fc thu\u7897\'3fc c\'f3 \'f0\u7911\'3f c\'e1c \'f0i\u7873\'3fu ki\u7879\'3fn n\'eau tr\'ea
n, theo ph\'fd\'f5ng th\u7913\'3fc sau \'f0\'e2y:
\par 1. C\'e1c \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp \'f0\'fd\u7907\'3fc \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn v\'e0 c\u7845\'3fp ph\'e1t v\u7889\'3fn theo quy \'f0\u7883\'3fnh trong th\'f4ng t\'fd n\'e0y.
\par 2. C\'e1c \'f0\'f5n v\u7883\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh kh\'e1c \'f0\'fd\u7907\'3fc \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn v\'e0 c\u7845\'3fp ph\'e1t v\u7889\'3fn tu\u7923\'3f theo t\'ednh ch\u7845\'3ft ng\'e0nh kinh t\u7871\'3f c\u7911
\'3fa c\'e1c \'f0\'f5n v\u7883\'3f \'f0\'f3.
\par \'d0i\u7873\'3fu 3. V\u7889\'3fn l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc c\u7911\'3fa \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp \'f0\'fd\u7907\'3fc x\'e1c \'f0\u7883\'3fnh h\'e0ng n\'e3m. Vi\u7879\'3fc \'f0\u7883\'3fnh m\u7913\'3fc v\'e0 c
\u7845\'3fp ph\'e1t v\u7889\'3fn l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc ph\u7843\'3fi \'f0\'fd\u7907\'3fc ti\u7871\'3fn h\'e0nh tr\'ean c\'f5 s\u7903\'3f nhi\u7879\'3fm v\u7909\'3f s\u7843\'3fn xu\u7845\'3ft kinh doanh trong n\'e3m k\u7871
\'3f ho\u7841\'3fch v\'e0 c\'e1c \'f0i\u7873\'3fu ki\u7879\'3fn cung c\u7845\'3fp v\u7853\'3ft t\'fd, chu k\u7923\'3f s\u7843\'3fn xu\u7845\'3ft, ti\'eau th\u7909\'3f s\u7843\'3fn ph\u7849\'3fm v.v... c\u7911\'3fa \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3f
p.
\par }{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 4. V\u7889\'3fn }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc c\u7911\'3fa \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp \'f0\'fd
\u7907\'3fc h}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ecnh th\'e0nh b\u7857\'3fng 2 ngu\u7891\'3fn:
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 1. Ngu\u7891\'3fn v\u7889\'3fn ng\'e2n s\'e1ch c\u7845\'3fp (v\u7889\'3fn t\u7921\'3f c\'f3 v\'e0 coi nh\'fd t\u7921\'3f c\'f3).
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 2. Ngu\u7891\'3fn v\u7889\'3fn vay ng\'e2n h\'e0ng.
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 5. \'d0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp c\'f3 c\'e1c ho\u7841\'3ft \'f0\u7897\'3fng s\u7843\'3fn xu\u7845\'3ft kinh doanh ph\u7909\'3f thu\u7897\'3fc nh\u7887\'3f, ch\'fda \'f0
\u7911\'3f \'f0i\u7873\'3fu ki\u7879\'3fn h\u7841\'3fch to\'e1n k}{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 inh t\u7871\'3f \'f0\u7897\'3fc l\u7853\'3fp, ph\u7909\'3fc v\u7909\'3f cho c\'f4ng t\'e1c x\'e2y l\u7855\'3fp th}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ec vi\u7879\'3fc }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng cho c\'e1c ho\u7841\'3ft \'f0\u7897\'3fng \'f0\'f3 theo t\'ednh ch
\u7845\'3ft ng\'e0nh kinh t\u7871\'3f c\u7911\'3fa c\'e1c \'f0\'f5n v\u7883\'3f \'f0\'f3. S\u7889\'3f v\u7889\'3fn \'f0\u7883\'3fnh m\u7913\'3fc cho c\'e1c ho\u7841\'3ft \'f0\u7897\'3fng n\'e0y \'f0\'fd\u7907\'3fc c\u7897\'3fng v\'e0o s\u7889\'3f v\u7889
\'3fn \'f0\u7883\'3fnh m\u7913\'3fc cho c\'f4ng t\'e1c x\'e2y l\u7855\'3fp \'f0\u7875\'3f c\u7845\'3fp ph\'e1t.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid9073955 {\b\f164\fs28\cgrid0\insrsid6032095\charrsid9073955 II. \'d0\u7883\'3fnh 
}{\b\f172\fs28\cgrid0\insrsid6032095\charrsid9073955 m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng:
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid14102686 {
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 6. H\'e0ng n\'e3m, \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp ph\u7843\'3fi ti\u7871\'3fn h\'e0nh l\u7853\'3fp v\'e0 tr}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ecnh duy\u7879\'3f
t }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng.
\par Vi\u7879\'3fc \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng ph\u7843\'3fi \'f0\u7843\'3fm b\u7843\'3fo \'f0\'fang m\u7909\'3fc \'f0\'edch v\'e0 c\'e1c nguy\'ean t\u7855\'3fc c\u7845\'3fp ph\'e1t v\'e0 qu\u7843\'3fn l}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd v\u7889\'3fn l}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fdu \'f0\u7897\'3fng n\'f3i trong ph\u7847\'3fn I Th\'f4ng t\'fd n\'e0y.
\par \'d0i\u7873\'3fu 7. Th\'e0nh ph\u7847\'3fn v\u7889\'3fn l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc c\u7911\'3fa \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp bao g\u7891\'3fm:
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 1. V\u7853\'3ft li\u7879\'3fu ch\'ednh
\par 2. V\u7853\'3ft k\u7871\'3ft c\u7845\'3fu
\par 3. V\u7853\'3ft li\u7879\'3fu ph\u7909\'3f
\par 4. Nhi\'ean li\u7879\'3fu
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 5. C\'f4ng c\u7909\'3f lao \'f0\u7897\'3fng thu\u7897\'3fc t\'e0i s\u7843\'3fn l\'fdu \'f0\u7897\'3fng
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 6. Ph\u7909\'3f t\'f9ng thay th\u7871\'3f
\par 7. Chi ph\'ed ch\u7901\'3f ph\'e2n b\u7893\'3f
\par 8. Chi ph\'ed x\'e2y l\u7855\'3fp ph\u7909\'3f d\u7903\'3f dang
\par 9. Chi ph\'ed gia c\'f4ng thi\u7871\'3ft b\u7883\'3f d\u7903\'3f dang
\par 10. Chi ph\'ed x\'e2y d\u7921\'3fng d\u7903\'3f dang
\par }{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 11. Chi ph\'ed l\u7855\'3fp \'f0\u7863\'3ft d\u7903\'3f dang
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 12. S\u7843\'3fn ph\u7849\'3fm x\'e2y l\u7855\'3fp ho\'e0n th\'e0nh ch\u7901\'3f thanh to\'e1n.
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 8. Ph\'fd\'f5ng ph\'e1p t\'ednh \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng:
\par 1. \'d0\u7889\'3fi v\u7899\'3fi c\'e1c kho\u7843\'3fn v\u7889\'3fn d\u7921\'3f tr\u7919\'3f, \'f0\u7883\'3fnh m\u7913\'3fc c\'e3n c\u7913\'3f v\'e0o m\u7913\'3fc lu\'e2n chuy\u7875\'3fn k\u7871\'3f ho\u7841\'3fch v\'e0 th\u7901\'3f}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 i gian d\u7921\'3f tr\u7919\'3f h\u7907\'3fp l\'fd.
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 2. \'d0\u7889\'3fi v\u7899\'3fi c\'e1c kho\u7843\'3fn v\u7889\'3fn s\u7843\'3fn xu\u7845\'3ft, \'f0\u7883\'3fnh m\u7913\'3fc c\'e3n c\u7913\'3f v\'e0o chu k\u7923\'3f s\u7843\'3fn xu\u7845\'3ft v\'e0
 chi ph\'ed c\u7911\'3fa s\u7843\'3fn ph\u7849\'3fm x\'e2y l\u7855\'3fp d\u7903\'3f dang.
\par (Ph\'fd\'f5ng ph\'e1p t\'ednh c\u7909\'3f th\u7875\'3f quy \'f0\u7883\'3fnh trong ph\u7909\'3f l\u7909\'3fc k\'e8m theo Th\'f4ng t\'fd n\'e0y).
\par \'d0i\u7873\'3fu 9. Nh\u7919\'3fng kho\u7843\'3fn v\u7889\'3fn sau \'f0\'e2y kh\'f4ng \'f0\'fd\u7907\'3fc t\'ednh v\'e0o \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng.
\par 1. Ph\u7847\'3fn v\u7889\'3fn \'f0\u7875\'3f d\u7921\'3f tr\u7919\'3f theo th\u7901\'3fi v\u7909\'3f, d\u7921\'3f tr\u7919\'3f v\'fd\u7907\'3ft m\u7913\'3fc do nhu c\u7847\'3fu t\u7841\'3fm th\u7901\'3fi.
\par 2. Ph\u7847\'3fn v\u7889\'3fn \'f0\u7875\'3f d\u7921\'3f tr\u7919\'3f v\u7853\'3ft t\'fd nh\u7853\'3fp theo thi\u7871\'3ft b\u7883\'3f to\'e0n b\u7897\'3f d\'f9ng cho c\'e1c n\'e3m sau m\'e0 \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp \'f0}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'e3 nh\u7853\'3fn c\u7911\'3fa b\'ean ch\u7911\'3f }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7847\'3fu t\'fd.
\par }{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 3. C\'e1c kho\u7843\'3fn v\u7889\'3fn \u7913\'3f \'f0\u7885\'3fng, ch\u7853\'3fm lu\'e2n }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 chuy\u7875\'3fn v\'e0 c\'e1c kho\u7843\'3fn v\u7889\'3fn kh
\'f4ng \'f0\u7883\'3fnh m\u7913\'3fc kh\'e1c.
\par \'d0i\u7873\'3fu 10. \'d0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng do \'f0\'f5n v\u7883\'3f t\'ednh to\'e1n v\'e0 do c\'f5 quan ch\u7911\'3f qu\u7843\'3fn c\u7845\'3fp tr\'ean c\u7911\'3fa \'f0\'f5n v\u7883\'3f x\'e9t duy\u7879\'3ft c
\'f3 s\u7921\'3f tho\u7843\'3f thu\u7853\'3fn c\u7911\'3fa c\'f5 quan t\'e0i ch\'ednh v\'e0 ng\'e2n h\'e0ng \'f0\u7891\'3fng c\u7845\'3fp.
\par (\'d0\'f5n v\u7883\'3f trung \'fd\'f5ng do B\u7897\'3f ch\u7911\'3f qu\u7843\'3fn x\'e9t duy\u7879\'3ft c\'f3 s\u7921\'3f tho\u7843\'3f thu\u7853\'3fn c\u7911\'3fa B\u7897\'3f T\'e0i ch\'ednh v\'e0 Ng\'e2n h\'e0ng \'f0\u7847\'3fu t\'fd v\'e0 x\'e2y d
\u7921\'3fng trung \'fd\'f5ng; \'f0\'f5n v\u7883\'3f \'f0\u7883\'3fa ph\'fd\'f5ng do S\u7903\'3f ch\u7911\'3f qu\u7843\'3fn x\'e9t duy\u7879\'3ft c\'f3 s\u7921\'3f tho\u7843\'3f thu\u7853\'3fn c\u7911\'3fa S\u7903\'3f T\'e0i ch\'ednh v\'e0 Ng\'e2n h\'e0
ng \'f0\u7847\'3fu t\'fd v\'e0 x\'e2y d\u7921\'3fng t\u7881\'3fnh, th\'e0nh ph\u7889\'3f).
\par \'d0i\u7873\'3fu 11. T\'e0i li\u7879\'3fu l\'e0m c\'e3n c\u7913\'3f x\'e9t duy\u7879\'3ft \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng:
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 1. K\u7871\'3f ho\u7841\'3fch s\u7843\'3fn xu\u7845\'3ft- k\u7929\'3f thu\u7853\'3ft- t\'e0i ch\'ednh bao g\u7891\'3fm:
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 a) K\u7871\'3f ho\u7841\'3fch ti\u7871\'3fn \'f0\u7897\'3f thi c\'f4ng v\'e0 ti\'eau th\u7909\'3f s\u7843\'3fn ph\u7849\'3fm x\'e2y d\u7921\'3fng.
\par b) K\u7871\'3f ho\u7841\'3fch cung c\u7845\'3fp v\u7853\'3ft t\'fd
\par c) K\u7871\'3f ho\u7841\'3fch lao \'f0\u7897\'3fng v\'e0 ti\u7873\'3fn l\'fd\'f5ng
\par d) K\u7871\'3f ho\u7841\'3fch s\u7917\'3fa ch\u7919\'3fa l\u7899\'3fn v\'e0 nhu c\u7847\'3fu v\u7873\'3f ph\u7909\'3f t\'f9ng cho s\u7917\'3fa ch\u7919\'3fa th\'fd\u7901\'3fng xuy\'ea}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 n v\'e0 s\u7917\'3f
a ch\u7919\'3fa l\u7899\'3fn t\u7921\'3f l\'e0m.
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 e) K\u7871\'3f ho\u7841\'3fch s\u7917\'3f d\u7909\'3fng v\'e0 mua s\u7855\'3fm c\'f4ng c\u7909\'3f lao \'f0\u7897\'3fng.
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 g) K\u7871\'3f ho\u7841\'3fch chi ph\'ed s\u7843\'3fn xu\u7845\'3ft.
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 2. B\u7843\'3fng t\'ednh to\'e1n v\'e0 x\'e1c \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn \'f0\u7873\'3f ngh\u7883\'3f x\'e9t duy\u7879\'3ft (theo m\u7851\'3fu 1 k\'e8m Th\'f4ng t\'fd n\'e0y).
\par }{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 3. B\u7843\'3fng t\'ednh to\'e1n c\'e1c ngu\u7891\'3fn v\u7889\'3fn \'f0\u7843\'3fm b\u7843\'3fo \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn (bao g\u7891\'3fm s\u7889\'3f v\u7889\'3fn \'f0}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'e3 }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\'fd\u7907\'3fc c\u7845\'3fp, s\u7889\'3f v\u7889\'3fn coi nh\'fd t\u7921\'3f c\'f3, s\u7889\'3f v\u7889\'3fn d\u7921\'3f ki\u7871\'3fn th\u7915
\'3fa ho\u7863\'3fc thi\u7871\'3fu so v\u7899\'3fi \'f0\u7883\'3fnh m\u7913\'3fc \'f0\u7873\'3f ngh\u7883\'3f \'f0i\u7873\'3fu ch\u7881\'3fnh- theo m\u7851\'3fu s\u7889\'3f 2 k\'e8m Th\'f4ng t\'fd n\'e0y).
\par C\'e1c t\'e0i li\u7879\'3fu tr\'ean \'f0\'fd\u7907\'3fc l\u7853\'3fp th\'e0nh 3 b\u7843\'3fn g\u7917\'3fi: C\'f5 quan ch\u7911\'3f qu\u7843\'3fn c\u7845\'3fp tr\'ean; B\u7897\'3f- (S\u7903\'3f) T\'e0i ch\'ednh; Ng\'e2n h\'e0ng \'f0\u7847\'3fu t\'fd v\'e0
 x\'e2y d\u7921\'3fng trung \'fd\'f5ng- t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu.
\par \'d0i\u7873\'3fu 12. Th\u7901\'3fi h\u7841\'3fn l\u7853\'3fp v\'e0 x\'e9t duy\u7879\'3ft \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng: \'d0\'f5n v\u7883\'3f ph\u7843\'3fi l\u7853\'3fp \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn \'f0
\u7891\'3fng th\u7901\'3fi v\u7899\'3fi vi\u7879\'3fc l\u7853\'3fp k\u7871\'3f ho\u7841\'3fch s\u7843\'3fn xu\u7845\'3ft- k\u7929\'3f thu\u7853\'3ft- t\'e0i ch\'ednh. Vi\u7879\'3fc x\'e9t duy\u7879\'3ft v\'e0 t\u7893\'3fng h\u7907\'3fp \'f0\u7883\'3fnh m
\u7913\'3fc v\u7889\'3fn \'f0\'fd\u7907\'3fc ti\u7871\'3fn h\'e0nh \'f0\u7891\'3fng th\u7901\'3fi}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914  v\u7899\'3fi vi\u7879\'3fc x\'e9t duy\u7879\'3ft k\u7871\'3f ho\u7841\'3fch s\u7843\'3fn xu\u7845\'3ft- k
\u7929\'3f thu\u7853\'3ft- t\'e0i ch\'ednh.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid9073955 {\b\f172\fs28\cgrid0\insrsid6032095\charrsid9073955 III. C\u7845\'3fp ph
\'e1t v\u7889\'3fn l\'fdu \'f0\u7897\'3fng:
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid14102686 {
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 13. T\'e0i li\u7879\'3fu l\'e0m c\'e3n c\u7913\'3f c\u7845\'3fp ph\'e1t:
\par 1. Quy\u7871\'3ft \'f0\u7883\'3fnh x\'e9t duy\u7879\'3ft \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng c\u7911\'3fa c\'f5 quan ch\u7911\'3f qu\u7843\'3fn c\u7845\'3fp tr\'ean (sau khi c\'f3 s\u7921\'3f tho\u7843\'3f thu\u7853\'3fn c
\u7911\'3fa c\'f5 quan t\'e0i ch\'ednh, ng\'e2n h\'e0ng \'f0\u7891\'3fng c\u7845\'3fp).
\par 2. B\u7843\'3fng t\'ednh to\'e1n c\'e1c ngu\u7891\'3fn v\u7889\'3fn \'f0\u7843\'3fm b\u7843\'3fo \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn (theo m\u7851\'3fu s\u7889\'3f 2 k\'e8m theo th\'f4ng t\'fd n\'e0y). 
\par 3. \'d0\u7889\'3fi v\u7899\'3fi \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp m\u7899\'3fi th\'e0nh l\u7853\'3fp ngo\'e0i c\'e1c t\'e0i li\u7879\'3fu tr\'ean c\u7847\'3fn g\u7917\'3fi th\'eam t\'e0i li\u7879\'3fu sau \'f0\'e2y:
\par -Quy\u7871\'3ft \'f0\u7883\'3fnh th\'e0nh l\u7853\'3fp \'f0\'f5n v\u7883\'3f do c\u7845\'3fp c\'f3 th\u7849\'3fm quy\u7873\'3fn k}{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd theo \'f0\'fang c\'e1c quy \'f0\u7883\'3fnh c\u7911\'3fa Nh}{
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'e0 n\'fd\u7899\'3fc.
\par -Quy\u7871\'3ft \'f0\u7883\'3fnh b\u7893\'3f nhi\u7879\'3fm gi\'e1m \'f0\u7889\'3fc v\'e0 k\u7871\'3f to\'e1n tr\'fd\u7903\'3fng.
\par C\'e1c t\'e0i li\u7879\'3fu tr\'ean \'f0\'f5n v\u7883\'3f g\u7917\'3fi cho: c\'f5 quan ch\u7911\'3f qu\u7843\'3fn m\u7897\'3ft b\u7843\'3fn; B\u7897\'3f (S\u7903\'3f) T\'e0i ch\'ednh m\u7897\'3ft b\u7843\'3fn; Ng\'e2n h\'e0ng \'f0\u7847\'3fu t\'fd v\'e0 x
\'e2y d\u7921\'3fng trung \'fd\'f5ng t\u7881\'3fnh, th\'e0nh ph\u7889\'3f, \'f0\u7863\'3fc khu m\u7897\'3ft b\u7843\'3fn.
\par }{\f164\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 14}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 . Vi\u7879\'3fc c\u7845\'3fp ph\'e1t v\u7889\'3fn l\'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc \'f0\'fd\u7907\'3fc th\u7921
\'3fc hi\u7879\'3fn \'f0\u7889\'3fi v\u7899\'3fi t\u7915\'3fng \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp theo t\u7927\'3f l\u7879\'3f sau \'f0\'e2y:
\par 1. V\u7889\'3fn t\u7921\'3f c\'f3 v\'e0 coi nh\'fd t\u7921\'3f c\'f3 \'f0\u7843\'3fm b\u7843\'3fo 50% \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn \'f0\'fd\u7907\'3fc duy\u7879\'3ft.
\par 2. Ng\'e2n h\'e0ng \'f0\u7847\'3fu t\'fd v\'e0 x\'e2y d\u7921\'3fng cho vay 50% \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn c}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f2n l\u7841\'3fi,
\par }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 15. H\'e0ng n\'e3m, sau khi x\'e9t duy\u7879\'3ft \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng v\'e0 c\'f3 s\u7921\'3f tho\u7843\'3f thu\u7853\'3fn c\u7911\'3fa c
\'f5 quan t\'e0i ch\'ednh \'f0\u7891\'3fng c\u7845\'3fp, c\'f5 quan ch\u7911\'3f qu\u7843\'3fn c\u7845\'3fp tr\'ean \'f0\'fd\u7907\'3fc \'f0i\u7873\'3fu ho\'e0 ph\u7847\'3fn v\u7889\'3fn l\'fdu \'f0\u7897\'3fng do ng\'e2n s\'e1ch c\u7845\'3fp c\u7911\'3f
a \'f0\'f5n v\u7883\'3f th\u7915\'3fa cho \'f0\'f5n v\u7883\'3f thi\u7871\'3fu, sau \'f0\'f3 t\u7893\'3fng h\u7907\'3fp chung t}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ecnh h\'ecnh v\u7889\'3fn l}{
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fdu \'f0\u7897\'3fng c\u7911\'3fa c\'e1c c\'f5 qu}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 an thu\u7897\'3fc ph\u7841\'3fm v\u7883\'3f qu\u7843\'3fn l\'fd b\'e1o c\'e1o cho c}{
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f5 quan t\'e0i ch\'ednh c\'f3 tr\'e1ch nhi\u7879\'3fm c\u7845\'3fp ph\'e1t v\u7889\'3fn bi\u7871\'3ft. Tr\'fd\u7901\'3fng h\u7907\'3fp thi\u7871\'3fu v\u7889\'3fn s\u7869\'3f \'f0\'fd\u7907\'3fc xem x
\'e9t c\u7845\'3fp ph\'e1t b\u7893\'3f sung; n\u7871\'3fu th\u7915\'3fa ph\u7843\'3fi ho\'e0n tr\u7843\'3f l\u7841\'3fi cho ng\'e2n s\'e1ch Nh\'e0 n\'fd\u7899\'3fc.
\par }\pard \qc \li0\ri0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid9073955 {\b\f0\fs28\cgrid0\insrsid6032095\charrsid9073955 IV. Qu\u7843\'3fn l\'fd
 v\u7889\'3fn l}{\b\f172\fs28\cgrid0\insrsid6032095\charrsid9073955 \'fdu \'f0\u7897\'3fng \'f0\u7883\'3fnh m\u7913\'3fc:
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\tx1350\tx2070\tx2790\tx3510\tx4230\tx4950\tx5670\tx6390\tx7110\tx7830\tx8550\tx9270\tx9990\tx10710\faauto\adjustright\rin0\lin0\itap0\pararsid14102686 {
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'d0i\u7873\'3fu 16. Gi\'e1m \'f0\u7889\'3fc \'f0\'f5n v\u7883\'3f x\'e2y l\u7855\'3fp ch\u7883\'3fu tr\'e1ch nhi\u7879\'3fm tr\'fd\u7899\'3fc Nh\'e0 n\'fd\u7899\'3fc trong vi\u7879\'3fc qu\u7843\'3fn l}{
\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd, s\u7917\'3f d\u7909\'3fng v\u7889\'3fn l}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fdu \'f0\u7897\'3fng v\'e0 t\'e0i s\u7843\'3fn l\'fdu \'f0\u7897\'3fng, c\'f3 nhi\u7879\'3fm v\u7909\'3f:

\par 1. T\u7893\'3f ch\u7913\'3fc v\'e0 ch\u7881\'3f \'f0\u7841\'3fo c\'f4ng t\'e1c t\'ednh to\'e1n x\'e1c \'f0\u7883\'3fnh \'f0\u7883\'3fnh m\u7913\'3fc v\u7889\'3fn l\'fdu \'f0\u7897\'3fng v\u7899\'3fi ch\u7845\'3ft l\'fd\u7907\'3fng t\u7889\'3ft v\'e0 \'f0
\'fang th\u7901\'3fi gian quy \'f0\u7883\'3fnh.
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 2. T\u7893\'3f ch\u7913\'3fc c\'f4ng t\'e1c qu\u7843\'3fn l\'fd v\'e0 s\u7917\'3f d\u7909\'3fng v\u7889\'3fn }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\'fang m\u7909\'3fc \'f0\'edch, ch\u7863
\'3ft ch\u7869\'3f v\'e0 ti\u7871\'3ft ki\u7879\'3fm.
\par }{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 3. T\'ecm m\u7885\'3fi bi\u7879\'3fn ph\'e1p t\'edch c\u7921\'3fc }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7875\'3f n\'e2ng cao hi\u7879\'3fu qu\u7843\'3f s\u7917\'3f d\u7909\'3fng c\'e1
c ngu\u7891\'3fn v\u7889\'3fn v\'e0 t\'e0i s\u7843\'3fn l\'fdu \'f0\u7897\'3fng, khai th\'e1c m\u7885\'3fi ngu\u7891\'3fn v\u7889\'3fn nh\'e0n r\u7895\'3fi \'f0\u7875\'3f \'f0\'fda v\'e0o lu\'e2n chuy\u7875\'3fn.
\par 4. Th\u7921\'3fc hi\u7879\'3fn nghi\'eam ch\u7881\'3fnh ch\u7871\'3f \'f0\u7897\'3f k\u7871\'3f to\'e1n ki\u7875\'3fm tra, ki\u7875\'3fm k\'ea v\'e0 b\'e1o c\'e1o k\u7883\'3fp th\u7901\'3fi, \'f0\u7847\'3fy \'f0\u7911\'3f theo ch\u7871\'3f \'f0\u7897\'3f
 quy \'f0\u7883\'3fnh c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc.
\par 5. \'d0\u7873\'3f xu\u7845\'3ft v\u7899\'3fi c\'e1c c\'f5 quan qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd Nh\'e0 n}{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd\u7899\'3fc nh\u7919\'3fng bi\u7879\'3fn ph\'e1p t\'e3ng c
\'fd\u7901\'3fng qu\u7843\'3fn l}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fd v\'e0 s\u7917\'3f d\u7909\'3fng ti\u7871\'3ft ki\u7879\'3fm v\'e0 c\'f3 hi\u7879\'3fu qu\u7843\'3f cao c\'e1c ngu\u7891\'3fn v\u7889\'3fn v\'e0 t\'e0i s\u7843\'3fn l}{
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'fdu \'f0\u7897\'3fng.
\par \'d0i\u7873\'3fu 17. \'d0\u7889\'3fi v\u7899\'3fi \'f0\'f5n v\u7883\'3f x\'e2y}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914  l\u7855\'3fp, do c\'f4ng t\'e1c qu\u7843\'3fn l\'fd v\'e0 s\u7917\'3f d\u7909\'3fng v\u7889\'3fn kh\'f4ng h\u7907\'3fp l\'fd
, d\u7851\'3fn }{\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\u7871\'3fn kinh doanh thua l\u7895\'3f v\'e0 thi\u7871\'3fu v\u7889\'3fn ho\u7841\'3ft \'f0\u7897\'3fng th}{\f0\fs28\cgrid0\insrsid6032095\charrsid15890914 \'ec }{
\f172\fs28\cgrid0\insrsid6032095\charrsid15890914 \'f0\'f5n v\u7883\'3f ph\u7843\'3fi t\u7921\'3f trang tr\u7843\'3fi s\u7889\'3f v\u7889\'3fn thi\u7871\'3fu \'f0\'f3, b\u7857\'3fng c\'e1ch: l\u7845\'3fy qu\u7929\'3f x\'ed nghi\u7879\'3fp c\u7911\'3fa 
\'f0\'f5n v\u7883\'3f \'f0\u7875\'3f b\'f9 v\'e0o, n\u7871\'3fu ch\'fda \'f0\u7911\'3f ph\u7843\'3fi l\'e0m vi\u7879\'3fc v\u7899\'3fi ng\'e2n h\'e0ng \'f0\u7875\'3f xin vay v\'fd\u7907\'3ft \'f0\u7883\'3fnh m\u7913\'3fc v\'e0 \'f0\'f5n v\u7883\'3f ph
\u7843\'3fi ph\u7845\'3fn \'f0\u7845\'3fu \'f0\u7875\'3f c\'f3 l\u7907\'3fi nhu\u7853\'3fn v\'fd\u7907\'3ft k\u7871\'3f ho\u7841\'3fch ho\u7863\'3fc l\u7845\'3fy t\u7915\'3f qu\u7929\'3f x\'ed nghi\u7879\'3fp n\'e3m sau \'f0\u7875\'3f tr\u7843\'3f n\u7907
\'3f vay.
\par \'d0i\u7873\'3fu 18. C\'f5 quan ch\u7911\'3f qu\u7843\'3fn \'f0\'f5n v\u7883\'3f c\'f3 nhi\u7879\'3fm v\u7909\'3f:}{\f0\fs28\cgrid0\insrsid6032095 
\par }}