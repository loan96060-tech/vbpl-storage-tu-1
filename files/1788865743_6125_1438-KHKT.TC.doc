\f327\fs28\cf0\insrsid6906849\charrsid8220686 c- N\u7871\'3fu b\'ean nh\u7853\'3fn th\u7921\'3fc hi\u7879\'3fn \'f0\u7847\'3fy \'f0\u7911\'3f c\'e1c \'f0i\u7873\'3fu quy \'f0\u7883\'3fnh trong h\u7907\'3fp \'f0\u7891\'3fng, }{
\f0\fs28\cf0\insrsid6906849\charrsid8220686 c\'f4ng tr\'ecnh }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7841\'3ft ch\u7845\'3ft l\'fd\u7907\'3fng t\u7889\'3ft, \'f0\'fd\u7907\'3fc chuy\u7875\'3fn giao \'f0\'fang th\u7901\'3fi h\u7841\'3fn v\'e0
 \'f0\'fd\u7907\'3fc H\u7897\'3fi \'f0\u7891\'3fng nghi\u7879\'3fm thu x\'e1c nh\u7853\'3fn th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec hai b\'ean tho\u7843\'3f thu\u7853\'3fn n\'e2ng l\u7907\'3fi nhu\u7853\'3fn }{
\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7883\'3fnh m\u7913\'3fc l\'ean t\u7889\'3fi \'f0a b\u7857\'3fng 1,5 l\u7847\'3fn m\u7913\'3fc quy \'f0\u7883\'3fnh n\'f3i tr\'ean.
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 d- N\u7871\'3fu c\'f3 bi\u7879\'3fn ph\'e1p t\'e3ng n\'e3ng su\u7845\'3ft lao \'f0\u7897\'3fng, \'e1p d\u7909\'3fng c\'e1c gi\u7843\'3fi p}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 h\'e1p t\u7889\'3fi 
\'fdu v\'e0 c\'e1c s\'e1ng ki\u7871\'3fn, \'f0\u7873\'3f \'e1n c\u7843\'3fi ti\u7871\'3fn, h\u7907\'3fp l}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'fd ho\'e1 ho\u7863\'3fc c\'e1c bi\u7879\'3fn ph\'e1p ti\u7871\'3ft ki\u7879\'3fm l\'e0m cho chi ph\'ed
 th\u7921\'3fc t\u7871\'3f th\u7845\'3fp h}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f5n gi\'e1 th\'e0nh d\u7921\'3f to\'e1n c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh nh}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'fdng v
\u7851\'3fn b\u7843\'3fo \'f0\u7843\'3fm th\u7921\'3fc hi\u7879\'3fn \'f0\u7847\'3fy \'f0\u7911\'3f c\'e1c \'f0i\u7873\'3fu kho\u7843\'3fn \'f0}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'e3 quy }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 \'f0
\u7883\'3fnh trong h\u7907\'3fp \'f0\u7891\'3fng th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec b\'ean nh\u7853\'3fn }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\'fd\u7907\'3fc ph\'e9p coi kho\u7843\'3fn ti\u7873\'3fn ch\'eanh l\u7879\'3f
ch gi\u7919\'3fa gi\'e1 th\'e0nh d\u7921\'3f to\'e1n v\u7899\'3fi gi\'e1 th\'e0nh th\u7921\'3fc t\u7871\'3f nh\'fd l\'e0 l\u7907\'3fi nhu\u7853\'3fn v\'e0 s\u7917\'3f d\u7909\'3fng kho\u7843\'3fn ti\u7873\'3fn n\'e0y theo quy \'f0\u7883\'3fnh \u7903\'3f 
\'f0i\u7875\'3fm 7 d\'fd\u7899\'3fi \'f0\'e2y.
\par 4. Gi\'e1 c\u7843\'3f d\'f9ng \'f0\u7875\'3f l\u7853\'3fp d\u7921\'3f to\'e1n c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh.
\par }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 a- \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng lo\u7841\'3fi v\u7853\'3ft t\'fd, thi\u7871\'3ft b\u7883\'3f, nguy\'ean, nhi\'ean, v\u7853\'3ft li\u7879\'3fu v\'e0 c\'f4ng lao \'f0\u7897\'3fng c\'f3 \'f0
\u7883\'3fnh m\u7913\'3fc v\'e0 c\'f3 gi\'e1 ch\u7881\'3f \'f0\u7841\'3fo c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc, \'f0\u7891\'3fng th\u7901\'3fi b\'ean giao \'f0\u7843\'3fm b\u7843\'3fo cung \u7913\'3fng cho b\'ean nh\u7853\'3fn \'f0\'fang \'f0\u7883\'3f
nh m\u7913\'3fc v\'e0 theo gi\'e1 ch\u7881\'3f \'f0\u7841\'3fo th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec hai b\'ean d\u7921\'3f to\'e1n v\'e0 thanh to\'e1n c\'f4ng tr\'ecnh theo }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\'fang \'f0
\u7883\'3fnh m\u7913\'3fc v\'e0 gi\'e1 ch\u7881\'3f \'f0\u7841\'3fo c\u7911\'3fa Nh\'e0 n\'fd\u7899\'3fc.
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 b- \'d0\u7889\'3fi v\u7899\'3fi nh\u7919\'3fng lo\u7841\'3fi v\u7853\'3f}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 t t\'fd, thi\u7871\'3ft b\u7883\'3f, nguy\'ean, nhi\'ean, v\u7853\'3ft li\u7879\'3fu ch
\'fda c\'f3 \'f0\u7883\'3fnh m\u7913\'3fc v\'e0 b\'ean giao kh\'f4ng c\'f3 kh\u7843\'3f n\'e3ng cung \u7913\'3fng cho b\'ean nh\u7853\'3fn theo \'f0\'fang \'f0\u7883\'3fnh m\u7913\'3fc v\'e0 gi\'e1 ch\u7881\'3f \'f0\u7841\'3fo c\u7911\'3fa Nh\'e0 n\'fd
\u7899\'3fc th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec hai b\'ean }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\'fd\u7907\'3fc ph\'e9p d\u7921\'3f to\'e1n gi\'e1 th\'e0nh c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec
nh theo gi\'e1 tho\u7843\'3f thu\u7853\'3fn, }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7891\'3fng th\u7901\'3fi b\'e1o c\'e1o c\'f5 quan c\'f3}{\f0\fs28\cf0\insrsid6906849\charrsid8220686  th\u7849\'3fm quy\u7873\'3fn xin duy\u7879\'3ft gi\'e1
.
\par }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 N\u7871\'3fu qu\'e1 th\u7901\'3fi gian chu\u7849\'3fn b\u7883\'3f th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp \'f0\u7891\'3fng m\'e0 c\'f5 quan c\'f3 th\u7849\'3fm quy\u7873\'3fn kh\'f4ng ban h\'e0nh \'f0\u7883
\'3fnh m\u7913\'3fc v\'e0 gi\'e1 ch\'ednh th\u7913\'3fc \'f0\u7875\'3f th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp \'f0\u7891\'3fng th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec hai b\'ean c\'f3 quy\u7873\'3fn ti\u7871\'3fn h\'e0nh v\'e0 thanh to\'e1
n c\'f4ng tr\'ecnh c}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'e3n c\u7913\'3f v\'e0o gi\'e1 tho\u7843\'3f thu\u7853\'3fn v\'e0 m\u7913\'3fc s\u7917\'3f d\u7909\'3f}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 ng th\u7921\'3fc t\u7871\'3f.
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 c- Gi\'e1 c\u7843\'3f trong th\u7901\'3fi \'f0i\u7875\'3fm k\'fd h\u7907\'3fp \'f0\u7891\'3fng l}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'e0 c\'f5 s\u7903\'3f \'f0\u7875\'3f thanh to\'e1n n\u7871\'3f
u nh\'fd trong h\u7907\'3fp \'f0\u7891\'3fng kh\'f4ng quy \'f0\u7883\'3fnh vi\u7879\'3fc \'f0i\u7873\'3fu ch\u7881\'3fnh gi\'e1 theo th\u7901\'3fi gian.
\par 5. Kho\u7843\'3fn ti\u7873\'3fn t\u7841\'3fm \u7913\'3fng quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 1a, m\u7909\'3fc III c\u7911\'3fa Th\'f4ng t\'fd n\'e0y \'f0\'fd\u7907\'3fc x\'e1c \'f0\u7883\'3fnh theo nguy\'ean t\u7855\'3fc sau:
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 a- \'d0\u7889\'3fi }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 v\u7899\'3fi b\'ean nh\u7853\'3fn h\u7907\'3fp \'f0\u7891\'3fng ch\'fda th\u7921\'3fc hi\u7879\'3fn ch\u7871\'3f \'f0\u7897\'3f h\u7841\'3f
ch to\'e1n kinh t\u7871\'3f, b\'ean giao \'f0\'fd\u7907\'3fc ph\'e9p t\u7841\'3fm \u7913\'3fng l\u7847\'3fn \'f0\u7847\'3fu t\u7889\'3fi \'f0a l\'e0 30% gi\'e1 tr\u7883\'3f t\u7893\'3fng d\u7921\'3f to\'e1n c\'f4ng tr}{
\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh. Trong qu\'e1 tr\'ecnh th\u7921\'3fc hi\u7879\'3fn, tu\u7923\'3f theo ti\u7871\'3fn }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7897\'3f \'f0\u7841\'3ft \'f0\'fd\u7907\'3fc, hai b\'ean c\'f3 quy
\u7873\'3fn tho\u7843\'3f thu\u7853\'3fn t\u7841\'3fm \u7913\'3fng th\'eam, nh\'fdng t\u7893\'3fng s\u7889\'3f ti\u7873\'3fn t\u7841\'3fm \u7913\'3fng trong th\u7901\'3fi gian th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp \'f0\u7891\'3fng kh\'f4ng \'f0\'fd
\u7907\'3fc v\'fd\u7907\'3ft qu\'e1 80% gi\'e1 tr\u7883\'3f t\u7893\'3fng d\u7921\'3f to\'e1n c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh.
\par }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 b- C\'e1c \'f0\'f5n v\u7883\'3f nh\u7853\'3fn h\u7907\'3fp \'f0\u7891\'3fng \'f0}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'e3 th\u7921\'3fc hi\u7879\'3fn ch\u7871\'3f }{
\f319\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7897\'3f h\u7841\'3fch to\'e1n kinh t\u7871\'3f, \'f0}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'e3 }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\'fd\u7907\'3fc c\u7845\'3fp v\u7889\'3fn l\'fd
u \'f0\u7897\'3fng v\'e0 v\u7889\'3fn t\'edn d\u7909\'3fng, \'f0\'fd\u7907\'3fc s\u7917\'3f d\u7909\'3fng v\u7889\'3fn l\'fdu \'f0\u7897\'3fng v\'e0 v\u7889\'3fn t\'edn d\u7909\'3fng \'f0\u7875\'3f th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp \'f0\u7891\'3f
ng. Hai b\'ean s\u7869\'3f thanh to\'e1n khi ho\'e0n th\'e0nh t\u7915\'3fng ph\u7847\'3fn ho\u7863\'3fc to\'e0n b\u7897\'3f c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh.
\par }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 6. Kinh ph\'ed \'f0\u7875\'3f th\u7921\'3fc hi\u7879\'3fn h\u7907\'3fp \'f0\u7891\'3fng \'f0\'fd\u7907\'3fc ph\'e9p l\u7845\'3fy t\u7915\'3f c\'e1c ngu\u7891\'3fn sau:
\par a- Kinh ph\'ed s\u7921\'3f nghi\u7879\'3fp \'f0i\u7873\'3fu tra, nghi\'ean c\u7913\'3fu khoa h\u7885\'3fc, k\u7929\'3f thu\u7853\'3ft;
\par b- V\u7889\'3fn t\u7921\'3f c\'f3 c\u7911\'3fa \'f0\'f5n v\u7883\'3f c\'f5 s\u7903\'3f d\'f9ng cho m\u7909\'3fc \'f0\'edch tri\u7875\'3fn khai k\u7871\'3ft qu\u7843\'3f nghi\'ean c\u7913\'3fu v\'e0 \'e1p d\u7909\'3fng k\u7929\'3f thu\u7853\'3ft ti\u7871
\'3fn b\u7897\'3f (qu\u7929\'3f ph\'e1t tri\u7875\'3fn khoa h\u7885\'3fc-k\u7929\'3f thu\u7853\'3ft ho\u7863\'3fc qu\u7929\'3f khuy\u7871\'3fn kh\'edch ph\'e1t tri\u7875\'3fn s\u7843\'3fn xu\u7845\'3ft);
\par c- C\'e1c ngu\u7891\'3fn v\u7889\'3fn kh\'e1c m\'e0 quy \'f0\u7883\'3fnh ph\'e1p l}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'fd hi\u7879\'3fn h\'e0nh cho ph\'e9p.
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 7. Sau khi \'f0}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'e3 nghi\u7879\'3fm thu, chuy\u7875\'3fn giao, thanh quy\u7871\'3ft to\'e1n t\u7915\'3fng ph\u7847\'3fn ho\u7863\'3fc to\'e0n b\u7897\'3f c\'f4
ng tr\'ecnh v\'e0 thanh l\'fd h\u7907\'3fp }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7891\'3fng theo \'f0\'fang c\'e1c quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 5, 6,7 v\'e0 8, m\u7909\'3fc III c\u7911\'3fa Th\'f4ng t\'fd n\'e0y, c\'e1
c kho\u7843\'3fn l\u7907\'3fi nhu\u7853\'3fn quy \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 3 ( g\u7891\'3fm c v\'e0 d) n\'f3i tr\'ean \'f0\'fd\u7907\'3fc ph\'e2n ph\u7889\'3fi nh\'fd sau:
\par a- Tr\'edch n\u7897\'3fp Ng\'e2n s\'e1ch Nh\'e0 n\'fd\u7899\'3fc 20}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 %
\par }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 b- Tr\'edch b\u7893\'3f sung qu\u7929\'3f ph\'e1t tri\u7875\'3fn khoa h\u7885\'3fc - k\u7929\'3f thu\u7853\'3ft c\u7911\'3fa c\'f5 s\u7903\'3f 30%.
\par c- Tr\'edch b\u7893\'3f sung qu\u7929\'3f khen th\'fd\u7903\'3fng c\u7911\'3fa c\'f5 s\u7903\'3f 30%.
\par d- Tr\'edch b\u7893\'3f sung qu\u7929\'3f ph\'fac l\u7907\'3fi t\u7853\'3fp th\u7875\'3f c\u7911\'3fa c\'f5 s\u7903\'3f 20% vi\u7879\'3fc s\u7917\'3f d\u7909\'3fng c\'e1c qu\u7929\'3f ph\u7843\'3fi theo \'f0\'fang c\'e1c quy \'f0\u7883\'3fnh ph\'e1p l}{
\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'fd hi\u7879\'3fn h\'e0nh }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7889\'3fi v\u7899\'3fi khu v\u7921\'3fc c\'e1c }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 c\'f5 quan nghi\'ean c\u7913\'3fu v
\'e0 tri\u7875\'3fn khai.}{\f0\fs28\cf0\insrsid11602340 
\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid1516837 {\b\f0\fs28\expnd5\expndtw28\cf0\insrsid6906849\charrsid8220686 VI. GI\u7842\'3fI QUY\u7870\'3fT C\'c1C V\u7908\'3f TRANH CH\u7844\'3fP}{
\b\f0\fs28\expnd5\expndtw28\cf0\insrsid3236418  }{\b\f327\fs28\expnd5\expndtw28\cf0\insrsid6906849\charrsid8220686 V\'c0 VI PH\u7840\'3fM H\u7906\'3fP \'d0\u7890\'3fNG}{\b\f0\fs28\expnd5\expndtw28\cf0\insrsid11602340 
\par }\pard \qj \fi567\li0\ri0\sb120\sa120\sl-320\slmult0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0\pararsid15541100 {\f327\fs28\cf0\insrsid6906849\charrsid8220686 C\'e3n c\u7913\'3f \'d0i\u7873\'3fu 3 c\u7911\'3fa Quy\u7871\'3ft \'f0\u7883\'3fnh s\u7889
\'3f 175-CP, nay h\'fd\u7899\'3fng d\u7851\'3fn vi\u7879\'3fc gi\u7843\'3fi quy\u7871\'3ft c\'e1c v\u7909\'3f tranh ch\u7845\'3fp v\'e0 vi ph\u7841\'3fm h\u7907\'3fp \'f0\u7891\'3fng nh\'fd sau:
\par 1. B\'ean tham gia h\u7907\'3fp \'f0\u7891\'3fng vi ph\u7841\'3fm c\'e1c quy \'f0\u7883\'3fnh v\u7873\'3f th\u7911\'3f t\u7909\'3fc cung \u7913\'3fng v\u7853\'3ft t\'fd, thi\u7871\'3ft b\u7883\'3f, th\'f4ng tin; v\u7873\'3f th\u7921\'3fc hi\u7879\'3f
n nghi\u7879\'3fm thu, thanh l}{\f319\fs28\cf0\insrsid6906849\charrsid8220686 \'fd h\u7907\'3fp \'f0\u7891\'3fng, chuy\u7875\'3fn giao k\u7871\'3ft qu\u7843\'3f c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh v\'e0 c\'e1c th\u7911\'3f t
\u7909\'3fc thanh to\'e1n kh\'e1c c\u361\'75ng nh}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'fd t\u7921\'3f ti\u7879\'3fn s\u7917\'3fa \'f0\u7893\'3fi ho\u7863\'3fc hu\u7927\'3f b\u7887\'3f h\u7907\'3fp \'f0\u7891\'3fng ngo\'e0i c\'e1c tr\'fd\u7901
\'3fng h\u7907\'3fp \'f0}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'e3 quy }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f0\u7883\'3fnh \u7903\'3f \'f0i\u7875\'3fm 1a, 1b, v\'e0 3a, 3b, 3c, 3d, m\u7909\'3fc IV c\u7911\'3fa Th\'f4ng t\'fd n\'e0
y, nh\'fdng kh\'f4ng g\'e2y ra thi\u7879\'3ft h\u7841\'3fi v\u7853\'3ft ch\u7845\'3ft th}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ec kh\'f4ng ph\u7843\'3fi b\u7891\'3fi th}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'fd\u7901\'3fng m\'e0 ch
\u7881\'3f ph\u7843\'3fi n\u7897\'3fp v\'e0o ng\'e2n s\'e1ch Nh\'e0 n\'fd\u7899\'3fc m\u7897\'3ft kho\u7843\'3fn ti\u7873\'3fn ph\u7841\'3ft vi ph\u7841\'3fm.
\par Kho\u7843\'3fn ti\u7873\'3fn n\'e0y tr\'edch t\u7915\'3f qu\u7929\'3f khen th\'fd\u7903\'3fng ho\u7863\'3fc qu\u7929\'3f ph\'fac l\u7907\'3fi t\u7853\'3fp th\u7875\'3f c\u7911\'3fa b\'ean vi ph\u7841\'3fm v\'e0 \'f0\'fd\u7907\'3fc x\'e1c \'f0\u7883\'3f
nh nh\'fd sau:
\par a- \'d0\u7889\'3fi v\u7899\'3fi c\'e1c tr\'fd\u7901\'3fng h\u7907\'3fp vi ph\u7841\'3fm v\u7873\'3f s\u7889\'3f l\'fd\u7907\'3fng, ch\u7845\'3ft l\'fd\u7907\'3fng, th\u7875\'3f lo\u7841\'3fi v\'e0 ph\'fd\'f5ng ti\u7879\'3fn cung \u7913\'3fng v\u7853\'3f
t t\'fd, thi\u7871\'3ft b\u7883\'3f v\'e0 th\'f4ng tin nh\'fdng kh\'f4ng g\'e2y ra thi\u7879\'3ft h\u7841\'3fi v\u7853\'3ft ch\u7845\'3ft, kho\u7843\'3fn ti\u7873\'3fn n\'f3i tr\'ean b\u7857\'3fng 2% gi\'e1 tr\u7883\'3f t\u7893\'3fng d\u7921\'3f to\'e1n c
\u7911\'3fa c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh;
\par }{\f319\fs28\cf0\insrsid6906849\charrsid8220686 b- \'d0\u7889\'3fi v\u7899\'3fi c\'e1}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 c tr\'fd\u7901\'3fng h\u7907\'3fp vi ph\u7841\'3fm v\u7873\'3f th\u7901\'3fi gian cung \u7913\'3fng v\u7853\'3ft t\'fd
, thi\u7871\'3ft b\u7883\'3f v\'e0 th\'f4ng tin c\u361\'3fng nh\'fd th\u7901\'3fi gian tr\u7843\'3f l\u7901\'3fi th\'f4ng b\'e1o nh\'fdng kh\'f4ng g\'e2y ra thi\u7879\'3ft h\u7841\'3fi v\u7853\'3ft ch\u7845\'3ft, kho\u7843\'3fn ti\u7873\'3fn n\'f3i tr\'ea
n b\u7857\'3fng:
\par }{\f0\fs28\cf0\insrsid6906849\charrsid8220686 - 2% gi\'e1 tr\u7883\'3f t\u7893\'3fng d\u7921\'3f to\'e1n c\'f4ng tr\'ecnh, n\u7871\'3fu th\u7901\'3fi gian vi ph\u7841\'3fm \'edt h}{\f327\fs28\cf0\insrsid6906849\charrsid8220686 \'f5n 30 ng\'e0y;
\par }{\f0\fs28\cf0\insrsid6906849\charrsid8220686 - T\u7915\'3f }{\f327\fs28\cf0\insrsid6906849\charrsid8220686 th\'e1ng th\u7913\'3f hai tr\u7903\'3f \'f0i, m\u7895\'3fi th\'e1ng c\u7897\'3fng th\'eam 1% nh\'fdng t\u7893\'3fng s\u7889\'3f ti\u7873\'3fn ph
\u7841\'3ft kh\'f4ng qu\'e1 30% gi\'e1 tr\u7883\'3f t\u7893\'3fng d\u7921\'3f to\'e1n c\'f4ng tr}{\f0\fs28\cf0\insrsid6906849\charrsid8220686 \'ecnh.
